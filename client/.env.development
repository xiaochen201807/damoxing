# 前端环境变量配置（开发环境）

# 应用基础路径（部署到子路径时使用）
# 开发环境通常为 /，生产环境根据实际部署路径配置
# 例如部署到 /gjjrgzn/，则配置为 /gjjrgzn/
# 注意：必须以 / 开头和结尾
VITE_BASE_PATH=/gjj_gjsjjsmx/

# API 基础地址
VITE_API_BASE_URL=

# 应用名称
# 应用名称
VITE_APP_NAME=公积金 AI 大模型

# 侧边栏标题
VITE_APP_SIDEBAR_TITLE=业务风险分析

# 应用版本
VITE_APP_VERSION=1.0.0

# API 路由前缀（必须与后端保持一致）
VITE_API_ROUTE_PREFIX=/gjj_gjsjjsmx/api


