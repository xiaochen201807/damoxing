# 前端环境变量配置（生产环境）

# 应用基础路径（部署到子路径时使用）
# 必须以 / 开头和结尾，例如 /gjjrgzngs/
# 这里改为 ./ (相对路径) 以支持运行时动态部署
VITE_BASE_PATH=./

# API 基础地址（Docker 部署使用相对路径，Nginx 会代理到后端）
# 如果需要指定完整域名，请修改为实际域名（如 https://yourdomain.com）
VITE_API_BASE_URL=

# API 路由前缀（需与后端和 Nginx 配置保持一致）
VITE_API_ROUTE_PREFIX=/gjjrgzn/api

# 应用名称
VITE_APP_NAME=公积金 AI 大模型
# 侧边栏标题
VITE_APP_SIDEBAR_TITLE=风险页面模型

# 应用版本
VITE_APP_VERSION=1.0.0
