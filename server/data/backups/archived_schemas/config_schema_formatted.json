{
    "type": "page",
    "title": "\u7cfb\u7edf\u914d\u7f6e\u4e2d\u5fc3",
    "titleClassName": "text-center",
    "css": {
        ".cxd-Page-title": {
            "text-align": "center !important",
            "display": "block !important",
            "width": "100%"
        },
        ".cxd-Page-subTitle": {
            "text-align": "center !important",
            "display": "block !important",
            "width": "100%"
        }
    },
    "subTitle": "\u7edf\u4e00\u7ba1\u7406\u7cfb\u7edf\u83dc\u5355\u3001\u9875\u9762\u6a21\u677f\u548cAI\u5de5\u4f5c\u6d41\u914d\u7f6e",
    "body": [
        {
            "type": "tabs",
            "tabsMode": "line",
            "tabs": [
                {
                    "title": "\u83dc\u5355\u7ba1\u7406",
                    "icon": "fa fa-bars",
                    "body": [
                        {
                            "type": "crud",
                            "syncLocation": false,
                            "api": {
                                "method": "get",
                                "url": "/api/system/menu",
                                "adaptor": "return { status: payload.status, msg: payload.msg, data: { items: payload.data || [], total: (payload.data || []).length } };"
                            },
                            "headerToolbar": [
                                "bulkActions",
                                {
                                    "type": "button",
                                    "label": "\u65b0\u589e\u83dc\u5355",
                                    "icon": "fa fa-plus",
                                    "level": "primary",
                                    "actionType": "dialog",
                                    "dialog": {
                                        "title": "\u65b0\u589e\u83dc\u5355",
                                        "body": {
                                            "type": "form",
                                            "api": {
                                                "method": "post",
                                                "url": "/api/system/menu"
                                            },
                                            "body": [
                                                {
                                                    "type": "input-text",
                                                    "name": "label",
                                                    "label": "\u83dc\u5355\u540d\u79f0",
                                                    "required": true,
                                                    "placeholder": "\u5982: \u8d37\u6b3e\u98ce\u9669\u5206\u6790"
                                                },
                                                {
                                                    "type": "input-text",
                                                    "name": "subtitle",
                                                    "label": "\u83dc\u5355\u526f\u6807\u9898",
                                                    "placeholder": "\u5982: \u98ce\u9669\u667a\u80fd\u9884\u8b66\u7cfb\u7edf",
                                                    "description": "\u53ef\u9009\uff0c\u663e\u793a\u5728\u83dc\u5355\u540d\u79f0\u4e0b\u65b9"
                                                },
                                                {
                                                    "type": "input-text",
                                                    "name": "path",
                                                    "label": "\u9875\u9762\u8def\u5f84",
                                                    "placeholder": "\u5982: /dashboard/loan_risk",
                                                    "description": "\u53ef\u9009\uff0c\u4e0d\u586b\u5219\u4e0d\u53ef\u70b9\u51fb"
                                                },
                                                {
                                                    "type": "input-text",
                                                    "name": "icon",
                                                    "label": "\u56fe\u6807\u7c7b\u540d",
                                                    "placeholder": "\u5982: fa fa-line-chart",
                                                    "description": "\u53ef\u9009\uff0c\u4f7f\u7528 FontAwesome \u56fe\u6807"
                                                }
                                            ]
                                        }
                                    }
                                }
                            ],
                            "footerToolbar": [
                                "statistics",
                                "pagination"
                            ],
                            "columns": [
                                {
                                    "name": "id",
                                    "label": "ID",
                                    "width": 60
                                },
                                {
                                    "name": "label",
                                    "label": "\u83dc\u5355\u540d\u79f0"
                                },
                                {
                                    "name": "subtitle",
                                    "label": "\u526f\u6807\u9898"
                                },
                                {
                                    "name": "path",
                                    "label": "\u9875\u9762\u8def\u5f84",
                                    "copyable": true
                                },
                                {
                                    "name": "icon",
                                    "label": "\u56fe\u6807",
                                    "type": "tpl",
                                    "tpl": "<i class='${icon}'></i> ${icon}"
                                },
                                {
                                    "type": "operation",
                                    "label": "\u64cd\u4f5c",
                                    "buttons": [
                                        {
                                            "type": "button",
                                            "label": "\u7f16\u8f91",
                                            "level": "link",
                                            "actionType": "dialog",
                                            "dialog": {
                                                "title": "\u7f16\u8f91\u83dc\u5355",
                                                "body": {
                                                    "type": "form",
                                                    "api": {
                                                        "method": "put",
                                                        "url": "/api/system/menu/${id}"
                                                    },
                                                    "body": [
                                                        {
                                                            "type": "static",
                                                            "name": "id",
                                                            "label": "\u83dc\u5355ID"
                                                        },
                                                        {
                                                            "type": "input-text",
                                                            "name": "label",
                                                            "label": "\u83dc\u5355\u540d\u79f0",
                                                            "required": true
                                                        },
                                                        {
                                                            "type": "input-text",
                                                            "name": "subtitle",
                                                            "label": "\u83dc\u5355\u526f\u6807\u9898",
                                                            "placeholder": "\u5982: \u98ce\u9669\u667a\u80fd\u9884\u8b66\u7cfb\u7edf"
                                                        },
                                                        {
                                                            "type": "input-text",
                                                            "name": "path",
                                                            "label": "\u9875\u9762\u8def\u5f84",
                                                            "placeholder": "\u5982: /dashboard/loan_risk"
                                                        },
                                                        {
                                                            "type": "input-text",
                                                            "name": "icon",
                                                            "label": "\u56fe\u6807\u7c7b\u540d",
                                                            "placeholder": "\u5982: fa fa-line-chart"
                                                        }
                                                    ]
                                                }
                                            }
                                        },
                                        {
                                            "type": "button",
                                            "label": "\u5220\u9664",
                                            "level": "link",
                                            "className": "text-danger",
                                            "actionType": "ajax",
                                            "confirmText": "\u786e\u8ba4\u8981\u5220\u9664\u83dc\u5355 ${label} \u5417\uff1f\u5220\u9664\u540e\u9700\u8981\u540c\u6b65\u5220\u9664\u5bf9\u5e94\u7684\u9875\u9762\u6a21\u677f\u3002",
                                            "api": {
                                                "method": "delete",
                                                "url": "/api/system/menu/${id}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "\u9875\u9762\u6a21\u677f\u7ba1\u7406",
                    "icon": "fa fa-file-code-o",
                    "body": [
                        {
                            "type": "crud",
                            "syncLocation": false,
                            "api": {
                                "method": "get",
                                "url": "/api/system/template",
                                "adaptor": "return { status: payload.status, msg: payload.msg, data: { items: payload.data || [], total: (payload.data || []).length } };"
                            },
                            "headerToolbar": [
                                "bulkActions",
                                {
                                    "type": "button",
                                    "label": "\u65b0\u589e\u9875\u9762\u6a21\u677f",
                                    "icon": "fa fa-plus",
                                    "level": "primary",
                                    "actionType": "dialog",
                                    "dialog": {
                                        "title": "\u65b0\u589e\u9875\u9762\u6a21\u677f",
                                        "size": "lg",
                                        "body": {
                                            "type": "form",
                                            "api": {
                                                "method": "post",
                                                "url": "/api/system/template"
                                            },
                                            "body": [
                                                {
                                                    "type": "input-text",
                                                    "name": "page_key",
                                                    "label": "\u9875\u9762\u6807\u8bc6",
                                                    "required": true,
                                                    "placeholder": "\u5982: loan_risk",
                                                    "description": "\u4e0e\u83dc\u5355\u8def\u5f84\u4e2d\u7684\u6700\u540e\u4e00\u6bb5\u5bf9\u5e94\uff0c\u5982 /dashboard/loan_risk \u4e2d\u7684 loan_risk"
                                                },
                                                {
                                                    "type": "input-text",
                                                    "name": "title",
                                                    "label": "\u9875\u9762\u6807\u9898",
                                                    "required": true,
                                                    "placeholder": "\u5982: \u8d37\u6b3e\u98ce\u9669\u667a\u80fd\u5206\u6790"
                                                },
                                                {
                                                    "type": "editor",
                                                    "name": "schema_json",
                                                    "label": "AMIS Schema",
                                                    "language": "json",
                                                    "required": true,
                                                    "size": "xxl",
                                                    "value": "{\"type\":\"page\",\"title\":\"\u793a\u4f8b\u9875\u9762\",\"body\":[{\"type\":\"tpl\",\"tpl\":\"\u9875\u9762\u5185\u5bb9\"}]}",
                                                    "description": "AMIS \u9875\u9762\u914d\u7f6e\u7684 JSON \u683c\u5f0f"
                                                }
                                            ]
                                        }
                                    }
                                }
                            ],
                            "footerToolbar": [
                                "statistics",
                                "pagination"
                            ],
                            "columns": [
                                {
                                    "name": "id",
                                    "label": "ID",
                                    "width": 60
                                },
                                {
                                    "name": "page_key",
                                    "label": "\u9875\u9762\u6807\u8bc6",
                                    "searchable": true,
                                    "copyable": true
                                },
                                {
                                    "name": "title",
                                    "label": "\u9875\u9762\u6807\u9898"
                                },
                                {
                                    "name": "schema_size",
                                    "label": "Schema\u5927\u5c0f",
                                    "type": "tpl",
                                    "tpl": "${schema_size} \u5b57\u7b26"
                                },
                                {
                                    "type": "operation",
                                    "label": "\u64cd\u4f5c",
                                    "buttons": [
                                        {
                                            "type": "button",
                                            "label": "\u7f16\u8f91",
                                            "level": "link",
                                            "actionType": "dialog",
                                            "dialog": {
                                                "title": "\u7f16\u8f91\u9875\u9762\u6a21\u677f",
                                                "size": "lg",
                                                "body": {
                                                    "type": "form",
                                                    "initApi": {
                                                        "method": "get",
                                                        "url": "/api/system/template/${page_key}"
                                                    },
                                                    "api": {
                                                        "method": "put",
                                                        "url": "/api/system/template/${page_key}"
                                                    },
                                                    "body": [
                                                        {
                                                            "type": "static",
                                                            "name": "page_key",
                                                            "label": "\u9875\u9762\u6807\u8bc6"
                                                        },
                                                        {
                                                            "type": "input-text",
                                                            "name": "title",
                                                            "label": "\u9875\u9762\u6807\u9898",
                                                            "required": true
                                                        },
                                                        {
                                                            "type": "editor",
                                                            "name": "schema_json",
                                                            "label": "AMIS Schema",
                                                            "language": "json",
                                                            "required": true,
                                                            "size": "xxl"
                                                        }
                                                    ]
                                                }
                                            }
                                        },
                                        {
                                            "type": "button",
                                            "label": "\u56de\u9000",
                                            "level": "link",
                                            "icon": "fa fa-undo",
                                            "actionType": "dialog",
                                            "dialog": {
                                                "title": "\u6062\u590d\u5386\u53f2\u7248\u672c - ${page_key}",
                                                "size": "lg",
                                                "body": {
                                                    "type": "service",
                                                    "api": {
                                                        "method": "get",
                                                        "url": "/api/system/template/${page_key}/backups"
                                                    },
                                                    "body": {
                                                        "type": "table",
                                                        "columns": [
                                                            {
                                                                "name": "version",
                                                                "label": "\u7248\u672c\u53f7"
                                                            },
                                                            {
                                                                "name": "title",
                                                                "label": "\u6807\u9898"
                                                            },
                                                            {
                                                                "name": "backup_time",
                                                                "label": "\u5907\u4efd\u65f6\u95f4",
                                                                "type": "datetime"
                                                            },
                                                            {
                                                                "type": "operation",
                                                                "label": "\u64cd\u4f5c",
                                                                "buttons": [
                                                                    {
                                                                        "type": "button",
                                                                        "label": "\u6062\u590d\u6b64\u7248\u672c",
                                                                        "level": "success",
                                                                        "actionType": "ajax",
                                                                        "confirmText": "\u786e\u8ba4\u8981\u6062\u590d\u5230\u7248\u672c ${version} \u5417\uff1f\u5f53\u524d\u7248\u672c\u5c06\u88ab\u5f52\u6863\u4e3a\u5907\u4efd\u3002",
                                                                        "api": {
                                                                            "method": "post",
                                                                            "url": "/api/system/template/${page_key}/restore",
                                                                            "data": {
                                                                                "version": "${version}"
                                                                            }
                                                                        },
                                                                        "reload": "window",
                                                                        "close": true
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                }
                                            },
                                            "disabledOn": "${backup_count == 0}"
                                        },
                                        {
                                            "type": "button",
                                            "label": "\u5220\u9664",
                                            "level": "link",
                                            "className": "text-danger",
                                            "actionType": "ajax",
                                            "confirmText": "\u786e\u8ba4\u8981\u5220\u9664\u9875\u9762\u6a21\u677f ${page_key} \u5417\uff1f",
                                            "api": {
                                                "method": "delete",
                                                "url": "/api/system/template/${page_key}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "AI \u5de5\u4f5c\u6d41\u914d\u7f6e",
