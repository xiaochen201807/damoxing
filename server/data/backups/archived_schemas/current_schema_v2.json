{
  "type": "page",
  "title": "系统配置中心",
  "titleClassName": "text-center",
  "css": {
    ".cxd-Page-title": {
      "text-align": "center !important",
      "display": "block !important",
      "width": "100%"
    },
    ".cxd-Page-subTitle": {
      "text-align": "center !important",
      "display": "block !important",
      "width": "100%"
    }
  },
  "subTitle": "统一管理系统菜单、页面模板和AI工作流配置",
  "body": [
    {
      "type": "tabs",
      "tabsMode": "line",
      "tabs": [
        {
          "title": "菜单管理",
          "icon": "fa fa-bars",
          "body": [
            {
              "type": "crud",
              "syncLocation": false,
              "api": {
                "method": "get",
                "url": "/api/system/menu",
                "adaptor": "return { status: payload.status, msg: payload.msg, data: { items: payload.data || [], total: (payload.data || []).length } };"
              },
              "headerToolbar": [
                "bulkActions",
                {
                  "type": "button",
                  "label": "新增菜单",
                  "icon": "fa fa-plus",
                  "level": "primary",
                  "actionType": "dialog",
                  "dialog": {
                    "title": "新增菜单",
                    "body": {
                      "type": "form",
                      "api": {
                        "method": "post",
                        "url": "/api/system/menu"
                      },
                      "body": [
                        {
                          "type": "input-text",
                          "name": "label",
                          "label": "菜单名称",
                          "required": true,
                          "placeholder": "如: 贷款风险分析"
                        },
                        {
                          "type": "input-text",
                          "name": "subtitle",
                          "label": "菜单副标题",
                          "placeholder": "如: 风险智能预警系统",
                          "description": "可选，显示在菜单名称下方"
                        },
                        {
                          "type": "input-text",
                          "name": "page_key",
                          "label": "页面标识",
                          "required": true,
                          "placeholder": "如: loan_risk",
                          "description": "只能包含字母、数字、下划线和连字符，将自动生成路径 /dashboard/{page_key}"
                        },
                        {
                          "type": "input-text",
                          "name": "icon",
                          "label": "图标类名",
                          "placeholder": "如: fa fa-line-chart",
                          "description": "可选，使用 FontAwesome 图标"
                        }
                      ]
                    }
                  }
                }
              ],
              "footerToolbar": [
                "statistics",
                "pagination"
              ],
              "columns": [
                {
                  "name": "id",
                  "label": "ID",
                  "width": 60
                },
                {
                  "name": "label",
                  "label": "菜单名称"
                },
                {
                  "name": "subtitle",
                  "label": "副标题"
                },
                {
                  "name": "page_key",
                  "label": "页面标识",
                  "copyable": true
                },
                {
                  "name": "path",
                  "label": "页面路径",
                  "copyable": true
                },
                {
                  "name": "icon",
                  "label": "图标",
                  "type": "tpl",
                  "tpl": "<i class='${icon}'></i> ${icon}"
                },
                {
                  "type": "operation",
                  "label": "操作",
                  "buttons": [
                    {
                      "type": "button",
                      "label": "编辑",
                      "level": "link",
                      "actionType": "dialog",
                      "dialog": {
                        "title": "编辑菜单",
                        "body": {
                          "type": "form",
                          "api": {
                            "method": "put",
                            "url": "/api/system/menu/${page_key}"
                          },
                          "body": [
                            {
                              "type": "static",
                              "name": "id",
                              "label": "菜单ID"
                            },
                            {
                              "type": "input-text",
                              "name": "label",
                              "label": "菜单名称",
                              "required": true
                            },
                            {
                              "type": "input-text",
                              "name": "subtitle",
                              "label": "菜单副标题",
                              "placeholder": "如: 风险智能预警系统"
                            },
                            {
                              "type": "input-text",
                              "name": "page_key",
                              "label": "页面标识",
                              "required": true,
                              "placeholder": "如: loan_risk",
                              "description": "只能包含字母、数字、下划线和连字符"
                            },
                            {
                              "type": "input-text",
                              "name": "icon",
                              "label": "图标类名",
                              "placeholder": "如: fa fa-line-chart"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "删除",
                      "level": "link",
                      "className": "text-danger",
                      "actionType": "ajax",
                      "confirmText": "确认要删除菜单 ${label} 吗？删除后需要同步删除对应的页面模板。",
                      "api": {
                        "method": "post",
                        "url": "/api/system/menu/delete"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "页面模板管理",
          "icon": "fa fa-file-code-o",
          "body": [
            {
              "type": "crud",
              "syncLocation": false,
              "api": {
                "method": "get",
                "url": "/api/system/template",
                "adaptor": "return { status: payload.status, msg: payload.msg, data: { items: payload.data || [], total: (payload.data || []).length } };"
              },
              "headerToolbar": [
                "bulkActions",
                {
                  "type": "button",
                  "label": "新增页面模板",
                  "icon": "fa fa-plus",
                  "level": "primary",
                  "actionType": "dialog",
                  "dialog": {
                    "title": "新增页面模板",
                    "size": "lg",
                    "body": {
                      "type": "form",
                      "api": {
                        "method": "post",
                        "url": "/api/system/template"
                      },
                      "body": [
                        {
                          "type": "select",
                          "name": "menu_id",
                          "label": "关联菜单",
                          "required": true,
                          "source": {
                            "method": "get",
                            "url": "/api/system/menu",
                            "adaptor": "return { options: (payload.data || []).map(item => ({ label: item.label + (item.subtitle ? ' - ' + item.subtitle : ''), value: item.id, page_key: item.page_key, menuLabel: item.label })) };"
                          },
                          "description": "必须选择关联菜单，选择后将自动填充页面标识和标题",
                          "autoFill": {
                            "page_key": "${page_key}",
                            "title": "${menuLabel}"
                          }
                        },
                        {
                          "type": "input-text",
                          "name": "page_key",
                          "label": "页面标识",
                          "required": true,
                          "placeholder": "如: loan_risk",
                          "description": "从菜单自动填充，可手动调整"
                        },
                        {
                          "type": "input-text",
                          "name": "title",
                          "label": "页面标题",
                          "required": true,
                          "placeholder": "如: 贷款风险智能分析",
                          "description": "从菜单自动填充，可手动调整"
                        },
                        {
                          "type": "json-editor",
                          "name": "schema_json",
                          "label": "AMIS Schema",
                          "language": "json",
                          "required": true,
                          "size": "xxl",
                          "value": "{\"type\":\"page\",\"title\":\"示例页面\",\"body\":[{\"type\":\"tpl\",\"tpl\":\"页面内容\"}]}",
                          "description": "AMIS 页面配置的 JSON 格式"
                        }
                      ]
                    }
                  }
                }
              ],
              "footerToolbar": [
                "statistics",
                "pagination"
              ],
              "columns": [
                {
                  "name": "id",
                  "label": "ID",
                  "width": 60
                },
                {
                  "name": "page_key",
                  "label": "页面标识",
                  "searchable": true,
                  "copyable": true
                },
                {
                  "name": "title",
                  "label": "页面标题"
                },
                {
                  "name": "schema_size",
                  "label": "Schema大小",
                  "type": "tpl",
                  "tpl": "${schema_size} 字符"
                },
                {
                  "type": "operation",
                  "label": "操作",
                  "buttons": [
                    {
                      "type": "button",
                      "label": "编辑",
                      "level": "link",
                      "actionType": "dialog",
                      "dialog": {
                        "title": "编辑页面模板",
                        "size": "lg",
                        "body": {
                          "type": "form",
                          "initApi": {
                            "method": "get",
                            "url": "/api/system/template/${page_key}",
                            "adaptor": "const result = payload.data; const menuResponse = await fetch('/api/system/menu'); const menuData = await menuResponse.json(); const currentMenu = (menuData.data || []).find(m => m.page_key === result.page_key); if (currentMenu) { result.menu_display = currentMenu.label + (currentMenu.subtitle ? ' - ' + currentMenu.subtitle : ''); } else { result.menu_display = '(未关联菜单)'; } return { status: 0, data: result };"
                          },
                          "api": {
                            "method": "put",
                            "url": "/api/system/template/${page_key}"
                          },
                          "body": [
                            {
                              "type": "alert",
                              "level": "info",
                              "body": "💡 仅支持修改页面标题和 Schema，页面标识不可修改",
                              "showCloseButton": true
                            },
                            {
                              "type": "static",
                              "name": "menu_display",
                              "label": "关联菜单"
                            },
                            {
                              "type": "static",
                              "name": "page_key",
                              "label": "页面标识"
                            },
                            {
                              "type": "input-text",
                              "name": "title",
                              "label": "页面标题",
                              "required": true
                            },
                            {
                              "type": "editor",
                              "name": "schema_json",
                              "label": "AMIS Schema",
                              "language": "json",
                              "required": true,
                              "size": "xxl"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "删除",
                      "level": "link",
                      "className": "text-danger",
                      "actionType": "ajax",
                      "confirmText": "确认要删除页面模板 ${page_key} 吗？此操作为软删除，可通过备份恢复。",
                      "api": {
                        "method": "post",
                        "url": "/api/system/template/delete"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "AI 工作流配置",
          "icon": "fa fa-cogs",
          "body": [
            {
              "type": "crud",
              "primaryField": "page_key",
              "syncLocation": false,
              "api": {
                "method": "get",
                "url": "/api/dify/config",
                "adaptor": "return { status: payload.status !== undefined ? payload.status : 0, msg: payload.msg || 'success', data: { items: payload.data || [], total: (payload.data || []).length } };"
              },
              "headerToolbar": [
                "bulkActions",
                {
                  "type": "button",
                  "label": "新增配置",
                  "icon": "fa fa-plus",
                  "level": "primary",
                  "actionType": "dialog",
                  "dialog": {
                    "title": "新增 Dify 配置",
                    "size": "lg",
                    "body": {
                      "type": "form",
                      "api": {
                        "method": "post",
                        "url": "/api/dify/config"
                      },
                      "body": [
                        {
                          "type": "select",
                          "name": "template_id",
                          "label": "关联页面模板",
                          "source": {
                            "method": "get",
                            "url": "/api/system/template",
                            "adaptor": "return { options: (payload.data || []).map(item => ({ label: item.title + ' (' + item.page_key + ')', value: item.page_key, page_key: item.page_key, workflow_name: item.title + '工作流' })) };"
                          },
                          "description": "选择页面后将自动填充页面标识和工作流名称",
                          "clearable": true,
                          "autoFill": {
                            "page_key": "${page_key}",
                            "workflow_name": "${workflow_name}"
                          }
                        },
                        {
                          "type": "input-text",
                          "name": "page_key",
                          "label": "页面标识",
                          "required": true,
                          "placeholder": "如: loan_risk",
                          "description": "从页面模板选择自动填充，也可手动输入"
                        },
                        {
                          "type": "input-text",
                          "name": "workflow_name",
                          "label": "工作流名称",
                          "required": true,
                          "placeholder": "如: 贷款风险分析工作流",
                          "description": "从页面模板选择自动填充，也可手动输入"
                        },
                        {
                          "type": "input-text",
                          "name": "api_url",
                          "label": "API 地址",
                          "required": true,
                          "value": "https://api.dify.ai/v1",
                          "description": "Dify API 的基础地址"
                        },
                        {
                          "type": "input-password",
                          "name": "api_key",
                          "label": "API Key",
                          "required": true,
                          "placeholder": "输入 Dify API Key",
                          "description": "请妥善保管您的 API Key"
                        },
                        {
                          "type": "switch",
                          "name": "enabled",
                          "label": "启用状态",
                          "value": 1,
                          "trueValue": 1,
                          "falseValue": 0
                        },
                        {
                          "type": "textarea",
                          "name": "description",
                          "label": "描述",
                          "placeholder": "可选，配置说明"
                        }
                      ]
                    }
                  }
                }
              ],
              "footerToolbar": [
                "statistics",
                "pagination"
              ],
              "columns": [
                {
                  "name": "page_key",
                  "label": "页面标识",
                  "searchable": true
                },
                {
                  "name": "workflow_name",
                  "label": "工作流名称"
                },
                {
                  "name": "api_url",
                  "label": "API 地址",
                  "type": "text",
                  "copyable": true
                },
                {
                  "name": "api_key",
                  "label": "API Key",
                  "type": "text",
                  "toggled": false,
                  "copyable": {
                    "content": "${api_key}"
                  }
                },
                {
                  "name": "enabled",
                  "label": "状态",
                  "type": "status",
                  "map": {
                    "0": "已禁用",
                    "1": "已启用"
                  },
                  "labelMap": {
                    "0": "danger",
                    "1": "success"
                  }
                },
                {
                  "name": "description",
                  "label": "描述",
                  "toggled": false
                },
                {
                  "name": "created_at",
                  "label": "创建时间",
                  "type": "datetime",
                  "format": "YYYY-MM-DD HH:mm:ss"
                },
                {
                  "type": "operation",
                  "label": "操作",
                  "buttons": [
                    {
                      "type": "button",
                      "label": "编辑",
                      "level": "link",
                      "actionType": "dialog",
                      "dialog": {
                        "title": "编辑配置",
                        "size": "lg",
                        "body": {
                          "type": "form",
                          "api": {
                            "method": "put",
                            "url": "/api/dify/config/${page_key}"
                          },
                          "body": [
                            {
                              "type": "static",
                              "name": "page_key",
                              "label": "页面标识"
                            },
                            {
                              "type": "input-text",
                              "name": "workflow_name",
                              "label": "工作流名称",
                              "required": true
                            },
                            {
                              "type": "input-text",
                              "name": "api_url",
                              "label": "API 地址",
                              "required": true
                            },
                            {
                              "type": "input-password",
                              "name": "api_key",
                              "label": "API Key",
                              "required": true,
                              "description": "留空则不修改"
                            },
                            {
                              "type": "switch",
                              "name": "enabled",
                              "label": "启用状态",
                              "trueValue": 1,
                              "falseValue": 0
                            },
                            {
                              "type": "textarea",
                              "name": "description",
                              "label": "描述"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "button",
                      "label": "删除",
                      "level": "link",
                      "className": "text-danger",
                      "actionType": "ajax",
                      "confirmText": "确认要删除配置 ${page_key} 吗？",
                      "api": {
                        "method": "post",
                        "url": "/api/dify/config/delete"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "后端设置",
          "icon": "fa fa-server",
          "body": [
            {
              "type": "alert",
              "level": "warning",
              "body": "⚠️ 修改后端配置后需要 **重启服务器** 才能生效！"
            },
            {
              "type": "crud",
              "syncLocation": false,
              "api": {
                "method": "get",
                "url": "/api/system/backend-config",
                "adaptor": "return { status: payload.status, msg: payload.msg, data: { items: payload.data || [], total: (payload.data || []).length } };"
              },
              "headerToolbar": [],
              "footerToolbar": [
                "statistics"
              ],
              "columns": [
                {
                  "name": "config_key",
                  "label": "配置项",
                  "type": "tpl",
                  "tpl": "<code>${config_key}</code>"
                },
                {
                  "name": "config_value",
                  "label": "当前值",
                  "type": "tpl",
                  "tpl": "<strong>${config_value}</strong>"
                },
                {
                  "name": "description",
                  "label": "说明"
                },
                {
                  "name": "updated_at",
                  "label": "更新时间",
                  "type": "datetime",
                  "format": "YYYY-MM-DD HH:mm:ss"
                },
                {
                  "type": "operation",
                  "label": "操作",
                  "buttons": [
                    {
                      "type": "button",
                      "label": "修改",
                      "level": "link",
                      "actionType": "dialog",
                      "dialog": {
                        "title": "修改配置",
                        "body": {
                          "type": "form",
                          "api": {
                            "method": "put",
                            "url": "/api/system/backend-config/${config_key}"
                          },
                          "body": [
                            {
                              "type": "static",
                              "name": "config_key",
                              "label": "配置项"
                            },
                            {
                              "type": "static",
                              "name": "description",
                              "label": "说明"
                            },
                            {
                              "type": "input-number",
                              "name": "config_value",
                              "label": "配置值",
                              "required": true,
                              "min": 1,
                              "description": "窗口时间范围: 1000-3600000ms, 最大请求数: 1-10000"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "divider"
            },
            {
              "type": "alert",
              "level": "info",
              "body": "💡 **提示**: 当前配置说明<br/>• global_rate_limit_window: 全局限流时间窗口(毫秒)<br/>• global_rate_limit_max: 全局最大请求数<br/>• ai_rate_limit_window: AI接口限流窗口(毫秒)<br/>• ai_rate_limit_max: AI接口最大请求数"
            }
          ]
        },
        {
          "title": "可视化配置",
          "icon": "fa fa-magic",
          "body": [
            {
              "type": "page",
              "initApi": {
                "method": "get",
                "url": "/api/schema/templates",
                "adaptor": "return { ...payload, items: payload.data }"
              },
              "body": [
                {
                  "type": "wizard",
                  "mode": "horizontal",
                  "steps": [
                    {
                      "title": "选择模板",
                      "body": [
                        {
                          "type": "alert",
                          "level": "info",
                          "body": "🔍 template_id = `${template_id || '空'}`",
                          "className": "m-b"
                        },
                        {
                          "type": "select",
                          "name": "template_id",
                          "label": "选择页面模板",
                          "source": "${items}",
                          "required": true,
                          "labelField": "template_name",
                          "valueField": "template_id",
                          "searchable": true,
                          "menuTpl": "<div><strong>${template_name}</strong><br/><small class='text-muted'>${description} (${theme_id})</small></div>"
                        },
                        {
                          "type": "divider"
                        },
                        {
                          "type": "select",
                          "name": "target_page_key",
                          "label": "绑定已有页面 (可选)",
                          "source": {
                            "method": "get",
                            "url": "/api/system/template",
                            "adaptor": "return { status: 0, msg: '', options: payload.data.map(item => ({ label: item.title + ' (' + item.page_key + ')', value: item.page_key })) }"
                          },
                          "description": "如果不选择，则创建新页面。如果选择，将**覆盖**该页面的配置。",
                          "searchable": true,
                          "clearable": true
                        },
                        {
                          "type": "select",
                          "name": "app_theme",
                          "label": "页面主题风格",
                          "options": [
                            {
                              "label": "🔵 默认主题 (商务蓝)",
                              "value": "default"
                            },
                            {
                              "label": "🌑 深色科技 (Dark Mode)",
                              "value": "dark"
                            },
                            {
                              "label": "🟠 品牌定制 (活力橙)",
                              "value": "brand"
                            }
                          ],
                          "value": "default",
                          "required": true,
                          "description": "选择页面的整体配色风格，支持一键切换"
                        },
                        {
                          "type": "input-text",
                          "name": "manual_page_key",
                          "label": "新页面标识 (Page Key)",
                          "required": true,
                          "visibleOn": "${!target_page_key}",
                          "validations": {
                            "isAlpha": true,
                            "maxLength": 50
                          },
                          "placeholder": "例如: detection_dashboard",
                          "description": "只能包含字母、数字和下划线"
                        },
                        {
                          "type": "input-text",
                          "name": "page_title",
                          "label": "页面标题",
                          "required": true,
                          "placeholder": "例如: 风险监测看板"
                        }
                      ]
                    },
                    {
                      "title": "配置参数",
                      "initApi": {
                        "method": "get",
                        "url": "/api/schema/template-form/${template_id}",
                        "adaptor": "\n                // 关键：将data.formFields提取出来，直接返回到数据域\n                console.log('API返回:', payload);\n                return {\n                    ...payload.data,  // 展开data，使formFields在顶层\n                    __debug: 'adaptor executed'\n                };\n            "
                      },
                      "body": [
                        {
                          "type": "service",
                          "schemaApi": {
                            "method": "get",
                            "url": "/api/schema/template-form/${template_id}",
                            "adaptor": "\n                        // 健壮性检查\n                        if (!payload || !payload.data) {\n                            return {\n                                type: 'alert',\n                                level: 'warning',\n                                body: '⚠️ 无法获取表单配置: ' + (payload?.msg || '未知错误'),\n                                showCloseButton: true\n                            };\n                        }\n                        \n                        console.log('API返回:', payload);\n                        \n                        return {\n                            type: 'container',\n                            body: payload.data.formFields || [\n                                {\n                                    type: 'alert',\n                                    level: 'info',\n                                    body: '此模板没有配置参数'\n                                }\n                            ]\n                        };\n                    "
                          }
                        }
                      ]
                    },
                    {
                      "title": "确认保存",
                      "body": [
                        {
                          "type": "alert",
                          "level": "info",
                          "body": "## 确认配置\n\n- **模板ID**: ${template_id}\n- **主题风格**: ${app_theme}\n- **操作模式**: ${target_page_key ? '更新页面' : '创建新页面'}\n- **页面标识**: ${target_page_key || manual_page_key}\n- **页面标题**: ${page_title}"
                        }
                      ]
                    }
                  ],
                  "api": {
                    "method": "post",
                    "url": "/api/schema/save",
                    "data": {
                      "template_id": "${template_id}",
                      "target_page_key": "${target_page_key}",
                      "manual_page_key": "${manual_page_key}",
                      "page_title": "${page_title}",
                      "app_theme": "${app_theme}",
                      "params": "$$"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
