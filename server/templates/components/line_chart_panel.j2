{#
  折线图组件
  @param line_api_url 折线图数据API地址
  @param line_method 折线图API请求方法
  @param line_height 折线图高度
  @param line_smooth 是否平滑曲线
  @param line_show_area 是否显示区域填充
  @param line_clickable 是否可点击查看详情
  @param line_detail_api 详情数据API地址
#}
{# Line Chart Panel Component - Time Series and Trend Analysis #}
{
    "type": "chart",
    "api": {
        "url": "{{ line_api_url }}",
        "method": "{{ line_method | default('get') }}",
        "adaptor": "const option = payload.data || {}; if (option.series) { option.series.forEach(s => { s.smooth = {{ line_smooth | default('true') }}; {% if line_show_area %}s.areaStyle = { opacity: 0.3 };{% endif %} s.emphasis = { focus: 'series' }; }); } option.grid = { left: '3%', right: '4%', bottom: '10%', containLabel: true }; option.tooltip = { trigger: 'axis', axisPointer: { type: 'cross' } }; option.legend = { bottom: '0', left: 'center' }; return { ...payload, data: option };"
    },
    "height": {{ line_height | default(400) }},
    {% if line_clickable | default(true) %}
    "clickAction": {
        "actionType": "dialog",
        "dialog": {
            "title": "${event.seriesName} - ${event.name}",
            "size": "xl",
            "actions": [
                {
                    "type": "button",
                    "label": "导出数据",
                    "level": "primary",
                    "actionType": "download",
                    "api": {
                        "method": "get",
                        "url": "/api/export/line-data?series=${event.seriesName}&date=${event.name}"
                    }
                },
                {
                    "type": "button",
                    "label": "关闭",
                    "actionType": "close"
                }
            ],
            "data": {
                "selectedSeries": "${event.seriesName}",
                "selectedDate": "${event.name}",
                "selectedValue": "${event.value}"
            },
            "body": {
                "type": "service",
                "api": {
                    "method": "get",
                    "url": "{{ line_detail_api | default('/api/demo/line-detail') }}",
                    "requestAdaptor": "const series = api.data.selectedSeries || ''; const date = api.data.selectedDate || ''; return { ...api, url: api.url + '?series=' + encodeURIComponent(series) + '&date=' + encodeURIComponent(date) };"
                },
                "body": {
                    "type": "table",
                    "affixHeader": true,
                    "columnsTogglable": true,
                    "footable": true,
                    "columns": [
                        {
                            "name": "id",
                            "label": "ID",
                            "width": 60
                        },
                        {
                            "name": "date",
                            "label": "日期",
                            "type": "date",
                            "format": "YYYY-MM-DD"
                        },
                        {
                            "name": "category",
                            "label": "类别"
                        },
                        {
                            "name": "value",
                            "label": "数值",
                            "type": "number"
                        },
                        {
                            "name": "change",
                            "label": "环比变化",
                            "type": "tpl",
                            "tpl": "<span class='label label-${change >= 0 ? \"success\" : \"danger\"}'>${change >= 0 ? '+' : ''}${change}%</span>"
                        },
                        {
                            "name": "trend",
                            "label": "趋势",
                            "type": "mapping",
                            "map": {
                                "up": "<i class='fa fa-arrow-up text-success'></i> 上升",
                                "down": "<i class='fa fa-arrow-down text-danger'></i> 下降",
                                "stable": "<i class='fa fa-minus text-info'></i> 平稳"
                            }
                        }
                    ]
                }
            }
        }
    }
    {% endif %}
}
