{# Page Header Component - Title and Dynamic Subtitle #}
{# 
  组件参数说明:
  @param title 页面标题
  @param title_font_size 标题字体大小
  @param subtitle_api 副标题数据API地址（配置后，副标题将动态显示API返回的数据;不配置则使用静态副标题或不使用副标题）
  @param subtitle_api_method 副标题API请求方法
  @param subtitle_api_data 副标题API的固定请求参数（JSON对象或字符串）
  @param subtitle_api_adaptor 副标题API数据适配器（副标题API返回的数据不满足 amis 格式时可设置）
  @param subtitle 页面副标题(副标题静态文字)  
  @param subtitle_font_size 副标题字体大小
  @param subtitle_color 副标题颜色  
  @param enable_report_button 是否显示报告生成按钮
  @param report_button_label 报告按钮文字
  @param page_key 页面唯一标识（用于报告生成）
  @param report_workflow_type 报告工作流类型（默认：report_generation）
  @param report_query AI报告生成查询参数
  @param report_api_data 报告生成API的固定请求参数（JSON对象或字符串）
#}
{% import 'base/colors.j2' as theme %}

{
    "type": "container",
    "className": "page-header-component",
    "style": {
        "backgroundColor": "{{ theme.colors.background }}",
        "padding": "20px 20px", {# 增加左右内边距，防止文字太长贴边 #}
        "marginBottom": "20px",
        "position": "relative"  {# 关键点 1：父容器设置为相对定位，作为锚点 #}
    },
    
    {# --- 定义按钮组件 JSON 片段 (避免重复写两遍) --- #}
    {% set report_button_json %}
    {
        "type": "button",
        "label": "{{ report_button_label | default('生成风险分析报告') }}",
        "level": "danger",
        "style": {
            "position": "absolute",        {# 关键点 2：绝对定位 #}
            "right": "20px",               {# 靠右 20px #}
            "top": "50%",                  {# 垂直居中 #}
            "transform": "translateY(-50%)", {# 修正垂直居中偏移 #}
            "zIndex": "10"
        },
        "onEvent": {
            "click": {
                "actions": [
                    {# 设置全局变量：开启 loading 和显示报告区域 #}
                    {# sendOn 条件会自动触发 service 请求，无需 reload action #}
                    {
                        "actionType": "setValue",
                        "componentId": "global_page_root",
                        "args": {
                            "value": {
                                "show_report_result": true,
                                "report_loading": true
                            }
                        }
                    }
                ]
            }
        }
    }
    {% endset %}

    "body": [
        {% set comma = joiner(",") %}

        {# --- 场景 A：动态副标题 (需要 Service) --- #}
        {% if subtitle_api %}
        {{ comma() }}
        {
            "type": "service",
            "style": {
                "width": "100%" {# 确保 Service 占满宽度 #}
            },
            "api": {
                "method": "{{ subtitle_api_method | default('get') }}",
                "url": "{{ subtitle_api }}"
                {% if subtitle_api_data %},
                "data": {{ subtitle_api_data | tojson }}
                {% endif %}
                {% if subtitle_api_adaptor %},
                "adaptor": "{{ subtitle_api_adaptor }}"
                {% endif %}
            },
            "body": [
                {% set inner_comma = joiner(",") %}
                {{ inner_comma() }}
                {
                    "type": "container",
                    "className": "text-center",
                    "style": {
                        "position": "static" {# 防止内部容器干扰定位上下文 #}
                    },
                    "body": [
                        {
                            "type": "tpl",
                            "tpl": "<h2 style='font-size: {{ title_font_size | default('22px') }}; font-weight: 600; color: {{ theme.colors.text_primary }}; margin: 5px 0;'>{{ title }}</h2>"
                        },
                        {
                            "type": "tpl",
                            "tpl": "<div style='color: {{ subtitle_color | default(theme.colors.text_secondary) }}; font-size: {{ subtitle_font_size | default('13px') }};'>{{ subtitle_tpl | default('${displayText}') }}</div>"
                        }
                    ]
                }
                {% if enable_report_button %}
                {{ inner_comma() }}
                {{ report_button_json | safe }}
                {% endif %}
            ]
        }
        
        {# --- 场景 B：静态副标题 (直接渲染) --- #}
        {% else %}
        {{ comma() }}
        {
            "type": "container",
            "className": "text-center",
            "style": {
                "width": "100%"
            },
            "body": [
                {
                    "type": "tpl",
                    "tpl": "<h2 style='font-size: {{ title_font_size | default('22px') }}; font-weight: 600; color: {{ theme.colors.text_primary }}; margin: 5px 0;'>{{ title }}</h2>"
                },
                {
                    "type": "tpl",
                    "tpl": "<div style='color: {{ subtitle_color | default(theme.colors.text_secondary) }}; font-size: {{ subtitle_font_size | default('13px') }};'>{{ subtitle | default('') }}</div>"
                }
            ]
        }
        {% if enable_report_button %}
        {{ comma() }}
        {{ report_button_json | safe }}
        {% endif %}
        
        {% endif %}
    ]
}

{# =====================================================
   Report Display Component (融合到 Header 组件中)
   当 enable_report_button 为 true 时，自动包含报告显示功能
   ===================================================== #}
{% if enable_report_button %}
,{
    "type": "service",
    "id": "report_display_root",
    "className": "p-none",
    "body": [
        {# 添加内部样式修复滚动问题 #}
        {
            "type": "tpl",
            "tpl": "<style>.report-content-area { display: flex; flex-direction: column; } .report-content-area > .cxd-Service { flex: 1 1 0; min-height: 0; overflow-y: auto !important; } .report-content-area .cxd-Service-body { height: 100%; overflow-y: auto; }</style>"
        },
        {# Loading 动画 - 带倒计时 #}
        {
            "type": "container",
            "visibleOn": "${report_loading}",
            "style": {
                "position": "fixed",
                "top": "0",
                "left": "0",
                "width": "100vw",
                "height": "100vh",
                "backgroundColor": "rgba(255, 255, 255, 0.9)",
                "zIndex": "10000",
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "center",
                "backdropFilter": "blur(8px)"
            },
            "body": [{
                "type": "custom",
                "name": "report-timer",
                "html": "<div style='font-family: -apple-system, BlinkMacSystemFont, Helvetica Neue, Arial; color: #333;'><div style='position: relative; width: 80px; height: 80px; margin: 0 auto 24px auto;'><svg viewBox='0 0 50 50' style='width: 100%; height: 100%; animation: spin 2s linear infinite;'><circle cx='25' cy='25' r='20' fill='none' stroke='#e6f7ff' stroke-width='4'></circle><circle cx='25' cy='25' r='20' fill='none' stroke='#1890ff' stroke-width='4' stroke-dasharray='80' stroke-dashoffset='60' stroke-linecap='round'></circle></svg><div style='position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; color: #1890ff;'><span id='report-timer-sec'>0</span><span style='font-size: 12px; margin-left: 2px; font-weight: 400;'>s</span></div></div><div style='font-size: 18px; font-weight: 600; color: #333; margin-bottom: 12px;'>正在生成报告</div><div id='report-timer-text' style='font-size: 14px; color: #666;'>正在准备数据...</div><style>@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }</style></div>",
                "onMount": "const startTime = Date.now(); const secDom = document.getElementById('report-timer-sec'); const textDom = document.getElementById('report-timer-text'); const texts = ['正在准备数据...', '正在调用AI分析...', '正在生成报告...', '即将完成...']; window.reportTimer = setInterval(() => { const elapsed = ((Date.now() - startTime) / 1000).toFixed(1); if(secDom) secDom.innerText = elapsed; const step = Math.floor(elapsed / 3) % texts.length; if(textDom) textDom.innerText = texts[step]; }, 100);",
                "onUnmount": "clearInterval(window.reportTimer);"
            }]
        },
        {# 报告显示弹窗 - 始终渲染以确保service能触发请求 #}
        {
            "type": "container",
            "visibleOn": "${show_report_result}",
            "style": {
                "position": "fixed",
                "top": "0",
                "left": "0",
                "width": "100vw",
                "height": "100vh",
                "backgroundColor": "rgba(0, 0, 0, 0.5)",
                "zIndex": "9998",
                "display": "flex",
                "alignItems": "flex-start",
                "justifyContent": "center",
                "paddingTop": "20px",
                "paddingBottom": "20px"
            },
            "body": [{
                "type": "container",
                "style": {
                    "backgroundColor": "#ffffff",
                    "borderRadius": "8px",
                    "width": "90%",
                    "maxWidth": "1200px",
                    "height": "70vh",
                    "display": "flex",
                    "flexDirection": "column",
                    "boxShadow": "0 4px 20px rgba(0,0,0,0.3)",
                    "position": "relative",
                    "overflow": "hidden"
                },
                "body": [
                    {# X 关闭按钮 - 绝对定位在右上角 #}
                    {
                        "type": "button",
                        "label": "✕",
                        "level": "link",
                        "style": {
                            "position": "absolute",
                            "top": "12px",
                            "right": "16px",
                            "color": "white",
                            "fontSize": "20px",
                            "padding": "0",
                            "width": "28px",
                            "height": "28px",
                            "minWidth": "28px",
                            "zIndex": "10",
                            "lineHeight": "28px",
                            "textAlign": "center"
                        },
                        "onEvent": {
                            "click": {
                                "actions": [{
                                    "actionType": "setValue",
                                    "componentId": "global_page_root",
                                    "args": {
                                        "value": {
                                            "show_report_result": false,
                                            "report_loading": false
                                        }
                                    }
                                }]
                            }
                        }
                    },
                    {# 标题栏 #}
                    {
                        "type": "container",
                        "style": {
                            "backgroundColor": "#1a3c6e",
                            "color": "white",
                            "padding": "14px 50px 14px 24px",
                            "borderRadius": "8px 8px 0 0",
                            "flexShrink": "0"
                        },
                        "body": [{
                            "type": "tpl",
                            "tpl": "<span style='font-size: 16px; font-weight: bold;'>📄 风险分析报告预览</span>"
                        }]
                    },
                    {# 内容区域 #}
                    {
                        "type": "service",
                        "id": "report_service_inner",
                        "className": "report-content-area",
                        "style": {
                            "flex": "1 1 0",
                            "minHeight": "0",
                            "overflowY": "auto",
                            "padding": "24px",
                            "backgroundColor": "#ffffff"
                        },
                    "schemaApi": {
                        "method": "post",
                        "url": "/api/ai/generate-page",
                        "sendOn": "${report_loading === true}",
                        "data": {
                            "pageId": "{{ page_key }}",
                            "workflow_type": "{{ report_workflow_type | default('report_generation') }}",
                            "query": "{{ report_query | default('生成 ' + page_key + ' 分析报告') }}",
                            "timestamp": "${date(now(), 'x')}"
                            {% if report_api_data %},
                            {{ report_api_data | tojson }}
                            {% endif %}
                        }
                    },
                    "onEvent": {
                        "fetchSchemaInited": {
                            "actions": [{
                                "actionType": "setValue",
                                "componentId": "global_page_root",
                                "args": {
                                    "value": {
                                        "report_loading": false
                                    }
                                }
                            }]
                        },
                        "fetchFailed": {
                            "actions": [{
                                "actionType": "setValue",
                                "componentId": "global_page_root",
                                "args": {
                                    "value": {
                                        "report_loading": false
                                    }
                                }
                            }]
                        }
                        }
                    },
                    {# 底部操作栏 #}
                    {
                        "type": "container",
                        "style": {
                            "borderTop": "1px solid #e8e8e8",
                            "padding": "12px 24px",
                            "backgroundColor": "#fafafa",
                            "display": "flex",
                            "justifyContent": "flex-end",
                            "alignItems": "center",
                            "gap": "16px",
                            "borderRadius": "0 0 8px 8px",
                            "flexShrink": "0"
                        },
                        "body": [
                            {
                                "type": "tpl",
                                "tpl": "<div style='font-size: 12px; color: #999; margin-right: auto;'>* 本报告由AI系统生成，仅供参考使用。</div>"
                            },
                            {
                                "type": "button",
                                "label": "✕ 关闭窗口",
                                "level": "default",
                                "onEvent": {
                                    "click": {
                                        "actions": [{
                                            "actionType": "setValue",
                                            "componentId": "global_page_root",
                                            "args": {
                                                "value": {
                                                    "show_report_result": false,
                                                    "report_loading": false
                                                }
                                            }
                                        }]
                                    }
                                }
                            },
                            {
                                "type": "button",
                                "label": "📥 导出 PDF",
                                "level": "primary",
                                "className": "m-l-sm",
                                "onEvent": {
                                    "click": {
                                        "actions": [{
                                            "actionType": "custom",
                                            "script": "const btn = event.context.nativeEvent.target.closest('button'); const originalText = btn.textContent; btn.disabled = true; btn.textContent = '正在生成...'; const loadScript = (src) => new Promise((resolve, reject) => { if (document.querySelector(`script[src='${src}']`)) return resolve(); const script = document.createElement('script'); script.src = src; script.onload = resolve; script.onerror = reject; document.head.appendChild(script); }); Promise.all([loadScript('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js'), loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js')]).then(() => { const { jsPDF } = window.jspdf; const reportContent = document.querySelector('.report-content-area .cxd-Service') || document.querySelector('.report-content-area'); if (!reportContent) { alert('未找到报告内容'); btn.disabled = false; btn.textContent = originalText; return; } html2canvas(reportContent, { scale: 2, useCORS: true, logging: true, backgroundColor: '#ffffff', scrollY: 0, windowWidth: reportContent.scrollWidth || 1200 }).then(canvas => { const imgData = canvas.toDataURL('image/png'); const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' }); const pdfWidth = 210; const pdfHeight = 297; const margin = 10; const imgWidth = pdfWidth - margin * 2; const imgHeight = (canvas.height * imgWidth) / canvas.width; let heightLeft = imgHeight; let position = margin; pdf.addImage(imgData, 'PNG', margin, position, imgWidth, imgHeight); heightLeft -= (pdfHeight - margin * 2); while (heightLeft > 0) { pdf.addPage(); position = margin - (imgHeight - heightLeft); pdf.addImage(imgData, 'PNG', margin, position, imgWidth, imgHeight); heightLeft -= (pdfHeight - margin * 2); } pdf.save('风险分析报告_' + new Date().toISOString().split('T')[0] + '.pdf'); btn.disabled = false; btn.textContent = originalText; }).catch(err => { console.error('PDF error:', err); alert('PDF生成失败'); btn.disabled = false; btn.textContent = originalText; }); }).catch(err => { alert('加载库失败'); btn.disabled = false; btn.textContent = originalText; });"
                                        }]
                                    }
                                }
                            },
                            {
                                "type": "button",
                                "label": "🖨️ 打印报告",
                                "level": "info",
                                "className": "m-l-sm",
                                "onEvent": {
                                    "click": {
                                        "actions": [{
                                            "actionType": "custom",
                                            "script": "const oldStyle = document.getElementById('report-print-style'); if(oldStyle) oldStyle.remove(); const printStyle = document.createElement('style'); printStyle.id = 'report-print-style'; printStyle.textContent = '@media print { @page { size: A4 portrait; margin: 10mm; } body * { visibility: hidden !important; } .report-content-area, .report-content-area *, .report-content-area .cxd-Service, .report-content-area .cxd-Service * { visibility: visible !important; } .report-content-area { position: absolute !important; left: 0 !important; top: 0 !important; width: 100% !important; max-height: none !important; overflow: visible !important; } }'; document.head.appendChild(printStyle); window.print();"
                                        }]
                                    }
                                }
                            }
                        ]
                    }
                ]
            }]
        }
    ]
}
{% endif %}