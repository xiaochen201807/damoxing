{# 折线图组件 - 带 AI 分析面板 #}
{# 
  Parameters:
  - title: 图表标题
  - api_url: 数据API地址  
  - height: 图表高度 (default: 400)
  - smooth: 是否平滑曲线 (default: true)
  - show_area: 是否显示区域填充 (default: false)
  - drilldown_api: 钻取详情API地址 (optional)
  - drilldown_params: 钻取API参数对象 (optional)
  - export_api: 导出数据API地址 (optional)
  - ai_analysis_text: AI生成的风险分析文本 (optional)
  - ai_suggestions: AI生成的规避建议文本 (optional)
  - enable_drilldown: 是否启用钻取 (default: true)
#}
{
    "type": "grid",
    "columns": [
        {
            "md": 8,
            "body": {
                "type": "chart",
                "api": {
                    "url": "{{ api_url }}",
                    "method": "get",
                    "adaptor": "const option = payload.data || {}; if (option.series) { option.series.forEach(s => { s.smooth = {{ smooth | default('true') }}; {% if show_area %}s.areaStyle = { opacity: 0.3 };{% endif %} s.emphasis = { focus: 'series' }; }); } option.grid = { left: '3%', right: '4%', bottom: '10%', containLabel: true }; option.tooltip = { trigger: 'axis', axisPointer: { type: 'cross' } }; option.legend = { bottom: '0', left: 'center' }; return { ...payload, data: option };"
                },
                "height": {{ height | default(400) }},
                {% if enable_drilldown | default(true) %}
                "clickAction": {
                    "actionType": "dialog",
                    "dialog": {
                        "title": "${event.seriesName} - ${event.name}",
                        "size": "xl",
                        "actions": [
                            {
                                "type": "button",
                                "label": "导出",
                                "level": "primary",
                                "actionType": "download",
                                "api": "{{ export_api | default('/api/export/line-data') }}?series=${event.seriesName}&date=${event.name}"
                            },
                            {
                                "type": "button",
                                "label": "关闭",
                                "actionType": "close"
                            }
                        ],
                        "data": {
                            "selectedSeries": "${event.seriesName}",
                            "selectedDate": "${event.name}",
                            "selectedValue": "${event.value}"
                        },
                        "body": {
                            "type": "service",
                            "api": {
                                "method": "get",
                                "url": "{{ drilldown_api | default('/api/demo/line-detail') }}",
                                "requestAdaptor": "{% if drilldown_params %}const params = {{ drilldown_params | tojson | replace('\"', '\\\"') }}; const queryStr = Object.entries(params).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&'); return { ...api, url: api.url + '?' + queryStr };{% else %}const series = api.data.selectedSeries || ''; const date = api.data.selectedDate || ''; return { ...api, url: api.url + '?series=' + encodeURIComponent(series) + '&date=' + encodeURIComponent(date) };{% endif %}"
                            },
                            "body": {
                                "type": "table",
                                "columns": {% if drilldown_columns %}{{ drilldown_columns | tojson | replace('"', '\\"') }}{% else %}[
                                    {"name": "id", "label": "ID", "width": 60},
                                    {"name": "date", "label": "日期", "type": "date"},
                                    {"name": "value", "label": "数值", "type": "number"},
                                    {"name": "trend", "label": "趋势"}
                                ]{% endif %}
                            }
                        }
                    }
                }
                {% endif %}
            }
        },
        {
            "md": 4,
            "body": {
                "type": "card",
                "header": {"title": "🤖 AI 智能分析"},
                "body": [
                    {"type": "alert", "level": "info", "showIcon": true, "body": "<strong>📊 风险分析</strong><br/><br/>{{ ai_analysis_text | default('暂无AI分析数据。') }}"},
                    {"type": "divider"},
                    {"type": "alert", "level": "warning", "showIcon": true, "body": "<strong>💡 规避建议</strong><br/><br/>{{ ai_suggestions | default('暂无规避建议。') }}"}
                ]
            }
        }
    ]
}
