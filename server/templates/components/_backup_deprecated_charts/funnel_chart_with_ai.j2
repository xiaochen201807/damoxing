{# 漏斗图组件 - 带 AI 分析面板 #}
{
    "type": "grid",
    "columns": [
        {
            "md": 8,
            "body": {
                "type": "chart",
                "api": {
                    "url": "{{ api_url }}",
                    "method": "get",
                    "adaptor": "const option = payload.data || {}; if (option.series && option.series[0]) { option.series[0].type = 'funnel'; option.series[0].left = 'center'; option.series[0].width = '80%'; option.series[0].label = { show: true, position: 'inside' }; } option.tooltip = { trigger: 'item', formatter: '{b}<br/>数量: {c}<br/>占比: {d}%' }; return { ...payload, data: option };"
                },
                "height": {{ height | default(450) }},
                {% if enable_drilldown | default(true) %}
                "clickAction": {
                    "actionType": "dialog",
                    "dialog": {
                        "title": "${event.name} - 详细数据",
                        "size": "xl",
                        "body": {
                            "type": "service",
                            "api": {
                                "method": "get",
                                "url": "{{ drilldown_api | default('/api/demo/funnel-list') }}",
                                "requestAdaptor": "{% if drilldown_params %}const params = {{ drilldown_params | tojson | replace('\"', '\\\"') }}; const queryStr = Object.entries(params).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&'); return { ...api, url: api.url + '?' + queryStr };{% else %}return { ...api, url: api.url + '?stage=' + encodeURIComponent(api.data?.stageName || '') };{% endif %}"
                            },
                            "body": {
                                "type": "crud",
                                "columns": {% if drilldown_columns %}{{ drilldown_columns | tojson | replace('"', '\\"') }}{% else %}[
                                    {"name": "id", "label": "ID", "width": 60},
                                    {"name": "user_name", "label": "用户"},
                                    {"name": "status", "label": "状态"}
                                ]{% endif %}
                            }
                        },
                        "data": {"stageName": "${event.name}"}
                    }
                }
                {% endif %}
            }
        },
        {
            "md": 4,
            "body": {
                "type": "card",
                "header": {"title": "🤖 AI 智能分析"},
                "body": [
                    {"type": "alert", "level": "info", "showIcon": true, "body": "<strong>📊 风险分析</strong><br/><br/>{{ ai_analysis_text | default('暂无AI分析数据。') }}"},
                    {"type": "divider"},
                    {"type": "alert", "level": "warning", "showIcon": true, "body": "<strong>💡 规避建议</strong><br/><br/>{{ ai_suggestions | default('暂无规避建议。') }}"}
                ]
            }
        }
    ]
}
