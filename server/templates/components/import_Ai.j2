{#
  AI分析与数据导入组件
  
  === 数据导入配置 ===
  @param enable_data_import 是否启用数据导入功能
  @param import_dialog_title 数据导入对话框标题
  @param import_items 导入项配置数组，每项包含：
         - title: 显示标题
         - desc: 描述文字（可选，默认"支持格式: .xls,.xlsx"）
         - key: 表单字段名
         - accept: 上传文件类型限制（可选，默认".xls,.xlsx"）
         - template_url: 模板下载接口（POST 请求）
         - template_data: 模板下载参数（可选）
         - upload_api: 单文件上传接口（可选，配置后启用独立上传模式）
         - upload_data: 上传时附带的固定参数（可选）
  
  === AI 分析配置 ===
  @param enable_ai_analysis 是否启用AI分析功能
  @param enable_query_input 是否启用分析需求输入框
  @param query_label 分析需求输入框标签
  @param query_placeholder 分析需求输入框占位符 
	  @param ai_generate_api AI生成页面API地址
	  @param page_key 页面唯一标识
	  @param workflow_type AI 工作流类型标识（默认：ai_analysis）
	  @param query AI分析查询参数
	  @param import_check_api 智能分析前检查导入状态的接口
	  @param import_check_api_method 导入状态检查接口请求方法
	  @param import_check_data 导入状态检查接口固定参数
	  @param import_check_adaptor 导入状态检查接口适配器，需未导入时返回 status 非 0
	#}
{# 定义默认的导入项配置 #}
{% set default_items = [
    { "title": "各区县逾期率 & 房价跌幅数据", "desc": "支持格式: .xls,.xlsx", "key": "file_rate", "template_url": "/api/template/rate.xlsx" },
    { "title": "抵押房产估值偏离度数据", "desc": "支持格式: .xls,.xlsx", "key": "file_valuation", "template_url": "/api/template/valuation.xlsx" },
    { "title": "抵押物查封/冻结情况", "desc": "支持格式: .xls,.xlsx", "key": "file_seize", "template_url": "/api/template/seize.xlsx" },
    { "title": "本市房价指数 & 贷款余额趋势", "desc": "支持格式: .xls,.xlsx", "key": "file_trend", "template_url": "/api/template/trend.xlsx" }
] %}

{
    "type": "service",
    "id": "risk_analysis_root",
    "className": "p-none",
    
    "body": [
        {# ================== 1. 分析需求输入区 ================== #}
        {% if enable_ai_analysis | default(true) and enable_query_input | default(false) %}
        {
            "type": "container",
            "className": "m-t-lg m-b-md",
            "style": {
                "backgroundColor": "#fff",
                "borderRadius": "8px",
                "padding": "20px"
            },
            "body": [
                {
                    "type": "tpl",
                    "tpl": "<div style='font-size: 14px; color: #333; margin-bottom: 10px; font-weight: 500;'>{{ query_label | default('请输入分析需求') }}</div>"
                },
                {
                    "type": "textarea",
                    "name": "user_query",
                    "id": "user_query_input",
                    "placeholder": "{{ query_placeholder | default('例如：生成贷款逾期分析图表') }}",
                    "minRows": 2,
                    "maxRows": 5,
                    "showCounter": false,
                    "className": "w-full",
                    "style": {
                        "border": "1px solid #d9d9d9",
                        "borderRadius": "6px"
                    }
                }
            ]
        },
        {% endif %}

        {# ================== 2. 按钮操作区 ================== #}
        {
            "type": "container",
            "className": "m-t-lg",
            "style": {
                "border": "1px dashed #1890ff",
                "borderRadius": "8px",
                "backgroundColor": "#f0f7ff",
                "padding": "30px",
                "textAlign": "center"
            },
            "body": [
                {
                    "type": "button-group",
                    "buttons": [
                        {% set btn_comma = joiner(",") %}
                        {# --- 数据导入按钮 (保持不变) --- #}
                        {% if enable_data_import | default(true) %}
                        {{ btn_comma() }}
                        {
                            "type": "button",
                            "label": "☁️ 数据导入",
                            "className": "m-r-lg",
                            "style": { "border": "1px solid #1890ff", "color": "#003a8c", "backgroundColor": "#e6f7ff", "fontWeight": "bold", "width": "140px", "height": "40px" },
                            "actionType": "dialog",
                            "dialog": {
                                "title": "{{ import_dialog_title | default('贷后资产质量数据导入') }}",
                                "showCloseButton": true,
                                "size": "md",
                                "closeOnEsc": false,
                                "bodyClassName": "p-0",
                                "className": "import-data-dialog",
                                "style": {
                                    "borderRadius": "8px",
                                    "overflow": "hidden"
                                },
                                "body": [
                                    {
                                        "type": "tpl",
                                        "tpl": "<style>.import-data-dialog .cxd-Modal-content { border: none !important; padding: 0 !important; border-radius: 8px !important; overflow: hidden !important; } .import-data-dialog .cxd-Modal-header { background: #1c3b70; color: #fff; border-bottom: none; padding: 18px 24px; } .import-data-dialog .cxd-Modal-title { color: #fff; font-weight: 700; font-size: 18px; } .import-data-dialog .cxd-Modal-close { color: #fff; opacity: 0.8; } .import-data-dialog .cxd-Modal-close:hover { opacity: 1; } .import-data-dialog .cxd-Modal-body { padding: 24px !important; background: #fff; } .import-item-card .cxd-Card-toolbar { display: flex; align-items: center; gap: 8px; } .import-item-card .cxd-Card-actions { display: flex !important; gap: 10px; align-items: center; }</style>",
                                        "wrapperComponent": "",
                                        "className": "hidden"
                                    }{% if (import_items | default(default_items) | length) > 0 %},{% endif %}

                                    {% for item in import_items | default(default_items) %}
                                    {
                                        "type": "card",
                                        "className": "m-b-md import-item-card",
                                        "bodyClassName": "p-md",
                                        "style": {
                                            "border": "1px solid #e8e8e8",
                                            "boxShadow": "0 2px 4px rgba(0,0,0,0.02)"
                                        },
                                        "header": {
                                            "title": "{{ item.title }}",
                                            "subTitle": "{{ item.desc | default('支持格式: .xlsx') }}"
                                        },
                                        "toolbar": [
                                            {
                                                "type": "service",
                                                "className": "m-0 p-0",
                                                "style": { "display": "inline-block", "marginRight": "10px" },
                                                "data": {
                                                    "injected_tpl_data": {{ item.template_data | default({}) | tojson }}
                                                },
                                                "body": [
                                                    {
                                                        "type": "button",
                                                        "label": "下载模板",
                                                        "icon": "fa fa-download",
                                                        "level": "default",
                                                        "onEvent": {
                                                            "click": {
                                                                "actions": [
                                                                    {
                                                                        "actionType": "custom",
                                                                        "script": "console.log('v4.6 (Gateway Support) fetch start'); let token = localStorage.getItem('auth_token') || localStorage.getItem('token') || localStorage.getItem('amis-token'); const headers = { 'Content-Type': 'application/json' }; if (token) { headers['Authorization'] = 'Bearer ' + token; } const gatewayInfoStr = localStorage.getItem('gateway_info'); if (gatewayInfoStr) { try { const info = JSON.parse(gatewayInfoStr); if (info.login_token) { const parts = info.login_token.split(':'); if (parts.length > 1) { headers['channel'] = parts[1]; } headers['login-token'] = info.login_token; } if (info.jgbh) headers['jgbh'] = info.jgbh; if (info.zzbs) headers['zzbs'] = info.zzbs; if (info.zzjgdmz) headers['zzjgdmz'] = info.zzjgdmz; headers['x-requested-with'] = 'XMLHttpRequest'; console.log('Gateway headers added'); } catch(e) { console.warn('Parse gateway_info failed', e); } } let url = '{{ item.template_url }}'; console.log('Fetching URL:', url); console.log('DEBUG: Full Event Data', event.data); let tplData = (event.data && event.data.injected_tpl_data); console.log('DEBUG: Raw tplData', tplData); if (typeof tplData === 'string') { try { tplData = JSON.parse(tplData); } catch(e) { console.warn('Parse tplData failed', e); } } console.log('DEBUG: Parsed tplData', tplData); let contextData = {}; try { if (typeof event !== 'undefined' && event.data) { contextData = JSON.parse(JSON.stringify(event.data)); } } catch(e) { contextData = event.data || {}; } const requestBody = { ...contextData, ...(tplData || {}) }; console.log('Request body:', requestBody); fetch(url, { method: 'POST', headers: headers, body: JSON.stringify(requestBody) }).then(res => { console.log('Fetch response status:', res.status); if(!res.ok) throw new Error('Network error: ' + res.status); return res.blob(); }).then(blob => { console.log('Blob received', blob.size); var url = window.URL.createObjectURL(blob); var a = document.createElement('a'); a.href = url; a.download = '模板文件.xlsx'; document.body.appendChild(a); a.click(); document.body.removeChild(a); window.URL.revokeObjectURL(url); }).catch(err => { console.error('Download error:', err); alert('下载出错: ' + err.message); });"
                                                                    }
                                                                ]
                                                            }
                                                        }
                                                    }
                                                ]
                                            },
                                            {% if item.upload_api %}
                                            { 
                                                "type": "input-file", 
                                                "name": "{{ item.key }}", 
                                                "btnLabel": "上传文件", 
                                                "level": "primary", 
                                                "icon": "fa fa-cloud-upload",
                                                "accept": "{{ item.accept | default('.xls,.xlsx') }}",
                                                "autoUpload": true,
                                                "drag": false,
	                                                "receiver": {
	                                                    "method": "post",
	                                                    "url": "{{ item.upload_api }}",
	                                                    "data": {{ item.upload_data | default('{}') | fromjson | tojson }}
	                                                }
	                                            }
	                                            {% else %}
                                            { 
                                                "type": "input-file", 
                                                "name": "{{ item.key }}", 
                                                "btnLabel": "上传文件",  
                                                "level": "primary", 
	                                                "icon": "fa fa-cloud-upload",
	                                                "accept": "{{ item.accept | default('.xls,.xlsx') }}",
	                                                "drag": false,
	                                                "asBlob": true
	                                            }
	                                            {% endif %}
                                        ]
                                    }
                                    {% if not loop.last %},{% endif %}
                                    {% endfor %}
                                ],
                                "actions": []
                            }
                        }
                        {% endif %}

                        {# --- 智能分析按钮 --- #}
                        {% if enable_ai_analysis | default(true) %}
                        {{ btn_comma() }}
                        {
	                            "type": "button",
	                            "label": "📊 智能分析",
	                            "level": "danger",
	                            "style": {
                                "background": "linear-gradient(180deg, #ff4d4f 0%, #cf1322 100%)",
                                "border": "none",
                                "boxShadow": "0 4px 10px rgba(207, 19, 34, 0.3)",
                                "fontWeight": "bold",
                                "width": "140px",
                                "height": "40px"
                            },
	                            "onEvent": {
	                                "click": {
	                                    "actions": [
	                                        {% if analysis_requires_import | default(false) %}
	                                        {
	                                            "actionType": "ajax",
	                                            "outputVar": "importCheckResult",
	                                            "api": {
	                                                "method": "{{ import_check_api_method | default('post') }}",
	                                                "url": "{{ import_check_api | default('/HFB/common/dmx/management=gjznkm_drzt.service') }}",
	                                                "dataType": "json",
	                                                "data": {{ import_check_data | default('{}') | fromjson | tojson }},
	                                                "adaptor": {% if import_check_adaptor %}{{ import_check_adaptor | tojson }}{% else %}"const raw = payload && payload.data !== undefined ? payload.data : (payload || {}); const data = raw && raw.data !== undefined ? raw.data : raw; const statusOk = (payload && payload.status === 0) || (raw && raw.status === 0); const count = Array.isArray(data) ? data.length : Number((data && (data.count || data.total || data.rows || data.size)) || 0); const ok = statusOk && (count > 0 || (data && (data.canAnalyze === true || data.can_analysis === true || data.imported === true || data.is_imported === true || data.hasData === true || data.has_data === true || data.sfdr === '1' || data.drzt === '1'))); if (!ok) { return { status: 1, msg: (raw && raw.msg) || (payload && payload.msg) || '请先完成数据导入后再进行智能分析', data: raw }; } return { status: 0, msg: '', data: raw }; "{% endif %}
	                                            }
	                                        },
	                                        {% endif %}
	                                        {# 1. 修改最外层 Page 变量：开启遮罩，显示区域 #}
	                                        {
                                            "actionType": "setValue",
                                            "componentId": "global_page_root",
                                            "args": {
                                                "value": {
                                                    "show_analysis_result": true,
                                                    "ai_loading": true
                                                }
                                            }
                                        },
                                        {# 2. 触发 Service 重新加载 #}
                                        {
                                            "actionType": "reload",
                                            "componentId": "risk_analysis_service_inner"
                                        }
                                    ]
                                }
                            }
                        }
                        {% endif %}
                    ]
                }
            ]
        },

         {# ================== 2. 全局 Loading 遮罩 (UI 升级版) ================== #}
        {
            "type": "container",
            "visibleOn": "${ai_loading}",
            "style": {
                "position": "fixed",
                "top": "0",
                "left": "0",
                "width": "100vw",
                "height": "100vh",
                {# 优化 1: 背景透明度调高 (0.9 -> 0.6)，配合模糊滤镜，更具现代感 #}
                "backgroundColor": "rgba(255, 255, 255, 0.6)",
                "zIndex": "9999",
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "center",
                "backdropFilter": "blur(8px)" {# 磨砂玻璃效果 #}
            },
            "body": [
                {
                    "type": "container",
                    "style": {
                        {# 优化 2: 完全移除白色卡片背景和边框 #}
                        "backgroundColor": "transparent",
                        "boxShadow": "none",
                        "border": "none",
                        "padding": "0",
                        "width": "auto",
                        "textAlign": "center"
                    },
                    "body": [
                        {
                            "type": "custom",
                            "name": "ai-modal-timer",
                            {# 优化 3: 动画颜色改为蓝色 (#1890ff) 以匹配页面主色调，去除红色带来的紧迫感 #}
                            "html": "<div style='font-family: -apple-system, BlinkMacSystemFont, Helvetica Neue, Arial; color: #333;'><div style='position: relative; width: 80px; height: 80px; margin: 0 auto 24px auto;'><svg viewBox='0 0 50 50' style='width: 100%; height: 100%; animation: spin 2s linear infinite;'><circle cx='25' cy='25' r='20' fill='none' stroke='#e6f7ff' stroke-width='4'></circle><circle cx='25' cy='25' r='20' fill='none' stroke='#1890ff' stroke-width='4' stroke-dasharray='80' stroke-dashoffset='60' stroke-linecap='round'></circle></svg><div style='position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; color: #1890ff; font-feature-settings: \"tnum\";'><span id='modal-timer-sec'>0</span><span style='font-size: 12px; margin-left: 2px; font-weight: 400;'>s</span></div></div><div style='font-size: 18px; font-weight: 600; color: #333; margin-bottom: 12px; letter-spacing: 0.5px; text-shadow: 0 2px 10px rgba(255,255,255,0.8);'>AI 智能分析中</div><div id='modal-timer-text' style='font-size: 14px; color: #666; height: 20px; font-weight: 500;'>正在接入数据中心...</div><style>@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }</style></div>",
                            "onMount": "const startTime = Date.now(); const secDom = document.getElementById('modal-timer-sec'); const textDom = document.getElementById('modal-timer-text'); const texts = ['正在加载业务数据...', '正在构建风险模型...', 'AI 正在生成洞察...', '正在渲染分析报告...']; window.modalTimer = setInterval(() => { const elapsed = ((Date.now() - startTime) / 1000).toFixed(1); if(secDom) secDom.innerText = elapsed; const step = Math.floor(elapsed / 3) % texts.length; if(textDom) textDom.innerText = texts[step]; }, 100);",
                            "onUnmount": "clearInterval(window.modalTimer);"
                        }
                    ]
                }
            ]
        }

        {# ================== 3. 结果展示区 (Service) ================== #}
        {% if enable_ai_analysis | default(true) %}
        {% set footer_comma = joiner(",") %}
        {{ footer_comma() }} {# consumes first comma if run before, but joiner is new instance? No, need to be careful. Joiner creates NEW instance. #}
        {# Wait, I cannot use joiner across disjoint blocks easily if I don't pass it. #}
        {# But here, we have: [ ...buttonsContainer... , ...loadingMask... ] #}
        {# Then we have Service. #}
        {# The structure is: body: [ {Container}, {Mask} (COMMA) {Service} ] #}
        {# The Mask is ALWAYS present. So there is ALWAYS a comma before Service if Service exists. #}
        {# So comma is safe here. But my previous fix was just adding a comma. #}
        {# If I use ,{...} that's fine. #}
        ,{
            "type": "service",
            "id": "risk_analysis_service_inner", 
            
            {# 保持 hidden 逻辑，避免 ECharts 在 display:none 下计算尺寸出错 #}
            "className": "${!show_analysis_result ? 'hidden' : 'm-t-md'}",
            
            "initFetch": false,
            "spinner": null, 

            "schemaApi": {
                "method": "post",
                "url": "{{ ai_generate_api | default('/api/ai/generate-page') }}",
                
                {# 门禁：检查最外层 Page 变量 #}
                "sendOn": "this.ai_loading === true",
                
                "data": {
                    "pageId": "{{ page_key }}",
                    "workflow_type": "{{ workflow_type | default('ai_analysis') }}",  {# 🆕 智能分析按钮的工作流类型 #}
                    {% if enable_query_input | default(false) %}
                    "query": "${user_query || '用户未指定要求'}",
                    {% else %}
                    "query": "{{ query | default('用户未指定要求') }}",
                    {% endif %}
                    "timestamp": "${date(now(), 'x')}"
                }
            },
            
            "onEvent": {
                {# ⭐⭐ 核心：使用官方事件 fetchSchemaInited ⭐⭐ #}
                {# 该事件专门在 schemaApi 返回并初始化 UI 完成后触发 #}
                "fetchSchemaInited": {
                    "actions": [
                        {
                            "actionType": "setValue",
                            "componentId": "global_page_root",
                            "args": {
                                "value": {
                                    "ai_loading": false
                                }
                            }
                        },
                        {
                            "actionType": "toast",
                            "args": { "msgType": "success", "msg": "分析完成" }
                        }
                    ]
                },
                
                {# 处理失败情况 #}
                "fetchFailed": {
                    "actions": [
                        {
                            "actionType": "setValue",
                            "componentId": "global_page_root",
                            "args": { "value": { "ai_loading": false } }
                        },
                        {
                            "actionType": "toast",
                            "args": { "msgType": "error", "msg": "服务异常，请重试" }
                        }
                    ]
                }
            },
            
            "body": {
                "type": "tpl",
                "tpl": "",
                "visible": false
            }
        }
        {% endif %}
    ]
}
