{#
  AI分析与数据导入组件
  @param enable_data_import 是否启用数据导入功能
  @param enable_ai_analysis 是否启用AI分析功能
  @param import_dialog_title 数据导入对话框标题
  @param import_api 数据导入API地址
  @param ai_generate_api AI生成页面API地址
  @param page_key 页面唯一标识
  @param query AI分析查询参数
#}
{# 定义默认的导入项配置 #}
{% set default_items = [
    { "title": "各区县逾期率 & 房价跌幅数据", "desc": "支持格式: .xls,.xlsx", "key": "file_rate", "template_url": "/api/template/rate.xlsx" },
    { "title": "抵押房产估值偏离度数据", "desc": "支持格式: .xls,.xlsx", "key": "file_valuation", "template_url": "/api/template/valuation.xlsx" },
    { "title": "抵押物查封/冻结情况", "desc": "支持格式: .xls,.xlsx", "key": "file_seize", "template_url": "/api/template/seize.xlsx" },
    { "title": "本市房价指数 & 贷款余额趋势", "desc": "支持格式: .xls,.xlsx", "key": "file_trend", "template_url": "/api/template/trend.xlsx" }
] %}

{
    "type": "service",
    "id": "risk_analysis_root",
    "className": "p-none",
    
    "body": [
        {# ================== 1. 按钮操作区 ================== #}
        {
            "type": "container",
            "className": "m-t-lg",
            "style": {
                "border": "1px dashed #1890ff",
                "borderRadius": "8px",
                "backgroundColor": "#f0f7ff",
                "padding": "30px",
                "textAlign": "center"
            },
            "body": [
                {
                    "type": "button-group",
                    "buttons": [
                        {# --- 数据导入按钮 (保持不变) --- #}
                        {% if enable_data_import | default(true) %}
                        {
                            "type": "button",
                            "label": "☁️ 数据导入",
                            "className": "m-r-lg",
                            "style": { "border": "1px solid #1890ff", "color": "#003a8c", "backgroundColor": "#e6f7ff", "fontWeight": "bold", "width": "140px", "height": "40px" },
                            "actionType": "dialog",
                            "dialog": {
                                "title": "{{ import_dialog_title | default('违规提取风险数据导入') }}",
                                "size": "lg",
                                "body": {
                                    "type": "form",
                                    "api": "{{ import_api | default('post:/api/risk/import/batch') }}",
                                    "mode": "normal",
                                    "body": [
                                        {% for item in import_items | default(default_items) %}
                                        {
                                            "type": "container",
                                            "className": "import-card-row",
                                            "style": { "border": "1px solid #e8e8e8", "borderRadius": "6px", "padding": "16px 20px", "marginBottom": "12px", "backgroundColor": "#fff", "display": "flex", "alignItems": "center", "justifyContent": "space-between" },
                                            "body": [
                                                { "type": "tpl", "tpl": "<div><div style='font-weight: 600; font-size: 14px; color: #333; margin-bottom: 4px;'>{{ item.title }}</div><div style='font-size: 12px; color: #999;'>{{ item.desc | default('支持格式: .xls,.xlsx') }}</div></div>", "style": { "flex": "1" } },
                                                { "type": "container", "style": { "display": "flex", "alignItems": "center", "gap": "10px" }, "body": [ { "type": "button", "label": "⬇ 下载模板", "level": "default", "size": "sm", "actionType": "download", "api": "{{ item.template_url }}", "style": { "borderColor": "#d9d9d9", "color": "#666" } }, { "type": "input-file", "name": "{{ item.key }}", "btnLabel": "⬆ 上传文件", "level": "primary", "mode": "inline", "accept": ".xlsx,.xls", "maxSize": 10485760, "asBlob": true, "inputClassName": "m-b-none", "style": { "margin": "0" } } ] }
                                            ]
                                        }
                                        {% if not loop.last %},{% endif %}
                                        {% endfor %}
                                    ]
                                },
                                "actions": [
                                    { "type": "button", "actionType": "cancel", "label": "取消" },
                                    { "type": "button", "actionType": "confirm", "label": "确定导入", "level": "primary" }
                                ]
                            }
                        }
                        {% endif %}

                        {% if enable_data_import | default(true) and enable_ai_analysis | default(true) %},{% endif %}

                        {# --- 智能分析按钮 --- #}
                        {% if enable_ai_analysis | default(true) %}
                        {
                            "type": "button",
                            "label": "📊 智能分析",
                            "level": "danger",
                            "style": {
                                "background": "linear-gradient(180deg, #ff4d4f 0%, #cf1322 100%)",
                                "border": "none",
                                "boxShadow": "0 4px 10px rgba(207, 19, 34, 0.3)",
                                "fontWeight": "bold",
                                "width": "140px",
                                "height": "40px"
                            },
                            "onEvent": {
                                "click": {
                                    "actions": [
                                        {# 1. 修改最外层 Page 变量：开启遮罩，显示区域 #}
                                        {
                                            "actionType": "setValue",
                                            "componentId": "global_page_root",
                                            "args": {
                                                "value": {
                                                    "show_analysis_result": true,
                                                    "ai_loading": true
                                                }
                                            }
                                        },
                                        {# 2. 触发 Service 重新加载 #}
                                        {
                                            "actionType": "reload",
                                            "componentId": "risk_analysis_service_inner"
                                        }
                                    ]
                                }
                            }
                        }
                        {% endif %}
                    ]
                }
            ]
        },

         {# ================== 2. 全局 Loading 遮罩 (UI 升级版) ================== #}
        {
            "type": "container",
            "visibleOn": "${ai_loading}",
            "style": {
                "position": "fixed",
                "top": "0",
                "left": "0",
                "width": "100vw",
                "height": "100vh",
                {# 优化 1: 背景透明度调高 (0.9 -> 0.6)，配合模糊滤镜，更具现代感 #}
                "backgroundColor": "rgba(255, 255, 255, 0.6)",
                "zIndex": "9999",
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "center",
                "backdropFilter": "blur(8px)" {# 磨砂玻璃效果 #}
            },
            "body": [
                {
                    "type": "container",
                    "style": {
                        {# 优化 2: 完全移除白色卡片背景和边框 #}
                        "backgroundColor": "transparent",
                        "boxShadow": "none",
                        "border": "none",
                        "padding": "0",
                        "width": "auto",
                        "textAlign": "center"
                    },
                    "body": [
                        {
                            "type": "custom",
                            "name": "ai-modal-timer",
                            {# 优化 3: 动画颜色改为蓝色 (#1890ff) 以匹配页面主色调，去除红色带来的紧迫感 #}
                            "html": "<div style='font-family: -apple-system, BlinkMacSystemFont, Helvetica Neue, Arial; color: #333;'><div style='position: relative; width: 80px; height: 80px; margin: 0 auto 24px auto;'><svg viewBox='0 0 50 50' style='width: 100%; height: 100%; animation: spin 2s linear infinite;'><circle cx='25' cy='25' r='20' fill='none' stroke='#e6f7ff' stroke-width='4'></circle><circle cx='25' cy='25' r='20' fill='none' stroke='#1890ff' stroke-width='4' stroke-dasharray='80' stroke-dashoffset='60' stroke-linecap='round'></circle></svg><div style='position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; color: #1890ff; font-feature-settings: \"tnum\";'><span id='modal-timer-sec'>0</span><span style='font-size: 12px; margin-left: 2px; font-weight: 400;'>s</span></div></div><div style='font-size: 18px; font-weight: 600; color: #333; margin-bottom: 12px; letter-spacing: 0.5px; text-shadow: 0 2px 10px rgba(255,255,255,0.8);'>AI 智能分析中</div><div id='modal-timer-text' style='font-size: 14px; color: #666; height: 20px; font-weight: 500;'>正在接入数据中心...</div><style>@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }</style></div>",
                            "onMount": "const startTime = Date.now(); const secDom = document.getElementById('modal-timer-sec'); const textDom = document.getElementById('modal-timer-text'); const texts = ['正在加载业务数据...', '正在构建风险模型...', 'AI 正在生成洞察...', '正在渲染分析报告...']; window.modalTimer = setInterval(() => { const elapsed = ((Date.now() - startTime) / 1000).toFixed(1); if(secDom) secDom.innerText = elapsed; const step = Math.floor(elapsed / 3) % texts.length; if(textDom) textDom.innerText = texts[step]; }, 100);",
                            "onUnmount": "clearInterval(window.modalTimer);"
                        }
                    ]
                }
            ]
        },

        {# ================== 3. 结果展示区 (Service) ================== #}
        {% if enable_ai_analysis | default(true) %}
        {
            "type": "service",
            "id": "risk_analysis_service_inner", 
            
            {# 保持 hidden 逻辑，避免 ECharts 在 display:none 下计算尺寸出错 #}
            "className": "${!show_analysis_result ? 'hidden' : 'm-t-md'}",
            
            "initFetch": false,
            "spinner": null, 

            "schemaApi": {
                "method": "post",
                "url": "{{ ai_generate_api | default('/api/ai/generate-page') }}",
                
                {# 门禁：检查最外层 Page 变量 #}
                "sendOn": "this.ai_loading === true",
                
                "data": {
                    "pageId": "{{ page_key }}",
                    "query": "{{ query | default('{}') }}",
                    "timestamp": "${date(now(), 'x')}"
                }
            },
            
            "onEvent": {
                {# ⭐⭐ 核心：使用官方事件 fetchSchemaInited ⭐⭐ #}
                {# 该事件专门在 schemaApi 返回并初始化 UI 完成后触发 #}
                "fetchSchemaInited": {
                    "actions": [
                        {
                            "actionType": "setValue",
                            "componentId": "global_page_root",
                            "args": {
                                "value": {
                                    "ai_loading": false
                                }
                            }
                        },
                        {
                            "actionType": "toast",
                            "args": { "msgType": "success", "msg": "分析完成" }
                        }
                    ]
                },
                
                {# 处理失败情况 #}
                "fetchFailed": {
                    "actions": [
                        {
                            "actionType": "setValue",
                            "componentId": "global_page_root",
                            "args": { "value": { "ai_loading": false } }
                        },
                        {
                            "actionType": "toast",
                            "args": { "msgType": "error", "msg": "服务异常，请重试" }
                        }
                    ]
                }
            },
            
            "body": {
                "type": "tpl",
                "tpl": "",
                "visible": false
            }
        }
        {% endif %}
    ]
}