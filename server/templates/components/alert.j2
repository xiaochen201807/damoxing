{#
  提示框组件
  @param alert_html 提示框HTML内容
#}
{# Alert Component - Escapes quotes for valid JSON output #}
{
    "type": "tpl",
    "tpl": {{ ("<div style='margin-bottom: 12px; padding: 12px 16px; border-radius: 4px; background-color: #e6f7ff; border: 1px solid #91d5ff; color: #1890ff;'>" + (alert_html | default('')) + "</div>") | tojson }}
}
