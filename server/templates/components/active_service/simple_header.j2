{#
  @param title 标题文本
  @param show_refresh_button 是否显示刷新按钮
  @param refresh_button_text 刷新按钮文本
  @param reload_target 刷新目标组件名称
#}
{
  "type": "wrapper",
  "className": "b-b m-b-md p-b-md flex justify-between items-center bg-white",
  "body": [
    {
      "type": "tpl",
      "tpl": "<div class='text-lg font-bold text-dark'>{{ title | default('页面标题') }}</div>"
    },
    {
      "type": "button",
      "label": "{{ refresh_button_text | default('刷新') }}",
      "icon": "fa fa-refresh",
      "actionType": "reload",
      "target": "{{ reload_target }}",
      "level": "primary",
      "size": "sm",
      "visibleOn": "{{ show_refresh_button | default(false) }}"
    }
  ]
}
