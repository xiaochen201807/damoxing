{#
  @param title 标题文本
  @param show_refresh_button 是否显示刷新按钮
  @param refresh_button_text 刷新按钮文本
  @param reload_target 刷新目标组件名称
#}
{
  "type": "wrapper",
  "className": "b-b p-b-md flex justify-between items-center bg-white",
  "body": [
    {
      "type": "tpl",
      "tpl": "<div class='text-lg font-bold text-dark'>{{ title | default('页面标题') }}</div>"
    }
    {% if show_refresh_button == true or show_refresh_button == 'true' %}
    ,{
      "type": "button",
      "label": "{{ refresh_button_text | default('刷新数据') }}",
      "icon": "fa fa-refresh",
      "actionType": "reload",
      "target": "{{ reload_target | default('service_cards_grid') }}",
      "level": "primary",
      "size": "sm"
    }
    {% endif %}
  ]
}
