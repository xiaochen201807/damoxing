{#
  @param api 数据接口URL, 默认 "/api/demo/cards"
  @param columns 每行显示的列数, 默认 3
  @param min_card_width 卡片最小宽度, 默认 "280px"
  @param target_field 下钻目标字段名, 默认 "target_value"
  @param service_name 组件名称, 默认 "service_cards_list"
  @param card_height 卡片高度, 默认 "auto"
#}
{
  "type": "service",
  "name": "{{ service_name | default('service_cards_list') }}",
  "api": {
    "method": "post",
    "url": "{{ api | default('/api/demo/cards') }}",
    "data": {}
  },
  "body": {
    "type": "cards",
    "source": "${items}",
    "columnsCount": {{ columns | default(4) }},
    "card": {
      "className": "service-card-item",
      "style": {
        "borderRadius": "12px",
        "boxShadow": "0 4px 16px rgba(24,144,255,0.12)",
        "border": "1px solid #e8f4ff",
        "overflow": "hidden",
        "background": "#fff"
      },
      "header": {
        "className": "service-card-header p-none",
        "title": "",
        "subTitle": ""
      },
      "body": [
        {
          "type": "tpl",
          "tpl": "<div style='background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%); padding: 14px 18px; display: flex; align-items: center; gap: 12px; border-radius: 11px 11px 0 0;'><div style='width: 40px; height: 40px; background: rgba(255,255,255,0.25); border-radius: 8px; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);'><i class='${icon}' style='font-size: 20px; color: #fff;'></i></div><div style='color: #fff; font-size: 15px; font-weight: 600; text-shadow: 0 1px 2px rgba(0,0,0,0.1);'>${title}</div></div>"
        },
        {
          "type": "container",
          "style": {
            "flex": "1",
            "padding": "16px 18px 12px 18px"
          },
          "body": [
            {
              "type": "tpl",
              "tpl": "<div style='color: #555; font-size: 13px; line-height: 1.8; min-height: 56px;'>${desc}</div>"
            }
          ]
        },
        {
          "type": "tpl",
          "style": {
            "padding": "0 18px 16px 18px"
          },
          "tpl": "<div style='background: linear-gradient(135deg, #E6F7FF 0%, #F0FAFF 100%); padding: 10px 14px; border-radius: 6px; border: 1px solid #91D5FF;'><span style='color: #1890FF; font-weight: 500; font-size: 13px;'>目标群体：</span><span style='color: #262626; font-size: 13px;'>${target_value}</span></div>"
        }
      ],
      "actions": [
        {
          "type": "button",
          "label": "一键提醒",
          "icon": "fa fa-paper-plane",
          "level": "primary",
          "className": "w-full",
          "actionType": "dialog",
          "dialog": {
            "title": "${title} - 详情",
            "body": "这里是操作弹窗"
          }
        }
      ]
    }
  }
}