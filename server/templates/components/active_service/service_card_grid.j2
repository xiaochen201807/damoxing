{#
  @param api 数据接口URL, 默认 "/api/demo/cards"
  @param min_card_width 卡片最小宽度, 默认 "320px"
  @param target_field 下钻目标字段名, 默认 "target_value"
  @param service_name 组件名称, 默认 "service_cards_list"
#}
{
  "type": "service",
  "name": "{{ service_name | default('service_cards_list') }}",
  "api": {
    "method": "post",
    "url": "{{ api | default('/api/demo/cards') }}",
    "data": {}
  },
  "body": {
    "type": "cards",
    "source": "${items}",
    "className": "service-cards-container",
    "style": {
      "display": "grid",
      "grid-template-columns": "repeat(auto-fill, minmax({{ min_card_width | default('320px') }}, 1fr))",
      "gap": "24px",
      "width": "100%"
    },
    "card": {
      "className": "p-none b-a m-b-sm hover:shadow-lg transition-all h-full flex flex-col",
      "header": {
        "className": "bg-primary p-sm b-b-none",
        "title": "<div class='flex items-center'><div class='m-r-sm flex items-center justify-center rounded' style='width: 32px; height: 32px; background: rgba(255,255,255,0.2);'><i class='${icon} text-lg'></i></div><span>${title}</span></div>",
        "titleClassName": "text-white font-bold text-md p-xs",
        "subTitle": ""
      },
      "body": [
        {
          "type": "tpl",
          "tpl": "<div style='height: 60px; overflow: hidden; color: #666; font-size: 13px; margin-bottom: 15px;'>${desc}</div>",
          "className": "m-b-sm"
        },
        {
          "type": "container",
          "className": "target-group-box m-t-auto",
          "style": {
            "background": "#E8F4FF",
            "padding": "12px",
            "borderRadius": "4px"
          },
          "body": [
            {
              "type": "tpl",
              "tpl": "<span class='text-primary font-bold'>目标群体：</span><span class='text-dark'>${ {{ target_field | default('target_value') }} }</span>"
            }
          ]
        }
      ],
      "actions": [
        {
          "type": "button",
          "label": "一键提醒",
          "level": "primary",
          "block": true,
          "icon": "fa fa-paper-plane",
          "actionType": "dialog",
          "dialog": {
            "title": "${title} - 详情",
            "body": {
              "type": "tpl",
              "tpl": "这里是操作弹窗"
            }
          }
        }
      ],
      "toolbar": []
    }
  }
}
