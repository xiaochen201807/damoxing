{#
  @param api 数据接口URL, 默认 "/api/demo/cards"
  @param columns 每行显示的列数, 默认 3
  @param min_card_width 卡片最小宽度, 默认 "280px"
  @param target_field 下钻目标字段名, 默认 "target_value"
  @param service_name 组件名称, 默认 "service_cards_list"
  @param card_height 卡片高度, 默认 "auto"
#}
{
  "type": "service",
  "name": "{{ service_name | default('service_cards_list') }}",
  "api": {
    "method": "post",
    "url": "{{ api | default('/api/demo/cards') }}",
    "data": {}
  },
  "body": {
    "type": "cards",
    "source": "${items}",
    "columnsCount": {{ columns | default(4) }},
    "card": {
      "className": "service-card-item",
      "style": {
        "borderRadius": "8px",
        "boxShadow": "0 2px 8px rgba(0,0,0,0.1)",
        "border": "1px solid #e8e8e8",
        "overflow": "hidden"
      },
      "header": {
        "title": "${title}",
        "subTitle": "",
        "avatar": "${icon}",
        "avatarClassName": "pull-left thumb-md avatar b-3x m-r"
      },
      "body": [
        {
          "type": "container",
          "className": "card-body-content",
          "style": {
            "padding": "16px",
            "background": "#fff"
          },
          "body": [
            {
              "type": "tpl",
              "tpl": "<div style='color: #666; font-size: 14px; line-height: 1.5; margin-bottom: 12px;'>${desc}</div>"
            },
            {
              "type": "tpl",
              "tpl": "<div style='background: #f0f0f0; padding: 10px 12px; border-radius: 6px;'><span style='color: #1890FF; font-weight: 600;'>目标群体：</span><span style='color: #333;'>${target_value}</span></div>"
            }
          ]
        }
      ],
      "actions": [
        {
          "type": "button",
          "label": "一键提醒",
          "level": "primary",
          "actionType": "dialog",
          "dialog": {
            "title": "${title} - 详情",
            "body": "这里是操作弹窗"
          }
        }
      ]
    }
  }
}