{#
  @param api 数据接口URL, 默认 "/api/demo/cards"
  @param columns 每行显示的列数, 默认 3
  @param min_card_width 卡片最小宽度, 默认 "280px"
  @param target_field 下钻目标字段名, 默认 "target_value"
  @param service_name 组件名称, 默认 "service_cards_list"
  @param card_height 卡片高度, 默认 "auto"
#}
{
  "type": "service",
  "name": "{{ service_name | default('service_cards_list') }}",
  "api": {
    "method": "post",
    "url": "{{ api | default('/api/demo/cards') }}",
    "data": {}
  },
  "body": {
    "type": "cards",
    "source": "${items}",
    "columnsCount": {{ columns | default(4) }},
    "card": {
      "className": "service-card-item",
      "style": {
        "borderRadius": "8px",
        "boxShadow": "0 2px 8px rgba(0,0,0,0.1)",
        "border": "1px solid #e8e8e8",
        "overflow": "hidden"
      },
      "header": {
        "title": "${title}",
        "subTitle": ""
      },
      "body": [
        {
          "type": "flex",
          "className": "p-3",
          "style": {
            "gap": "16px"
          },
          "items": [
            {
              "type": "tpl",
              "tpl": "<div style='width: 56px; height: 56px; background: linear-gradient(135deg, #1890FF 0%, #36CFC9 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center;'><i class='${icon}' style='font-size: 24px; color: #fff;'></i></div>"
            },
            {
              "type": "container",
              "style": {
                "flex": "1"
              },
              "body": [
                {
                  "type": "tpl",
                  "tpl": "<div style='color: #666; font-size: 14px; line-height: 1.6;'>${desc}</div>"
                }
              ]
            }
          ]
        },
        {
          "type": "tpl",
          "className": "p-3 pt-0",
          "tpl": "<div style='background: linear-gradient(135deg, #f6f8fa 0%, #eef2f7 100%); padding: 12px 14px; border-radius: 8px;'><span style='color: #1890FF; font-weight: 600;'>目标群体：</span><span style='color: #333;'>${target_value}</span></div>"
        }
      ],
      "actions": [
        {
          "type": "button",
          "label": "一键提醒",
          "level": "primary",
          "actionType": "dialog",
          "dialog": {
            "title": "${title} - 详情",
            "body": "这里是操作弹窗"
          }
        }
      ]
    }
  }
}