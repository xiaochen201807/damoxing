{#
  政策参数调整表单组件
  提供可配置的表单字段，用于调整政策参数
  
  @param form_title 表单标题（默认：调整政策参数）
  @param form_description 表单描述（可选）
  @param form_fields 表单字段配置数组，格式：
    [
      {
        "type": "input-number",  // 字段类型
        "name": "rent_limit",    // 字段名
        "label": "月租金提取上限（元）",  // 标签
        "value": 2500,           // 默认值
        "min": 1000,             // 最小值（数字类型）
        "max": 5000,             // 最大值（数字类型）
        "required": true         // 是否必填
      },
      ...
    ]
  @param submit_button_text 提交按钮文本（默认：应用并预测）
  @param reset_button_text 重置按钮文本（默认：重置）
  @param enable_reset 是否显示重置按钮（默认：true）
  @param prediction_api 预测接口 API（默认：/api/policy/predict）
#}

{
    "type": "container",
    "className": "m-t-md",
    "style": {
        "backgroundColor": "#fff",
        "borderRadius": "10px",
        "boxShadow": "0 4px 8px rgba(0, 0, 0, 0.05)",
        "padding": "25px",
        "marginBottom": "30px"
    },
    "body": [
        {# 表单标题 #}
        {
            "type": "tpl",
            "tpl": "<div style='font-weight: 600; color: #1a3c6e; font-size: 16px; display: flex; align-items: center; gap: 8px; margin-bottom: {% if form_description %}10{% else %}20{% endif %}px;'><i style='font-size: 18px;'>✏️</i> {{ form_title | default('调整政策参数') }}</div>"
        },

        {# 表单描述（可选）#}
        {% if form_description %}
        {
            "type": "tpl",
            "tpl": "<div style='color: #666; font-size: 13px; margin-bottom: 20px; padding: 12px; background: #f0f7ff; border-left: 3px solid #1890ff; border-radius: 4px;'>{{ form_description }}</div>"
        },
        {% endif %}

        {# 表单主体 #}
        {
            "type": "form",
            "mode": "normal",
            "wrapWithPanel": false,
            "resetAfterSubmit": false,
            "api": {
                "method": "post",
                "url": "{{ prediction_api | default('/api/policy/predict') }}",
                "data": {
                    "&": "$$",
                    "page_key": "{{ page_key }}",
                    "timestamp": "${date(now(), 'x')}"
                }
            },
            "onEvent": {
                "submitSucc": {
                    "actions": [
                        {# 显示预测区域 #}
                        {
                            "actionType": "setValue",
                            "componentId": "global_page_root",
                            "args": {
                                "value": {
                                    "show_prediction": true
                                }
                            }
                        },
                        {
                            "actionType": "toast",
                            "args": {
                                "msgType": "success",
                                "msg": "预测完成！请查看下方预测数据"
                            }
                        }
                    ]
                },
                "submitFail": {
                    "actions": [
                        {
                            "actionType": "toast",
                            "args": {
                                "msgType": "error",
                                "msg": "预测失败，请重试"
                            }
                        }
                    ]
                }
            },
            "body": [
                {# 表单字段网格布局 #}
                {
                    "type": "group",
                    "mode": "horizontal",
                    "gap": "md",
                    "body": [
                        {% for field in form_fields | default([]) %}
                        {
                            "type": "{{ field.type | default('input-text') }}",
                            "name": "{{ field.name }}",
                            "label": "{{ field.label }}",
                            "value": {{ field.value | default('""') }},
                            {% if field.placeholder %}"placeholder": "{{ field.placeholder }}",{% endif %}
                            {% if field.min is defined %}"min": {{ field.min }},{% endif %}
                            {% if field.max is defined %}"max": {{ field.max }},{% endif %}
                            {% if field.step is defined %}"step": {{ field.step }},{% endif %}
                            {% if field.required %}"required": true,{% endif %}
                            {% if field.description %}"description": "{{ field.description }}",{% endif %}
                            {% if field.options %}"options": {{ field.options | tojson }},{% endif %}
                            "labelWidth": 180,
                            "style": {
                                "minWidth": "250px"
                            }
                        }{% if not loop.last %},{% endif %}
                        {% endfor %}
                    ]
                }
            ],
            "actions": [
                {# 提交按钮 #}
                {
                    "type": "submit",
                    "label": "{{ submit_button_text | default('📊 应用并预测') }}",
                    "level": "danger",
                    "style": {
                        "background": "linear-gradient(180deg, #ff4d4f 0%, #cf1322 100%)",
                        "border": "none",
                        "boxShadow": "0 4px 10px rgba(207, 19, 34, 0.3)",
                        "fontWeight": "bold",
                        "padding": "10px 24px"
                    }
                }
                {% if enable_reset | default(true) %}
                ,{
                    "type": "reset",
                    "label": "{{ reset_button_text | default('🔄 重置') }}",
                    "level": "default",
                    "style": {
                        "marginLeft": "10px",
                        "padding": "10px 24px"
                    }
                }
                {% endif %}
            ]
        }
    ]
}
