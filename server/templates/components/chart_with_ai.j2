{# 通用图表组件 - 带 AI 分析面板 #}
{# 
  支持多种图表类型的统一组件
  
  Parameters:
  - chart_type: 图表类型 (pie/bar/line/funnel/radar/gauge) - 必需
  - title: 图表标题
  - api_url: 图表数据API地址 - 必需
  - height: 图表高度 (default: 400)
  - chart_options: 图表特定配置 (optional)
  - drilldown_api: 钻取详情API地址 (optional)
  - drilldown_params: 钻取API参数对象 (optional)
  - drilldown_columns: 钻取表格列定义 (optional)
  - export_api: 导出API地址 (optional)
  - ai_analysis_text: AI生成的风险分析 (optional)
  - ai_suggestions: AI生成的规避建议 (optional)
  - enable_drilldown: 是否启用钻取 (default: true)
#}
{% import 'macros/chart_adaptors.j2' as adaptors %}
{% set chart_opts = chart_options | default({}) %}
{
    "type": "grid",
    "columns": [
        {
            "md": 8,
            "body": {
                "type": "chart",
                "api": {
                    "url": "{{ api_url }}",
                    "method": "get",
                    "adaptor": "{% if chart_type == 'pie' %}{{ adaptors.get_pie_adaptor(chart_opts) }}{% elif chart_type == 'bar' %}{{ adaptors.get_bar_adaptor() }}{% elif chart_type == 'line' %}{{ adaptors.get_line_adaptor(chart_opts) }}{% elif chart_type == 'funnel' %}{{ adaptors.get_funnel_adaptor() }}{% elif chart_type == 'radar' %}{{ adaptors.get_radar_adaptor() }}{% elif chart_type == 'gauge' %}{{ adaptors.get_gauge_adaptor() }}{% else %}return payload;{% endif %}"
                },
                "height": {{ height | default(400) }},
                {% if enable_drilldown | default(true) %}
                "clickAction": {
                    "actionType": "dialog",
                    "dialog": {
                        "title": "{% if chart_type == 'pie' or chart_type == 'bar' or chart_type == 'funnel' %}${event.name} - 详细数据{% elif chart_type == 'line' %}${event.seriesName} - ${event.name}{% else %}详细数据{% endif %}",
                        "size": "xl",
                        {% if chart_type != 'radar' and chart_type != 'gauge' %}
                        "actions": [
                            {
                                "type": "button",
                                "label": "导出",
                                "level": "primary",
                                "actionType": "download",
                                "api": "{{ export_api | default('/api/export/data') }}?{% if chart_type == 'line' %}series=${event.seriesName}&date=${event.name}{% else %}category=${event.name}{% endif %}"
                            },
                            {
                                "type": "button",
                                "label": "关闭",
                                "actionType": "close"
                            }
                        ],
                        {% endif %}
                        "data": {
                            {% if chart_type == 'line' %}
                            "selectedSeries": "${event.seriesName}",
                            "selectedDate": "${event.name}",
                            "selectedValue": "${event.value}"
                            {% else %}
                            "selectedName": "${event.name}",
                            "selectedValue": "${event.value}"
                            {% endif %}
                        },
                        "body": {
                            "type": "service",
                            "api": {
                                "method": "get",
                                "url": "{{ drilldown_api | default('/api/demo/detail') }}",
                                "requestAdaptor": "{% if drilldown_params %}const params = {{ drilldown_params | tojson | replace('\"', '\\\"') }}; const queryStr = Object.entries(params).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&'); return { ...api, url: api.url + '?' + queryStr };{% else %}{% if chart_type == 'line' %}const series = api.data.selectedSeries || ''; const date = api.data.selectedDate || ''; return { ...api, url: api.url + '?series=' + encodeURIComponent(series) + '&date=' + encodeURIComponent(date) };{% else %}return { ...api, url: api.url + '?category=' + encodeURIComponent(api.data?.selectedName || '') };{% endif %}{% endif %}"
                            },
                            "body": {
                                "type": "{% if chart_type == 'line' %}table{% else %}crud{% endif %}",
                                {% if chart_type != 'line' %}"syncLocation": false,{% endif %}
                                "api": "${api}",
                                "columns": {% if drilldown_columns %}{{ drilldown_columns | tojson }}{% else %}[
                                    {"name": "id", "label": "ID", "width": 60},
                                    {% if chart_type == 'line' %}
                                    {"name": "date", "label": "日期", "type": "date"},
                                    {"name": "value", "label": "数值", "type": "number"},
                                    {"name": "trend", "label": "趋势"}
                                    {% elif chart_type == 'funnel' %}
                                    {"name": "user_name", "label": "用户"},
                                    {"name": "status", "label": "状态"}
                                    {% else %}
                                    {"name": "name", "label": "名称"},
                                    {"name": "value", "label": "数值", "type": "number"}
                                    {% endif %}
                                ]{% endif %}
                            }
                        }
                    }
                }
                {% endif %}
            }
        },
        {
            "md": 4,
            "body": {
                "type": "card",
                "header": {
                    "title": "🤖 AI 智能分析",
                    "subTitle": "基于数据的风险评估"
                },
                "body": [
                    {
                        "type": "alert",
                        "level": "info",
                        "showIcon": true,
                        "body": "<strong>📊 风险分析</strong><br/><br/>{{ ai_analysis_text | default('暂无AI分析数据。') | replace('\n', '<br/>') }}"
                    },
                    {
                        "type": "divider"
                    },
                    {
                        "type": "alert",
                        "level": "warning",
                        "showIcon": true,
                        "body": "<strong>💡 规避建议</strong><br/><br/>{{ ai_suggestions | default('暂无规避建议。') | replace('\n', '<br/>') }}"
                    }
                ]
            }
        }
    ]
}
