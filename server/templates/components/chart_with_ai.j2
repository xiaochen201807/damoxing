{# 通用图表组件 - 带 AI 分析面板 #}
{# 
  支持多种图表类型的统一组件
  
  Parameters:
  - chart_type: 图表类型 (pie/bar/line/funnel/radar/gauge) - 必需
  - title: 图表标题
  - api_url: 图表数据API地址 - 必需
  - api_method: 图表数据API请求方法 (default: 'get', optional: 'post')
  - api_data: API POST请求时的请求体参数 (optional, 对象)
  - height: 图表高度 (default: 400)
  - chart_options: 图表特定配置 (optional)
  - drilldown_api: 钻取详情API地址 (optional)
  - drilldown_method: 钻取API请求方法 (default: 'get', optional: 'post')
  - drilldown_data: 钻取API POST请求时的基础参数 (optional, 对象, 会自动合并 selectedId)
  - drilldown_params: 钻取API参数对象 (optional, 已废弃，建议用 drilldown_data)
  - drilldown_columns: 钻取表格列定义 (optional)
  - export_api: 导出API地址 (optional)
  - export_method: 导出API请求方法 (default: 'get', optional: 'post')
  - ai_analysis_text: AI生成的风险分析 (optional)
  - ai_suggestions: AI生成的规避建议 (optional)
  - enable_drilldown: 是否启用钻取 (default: true)
#}
{% import 'macros/chart_adaptors.j2' as adaptors %}
{% set chart_opts = chart_options | default({}) %}
{
    "type": "container",
    "body": [
        {% if title %}
        {
            "type": "tpl",
            "tpl": "<h3 style='margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #262626;'>{{ title }}</h3><div style='margin-bottom: 20px; border-bottom: 1px dashed #d9d9d9;'></div>"
        },
        {% endif %}
        {
    "type": "grid",
    "columns": [
        {
            "md": 8,
            "body": {
                "type": "chart",
                "api": {
                    "url": "{{ api_url }}",
                    "method": "{{ api_method | default('get') | lower }}",
                    {% if api_data %}
                    "data": {{ api_data | tojson }},
                    {% endif %}
                    "adaptor": "{% if chart_type == 'pie' %}{{ adaptors.get_pie_adaptor(chart_opts) }}{% elif chart_type == 'bar' %}{{ adaptors.get_bar_adaptor() }}{% elif chart_type == 'line' %}{{ adaptors.get_line_adaptor(chart_opts) }}{% elif chart_type == 'funnel' %}{{ adaptors.get_funnel_adaptor() }}{% elif chart_type == 'radar' %}{{ adaptors.get_radar_adaptor() }}{% elif chart_type == 'gauge' %}{{ adaptors.get_gauge_adaptor() }}{% else %}return payload;{% endif %}"
                },
                "height": {{ height | default(400) }}{% if enable_drilldown | default(true) %},
                "clickAction": {
                    "actionType": "dialog",
                    "dialog": {
                        "title": "{% if chart_type == 'pie' %}${selectedName} - 详细数据{% elif chart_type == 'bar' %}${selectedMonth} - 详细数据{% elif chart_type == 'funnel' %}${selectedName} - 详细数据{% elif chart_type == 'line' %}${selectedSeries} - ${selectedDate}{% else %}详细数据{% endif %}",
                        "size": "xl",
                        {% if chart_type != 'radar' and chart_type != 'gauge' %}
                        "actions": [
                            {
                                "type": "button",
                                "label": "导出",
                                "level": "primary",
                                "actionType": "download",
                                "api": "{{ export_api | default('/api/export/data') }}?{% if chart_type == 'line' %}series=${selectedSeries}&date=${selectedDate}{% elif chart_type == 'bar' %}month=${selectedMonth}{% else %}category=${selectedName}{% endif %}"
                            },
                            {
                                "type": "button",
                                "label": "关闭",
                                "actionType": "close"
                            }
                        ],
                        {% endif %}
                        "data": {
                            {% if chart_type == 'line' %}
                            "selectedSeries": "${data.seriesName}",
                            "selectedDate": "${data.name}",
                            "selectedValue": "${data.value}"
                            {% elif chart_type == 'bar' %}
                            "selectedId": "${data.itemId}",
                            "selectedMonth": "${data.itemId}",
                            "selectedName": "${data.name}",
                            "selectedValue": "${data.value}"
                            {% else %}
                            "selectedId": "${data.itemId}",
                            "selectedName": "${data.name}",
                            "selectedValue": "${data.value}"
                            {% endif %}
                        },
                        "body": {
                            "type": "{% if chart_type == 'line' %}service{% else %}crud{% endif %}",
                            {% if chart_type == 'line' %}
                            "api": {
                                "method": "{{ drilldown_method | default('get') | lower }}",
                                "url": "{{ drilldown_api | default('/api/demo/risk-list') }}",
                                "data": {
                                    "&": "$$"
                                },
                                "requestAdaptor": "const method = '{{ drilldown_method | default('get') | lower }}'; const selectedId = context?.selectedId || ''; if (!selectedId) { return api; } if (method === 'get') { const fullUrl = ('{{ drilldown_api | default('/api/demo/risk-list') }}' + '/' + selectedId).replace(/\\/\\//g, '/'); return {...api, url: fullUrl}; } else { const baseData = {% if drilldown_data %}{{ drilldown_data | tojson | replace('"', "'") }}{% else %}{}{% endif %}; return {...api, data: {...baseData, selectedId}}; }"
                            },
                            "body": {
                                "type": "table",
                                "columns": {% if drilldown_columns %}{{ drilldown_columns | tojson }}{% else %}[
                                    {"name": "id", "label": "ID", "width": 60},
                                    {"name": "date", "label": "日期", "type": "date"},
                                    {"name": "value", "label": "数值", "type": "number"},
                                    {"name": "trend", "label": "趋势"}
                                ]{% endif %}
                            }
                            {% else %}
                            "syncLocation": false,
                            "api": {
                                "method": "{{ drilldown_method | default('get') | lower }}",
                                "url": "{{ drilldown_api | default('/api/demo/risk-list') }}",
                                "data": {
                                    "&": "$$"
                                },
                                "requestAdaptor": "const method = '{{ drilldown_method | default('get') | lower }}'; const selectedId = context?.selectedId || ''; if (!selectedId) { return api; } if (method === 'get') { const fullUrl = ('{{ drilldown_api | default('/api/demo/risk-list') }}' + '/' + selectedId).replace(/\\/\\//g, '/'); return {...api, url: fullUrl}; } else { const baseData = {% if drilldown_data %}{{ drilldown_data | tojson | replace('"', "'") }}{% else %}{}{% endif %}; return {...api, data: {...baseData, selectedId}}; }"
                            },
                            "perPageAvailable": [10, 20, 50],
                            "perPage": 10,
                            "perPage": 10,
                            "footerToolbar": {% if drilldown_pagination | default(true) %}["statistics", "switch-per-page", "pagination"]{% else %}["statistics"]{% endif %},
                            {% if primary_field %}"primaryField": "{{ primary_field }}",{% endif %}
                            {% if label_tpl %}"labelTpl": "{{ label_tpl }}",{% endif %}
                            {% if drilldown_batch %}
                            "keepItemSelectionOnPageChange": true,
                            "bulkActions": {% if drilldown_batch_actions or drilldownBatchActions %}{{ (drilldown_batch_actions or drilldownBatchActions) | tojson }}{% else %}[
                                {
                                    "label": "批量处理",
                                    "actionType": "button",
                                    "level": "primary",
                                    "onClick": "if (this.selectedItems && this.selectedItems.length > 0) { alert('批量处理选中项ID：' + this.selectedItems.map(item => item.id).join(', ')); } else { alert('请先选择数据'); }"
                                }
                            ]{% endif %},
                            {% endif %}
                            {% set default_cols = [] %}
                            {% if chart_type == 'funnel' %}
                                {% set default_cols = [
                                    {"name": "id", "label": "ID", "width": 60},
                                    {"name": "user_name", "label": "用户"},
                                    {"name": "status", "label": "状态"}
                                ] %}
                            {% else %}
                                {% set default_cols = [
                                    {"name": "id", "label": "ID", "width": 60},
                                    {"name": "customer_name", "label": "客户名称"},
                                    {"name": "risk_score", "label": "风险评分", "type": "number"},
                                    {"name": "status", "label": "状态"},
                                    {"name": "amount", "label": "金额", "type": "number"},
                                    {"name": "overdue_days", "label": "逾期天数"}
                                ] %}
                            {% endif %}
                            
                            {% set final_cols = drilldown_columns | default(default_cols) %}
                            
                            "columns": [
                                {% if drilldown_sequence %}
                                {"name": "__index", "label": "序号", "type": "tpl", "tpl": "${index + 1}", "width": 50 }
                                {% if final_cols | length > 0 %},{% endif %}
                                {% endif %}
                                {% for col in final_cols %}
                                    {{ col | tojson }}{% if not loop.last %},{% endif %}
                                {% endfor %}
                                {% if drilldown_actions %}
                                ,{
                                    "type": "operation",
                                    "label": "操作",
                                    "width": {{ drilldown_actions_width | default(100) }},
                                    "buttons": {{ drilldown_actions | tojson }}
                                }
                                {% endif %}
                            ]
                            {% endif %}
                        }
                    }
                }
                {% endif %}
            }
        },
        {
            "md": 4,
            "style": {
                "borderLeft": "1px dashed #e8e8e8",
                "paddingLeft": "40px",
                "height": "80%",
                "margin": "auto 0",
                "display": "flex",
                "flexDirection": "column",
                "justifyContent": "center"
            },
            "body": [
                {
                    "type": "tpl",
                    "tpl": "<div style='margin-bottom: 5px;'><span style='background: #0050b3; color: #fff; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: bold;'>风险分析</span></div><div style='margin-bottom: 25px; font-size: 14px; line-height: 1.6; color: #666;'>{{ ai_analysis_text | default('暂无AI分析数据。') | replace('\n', '<br/>') }}</div>"
                },
                {
                    "type": "tpl",
                    "tpl": "<div style='margin-bottom: 5px;'><span style='background: #006d75; color: #fff; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: bold;'>规避建议</span></div><div style='font-size: 14px; line-height: 1.6; color: #666;'>{{ ai_suggestions | default('暂无规避建议。') | replace('\n', '<br/>') }}</div>"
                }

            ]
        }
    ]
}
    ]
}
