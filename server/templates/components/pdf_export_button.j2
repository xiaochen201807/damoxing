{# PDF Export Button Component (Fixed Text Clipping) #}
{# 
  组件参数说明:
  @param pdf_button_label 按钮文字（默认：导出为 PDF）
  @param pdf_button_level 按钮样式级别（default/primary/danger）
  @param pdf_filename 导出文件名前缀（默认：页面导出）
  @param pdf_target_selector 截图目标选择器（默认：.cxd-Page-body）
  @param pdf_button_position 按钮位置：center/left/right（默认：center）
  @param pdf_margin 页面边距 mm（默认：10）
  
  修复：
  - 增加额外宽度确保右侧文字不被截断
  - 智能选择方向 + 自动分页
#}
{% import 'base/colors.j2' as theme %}

{# 计算对齐方式 #}
{% set align_map = {
    'left': 'flex-start',
    'center': 'center', 
    'right': 'flex-end'
} %}
{% set justify = align_map[pdf_button_position | default('center')] %}

{
    "type": "flex",
    "id": "pdf_export_container",
    "className": "pdf-export-container",
    "justify": "{{ justify }}",
    "alignItems": "center",
    "style": {
        "padding": "24px 0",
        "borderTop": "1px solid {{ theme.colors.divider | default('#f0f0f0') }}",
        "marginTop": "24px"
    },
    "items": [
        {
            "type": "button",
            "id": "pdf_export_btn",
            "label": "📥 {{ pdf_button_label | default('导出为 PDF') }}",
            "level": "{{ pdf_button_level | default('primary') }}",
            "onEvent": {
                "click": {
                    "actions": [{
                        "actionType": "custom",
                        "script": "(function() { const btn = event.context.nativeEvent.target.closest('button'); const originalText = btn.textContent; btn.disabled = true; btn.textContent = '正在生成...'; const loadScript = (src) => new Promise((resolve, reject) => { if (document.querySelector(`script[src='${src}']`)) return resolve(); const script = document.createElement('script'); script.src = src; script.onload = resolve; script.onerror = reject; document.head.appendChild(script); }); Promise.all([ loadScript('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js'), loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js') ]).then(() => { const { jsPDF } = window.jspdf; const targetSelector = '{{ pdf_target_selector | default('.cxd-Page-body') }}'; const targetElement = document.querySelector(targetSelector) || document.body; if (!targetElement) { alert('未找到导出内容'); btn.disabled = false; btn.textContent = originalText; return; } const exportContainer = btn.closest('.pdf-export-container'); if (exportContainer) { exportContainer.style.visibility = 'hidden'; exportContainer.style.height = '0'; exportContainer.style.padding = '0'; exportContainer.style.margin = '0'; exportContainer.style.overflow = 'hidden'; } const scrollTop = window.scrollY; const scrollLeft = window.scrollX; window.scrollTo(0, 0); const rect = targetElement.getBoundingClientRect(); const actualWidth = Math.max(targetElement.scrollWidth, targetElement.offsetWidth, rect.width, document.documentElement.clientWidth); const actualHeight = Math.max(targetElement.scrollHeight, targetElement.offsetHeight, rect.height); setTimeout(() => { html2canvas(targetElement, { scale: 1.5, useCORS: true, logging: false, backgroundColor: '#ffffff', scrollX: 0, scrollY: 0, x: 0, y: 0, width: actualWidth, height: actualHeight, windowWidth: actualWidth + 100, windowHeight: actualHeight }).then(canvas => { if (exportContainer) { exportContainer.style.visibility = ''; exportContainer.style.height = ''; exportContainer.style.padding = ''; exportContainer.style.margin = ''; exportContainer.style.overflow = ''; } window.scrollTo(scrollLeft, scrollTop); const imgW = canvas.width; const imgH = canvas.height; const margin = {{ pdf_margin | default(10) }}; const a4Portrait = { w: 210, h: 297, cw: 210 - margin * 2, ch: 297 - margin * 2 }; const a4Landscape = { w: 297, h: 210, cw: 297 - margin * 2, ch: 210 - margin * 2 }; const imgRatio = imgW / imgH; const portraitRatio = a4Portrait.cw / a4Portrait.ch; const isLandscape = imgRatio > portraitRatio * 1.1; const page = isLandscape ? a4Landscape : a4Portrait; const orientation = isLandscape ? 'landscape' : 'portrait'; const scaleToFit = page.cw / imgW; const scaledH = imgH * scaleToFit; const needsPaging = scaledH > page.ch; const pdf = new jsPDF({ orientation: orientation, unit: 'mm', format: 'a4' }); if (!needsPaging) { const imgData = canvas.toDataURL('image/jpeg', 0.85); pdf.addImage(imgData, 'JPEG', margin, margin, page.cw, scaledH); } else { const pxPerMm = imgW / page.cw; const pageHeightPx = page.ch * pxPerMm; const totalPages = Math.ceil(imgH / pageHeightPx); for (let i = 0; i < totalPages; i++) { if (i > 0) pdf.addPage(); const srcY = i * pageHeightPx; const srcH = Math.min(pageHeightPx, imgH - srcY); const destH = srcH / pxPerMm; const pageCanvas = document.createElement('canvas'); pageCanvas.width = imgW; pageCanvas.height = srcH; const ctx = pageCanvas.getContext('2d'); ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, pageCanvas.width, pageCanvas.height); ctx.drawImage(canvas, 0, srcY, imgW, srcH, 0, 0, imgW, srcH); const pageImg = pageCanvas.toDataURL('image/jpeg', 0.85); pdf.addImage(pageImg, 'JPEG', margin, margin, page.cw, destH); } } pdf.save('{{ pdf_filename | default('页面导出') }}_' + new Date().toISOString().split('T')[0] + '.pdf'); btn.disabled = false; btn.textContent = originalText; }).catch(err => { if (exportContainer) { exportContainer.style.visibility = ''; exportContainer.style.height = ''; exportContainer.style.padding = ''; exportContainer.style.margin = ''; exportContainer.style.overflow = ''; } window.scrollTo(scrollLeft, scrollTop); console.error('PDF error:', err); alert('PDF生成失败: ' + err.message); btn.disabled = false; btn.textContent = originalText; }); }, 300); }).catch(err => { console.error('Load script error:', err); alert('加载PDF库失败，请检查网络'); btn.disabled = false; btn.textContent = originalText; }); })();"
                    }]
                }
            }
        }
    ]
}
