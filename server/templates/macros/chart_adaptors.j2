{# 图表适配器宏 - 所有adaptor必须是单行以避免JSON控制字符问题 #}
{% macro get_pie_adaptor(chart_opts) %}const option = payload.data || {}; if (option.series && option.series[0]) { option.series[0].radius = {{ chart_opts.radius | default("['50%', '70%']") }}; option.series[0].emphasis = { scale: true, scaleSize: 10 }; option.series[0].itemStyle = { borderRadius: 8, borderColor: '#fff', borderWidth: 2 }; } option.legend = { orient: 'horizontal', bottom: '0', left: 'center', icon: 'circle' }; option.tooltip = { trigger: 'item', formatter: '{b}: {c} ({d}%)' }; return { ...payload, data: option };{% endmacro %}
{% macro get_bar_adaptor() %}const option = payload.data || {}; if (option.series && option.series[0]) { option.series[0].type = 'bar'; option.series[0].itemStyle = { borderRadius: [4, 4, 0, 0] }; } option.grid = { left: '3%', right: '4%', bottom: '10%', top: '10%', containLabel: true }; option.tooltip = { trigger: 'axis', axisPointer: { type: 'shadow' } }; return { ...payload, data: option };{% endmacro %}
{% macro get_line_adaptor(chart_opts) %}const option = payload.data || {}; if (option.series) { option.series.forEach(s => { s.smooth = {{ chart_opts.smooth | default('true') }}; {% if chart_opts.show_area %}s.areaStyle = { opacity: 0.3 };{% endif %} s.emphasis = { focus: 'series' }; }); } option.grid = { left: '3%', right: '4%', bottom: '10%', containLabel: true }; option.tooltip = { trigger: 'axis', axisPointer: { type: 'cross' } }; option.legend = { bottom: '0', left: 'center' }; return { ...payload, data: option };{% endmacro %}
{% macro get_funnel_adaptor() %}const option = payload.data || {}; if (option.series && option.series[0]) { option.series[0].type = 'funnel'; option.series[0].left = 'center'; option.series[0].width = '80%'; option.series[0].label = { show: true, position: 'inside' }; } option.tooltip = { trigger: 'item', formatter: '{b}<br/>数量: {c}<br/>占比: {d}%' }; return { ...payload, data: option };{% endmacro %}
{% macro get_radar_adaptor() %}const option = payload.data || {}; if (option.series) { option.series.forEach(s => { s.type = 'radar'; s.areaStyle = { opacity: 0.3 }; }); } option.tooltip = { trigger: 'item' }; option.legend = { bottom: 0 }; return { ...payload, data: option };{% endmacro %}
{% macro get_gauge_adaptor() %}const option = payload.data || {}; if (option.series && option.series[0]) { option.series[0].type = 'gauge'; option.series[0].radius = '80%'; } return { ...payload, data: option };{% endmacro %}
