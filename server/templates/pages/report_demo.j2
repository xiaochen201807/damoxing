{% import 'base/colors.j2' as theme %}
{
    "type": "page",
    "id": "global_page_root",
    "title": "贷款风险分析",
    
    {# 初始化全局变量 #}
    "data": {
        "show_report_result": false,
        "report_loading": false
    },
    
    "body": [
        {# 1. 页面头部 - 包含报告生成按钮 #}
        {% include 'components/header.j2' 
           with title='贷款风险智能分析平台',
                subtitle='基于 AI 的实时风险监控与报告生成',
                page_key='loan_risk',
                enable_report_button=true,
                report_button_label='生成风险分析报告',
                report_workflow_type='report_generation',
                report_query='请生成详细的贷款风险分析报告，包括风险等级、风险分布、重点关注领域和处置建议'
        %},
        
        {# 2. 页面主体内容 #}
        {
            "type": "container",
            "style": {
                "padding": "20px"
            },
            "body": [
                {
                    "type": "alert",
                    "level": "info",
                    "body": "💡 点击右上角\"生成风险分析报告\"按钮，AI 将自动生成专业的风险分析报告",
                    "showIcon": true
                },
                {
                    "type": "divider"
                },
                {
                    "type": "container",
                    "body": [
                        {
                            "type": "tpl",
                            "tpl": "<h3>主要功能</h3><ul><li>📊 实时风险数据分析</li><li>🤖 AI 智能报告生成</li><li>🖨️ 一键打印报告</li><li>📄 专业公文格式</li></ul>"
                        }
                    ]
                }
            ]
        },
        
        {# 3. 报告显示组件（必须包含）#}
        {% include 'components/report_display.j2' 
           with page_key='loan_risk',
                report_workflow_type='report_generation',
                report_query='请生成详细的贷款风险分析报告'
        %}
    ]
}
