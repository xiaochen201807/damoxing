{
    "type": "page",
    "title": "业务办理标准库",
    "data": {
        "algorithm_options": [
            { "label": "最大可提取额", "value": "1" },
            { "label": "最高可贷金额", "value": "2" },
            { "label": "最高可贷年限", "value": "3" },
            { "label": "借款人最大可对冲支取金额", "value": "4" }
        ],
        "standard_class_options": [
            { "label": "缴存人账户余额", "value": "1" },
            { "label": "冻结金额", "value": "2" },
            { "label": "账户保留金额", "value": "3" },
            { "label": "材料提取限额", "value": "4" },
            { "label": "累计提取金额", "value": "5" },
            { "label": "精度值", "value": "6" },
            { "label": "保留方式", "value": "7" },
            { "label": "在途提取金额", "value": "8" }
        ],
        "business_content_class_api": "{{ business_content_class_api | default(GLOBAL_API_PREFIX + '/tools/business-content-classes') }}",
        "business_content_class_params": {{ business_content_class_params | default({}) | fromjson | tojson }},
        "business_standard_value_api": "{{ business_standard_value_api | default(GLOBAL_API_PREFIX + '/tools/business-standard-values') }}",
        "business_standard_value_params": {{ business_standard_value_params | default({}) | fromjson | tojson }},
        "service_objects_api": "{{ service_objects_api | default(GLOBAL_API_PREFIX + '/tools/service-objects') }}",
        "service_objects_params": {{ service_objects_params | default({}) | fromjson | tojson }},
        "business_standard_attribute_api": "{{ business_standard_attribute_api | default(GLOBAL_API_PREFIX + '/tools/business-standard-attributes') }}",
        "business_standard_attribute_params": {{ business_standard_attribute_params | default({}) | fromjson | tojson }},
        "standard_import_api": "{{ standard_import_api | default(GLOBAL_API_PREFIX + '/ywbzk/import') }}",
        "standard_export_api": "{{ standard_export_api | default(GLOBAL_API_PREFIX + '/ywbzk/export') }}"
    },
    "body": [
        {
            "type": "service",
            "api": {
                "method": "post",
                "url": "${business_content_class_api}",
                "data": "${business_content_class_params}",
                "adaptor": "var data = payload.data || payload.options || payload; var list = []; if (Array.isArray(data)) { list = data; } else if (data && Array.isArray(data.options)) { list = data.options; } else if (data && Array.isArray(data.rows)) { list = data.rows; } return { class_options: list };"
            },
            "body": [
                {
                    "type": "crud",
            "columnsTogglable": false,
            "api": "post:{{ GLOBAL_API_PREFIX }}/ywbzk/list",
            "filter": {
                "title": "",
                "submitText": "",
                "type": "form",
                "mode": "inline",
                "wrapWithPanel": false,
                "body": [
                    {
                        "type": "select",
                        "name": "gjsjsf",
                        "label": "关键数据算法",
                        "placeholder": "请选择关键数据算法",
                        "clearable": true,
                        "source": "${algorithm_options}"
                    },
                    {
                        "type": "select",
                        "name": "ywnrfl",
                        "label": "业务内容分类",
                        "placeholder": "请选择业务内容分类",
                        "clearable": true,
                        "source": {
                            "method": "post",
                            "url": "${business_content_class_api}",
                            "data": "${business_content_class_params}"
                        }
                    },
                    {
                        "type": "select",
                        "name": "ywblbz",
                        "label": "业务办理标准",
                        "placeholder": "请选择业务办理标准",
                        "searchable": true,
                        "clearable": true,
                        "source": {
                            "method": "post",
                            "url": "{{ GLOBAL_API_PREFIX | default('/api') }}/ywbzk/standards"
                        }
                    },
                    {
                        "type": "submit",
                        "label": "查询",
                        "level": "primary"
                    },
                    {
                        "type": "reset",
                        "label": "重置"
                    },
                    {
                        "type": "button",
                        "label": "增加",
                        "actionType": "dialog",
                        "level": "success",
                        "dialog": {
                            "title": "新增业务标准模板",
                            "size": "lg",
                            "body": {
                                "type": "form",
                                "mode": "normal",
                                "api": "post:{{ GLOBAL_API_PREFIX }}/ywbzk/save",
                                "body": [
                                    {
                                        "type": "input-number",
                                        "name": "pxh",
                                        "label": "排序号",
                                        "value": 0
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "ywblbz",
                                        "label": "业务办理标准",
                                        "required": true,
                                        "placeholder": "请输入业务办理标准"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "ywblbzsm",
                                        "label": "业务办理标准说明",
                                        "placeholder": "请输入业务办理标准说明"
                                    },
                                    {
                                        "type": "select",
                                        "name": "gjsjsf",
                                        "label": "关键数据算法",
                                        "source": "${algorithm_options}"
                                    },
                                    {
                                        "type": "select",
                                        "name": "ywnrfl",
                                        "label": "业务内容分类",
                                        "placeholder": "请选择业务内容分类",
                                        "clearable": true,
                                        "source": {
                                            "method": "post",
                                            "url": "${business_content_class_api}",
                                            "data": "${business_content_class_params}"
                                        }
                                    },
                                    {
                                        "type": "select",
                                        "name": "bzfl",
                                        "label": "标准分类",
                                        "source": "${standard_class_options}"
                                    },
                                    {
                                        "type": "select",
                                        "name": "ywbzz",
                                        "label": "业务标准值",
                                        "clearable": true,
                                        "searchable": true,
                                        "placeholder": "请选择业务标准值",
                                        "source": {
                                            "method": "post",
                                            "url": "${business_standard_value_api}",
                                            "data": {
                                                "&": "${business_standard_value_params}",
                                                "name": "${term}"
                                            }
                                        }
                                    },
                                    {
                                        "type": "textarea",
                                        "name": "ywbzjg",
                                        "label": "业务标准结果SQL",
                                        "placeholder": "请输入 SQL"
                                    },
                                    {
                                        "type": "combo",
                                        "name": "ywblbzsxz",
                                        "label": "业务办理标准属性组",
                                        "multiple": true,
                                        "multiLine": true,
                                        "addable": true,
                                        "removable": true,
                                        "items": [
                                            {
                                                "type": "select",
                                                "name": "ywblbzdx",
                                                "label": "业务办理标准对象",
                                                "required": true,
                                                "source": {
                                                    "method": "post",
                                                    "url": "${service_objects_api}",
                                                    "data": "${service_objects_params}"
                                                },
                                                "autoFill": {
                                                    "fwdxbq": "${label}",
                                                    "_syObjectNumber": "${syObjectNumber}",
                                                    "_coding": "${coding}",
                                                    "_id": "${id}"
                                                }
                                            },
                                            {
                                                "type": "hidden",
                                                "name": "fwdxbq"
                                            },
                                            { "type": "hidden", "name": "_syObjectNumber" },
                                            { "type": "hidden", "name": "_coding" },
                                            { "type": "hidden", "name": "_id" },
                                            {
                                                "type": "hidden",
                                                "name": "sxbm"
                                            },
                                            {
                                                "type": "select",
                                                "name": "ywblbzsx",
                                                "autoFill": {
                                                    "sxbm": "${sxbm}"
                                                },
                                                "label": "业务办理标准属性",
                                                "placeholder": "请选择属性",
                                                "clearValueOnOptionsChange": true,
                                                "source": {
                                                    "method": "post",
                                                    "url": "${business_standard_attribute_api}",
                                                    "data": {
                                                        "&": "${business_standard_attribute_params}",
                                                        "syObjectNumber": "${_syObjectNumber || _coding || _id}"
                                                    },
                                                    "trackExpression": "${ywblbzdx}"
                                                }
                                            },
                                            {
                                                "type": "radios",
                                                "name": "sxly",
                                                "label": "属性来源",
                                                "inline": true,
                                                "options": [
                                                    {
                                                        "label": "页面",
                                                        "value": "page"
                                                    },
                                                    {
                                                        "label": "SQL",
                                                        "value": "sql"
                                                    }
                                                ],
                                                "value": "page"
                                            },
                                            {
                                                "type": "textarea",
                                                "name": "ywblbzyg",
                                                "label": "业务办理标准语句",
                                                "visibleOn": "${sxly === 'sql'}"
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "button",
                        "label": "全量导入",
                        "level": "primary",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "全量导入业务标准",
                            "body": {
                                "type": "form",
                                "api": {
                                    "method": "post",
                                    "url": "${standard_import_api}",
                                    "dataType": "form-data"
                                },
                                "body": [
                                    {
                                        "type": "input-file",
                                        "name": "file",
                                        "label": "选择CSV或SQL文件",
                                        "accept": ".csv,.sql",
                                        "asBlob": true,
                                        "required": true
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "button",
                        "label": "全量导出",
                        "level": "default",
                        "actionType": "download",
                        "api": {
                            "method": "post",
                            "url": "${standard_export_api}",
                            "responseType": "blob"
                        }
                    }
                ]
            },
            "headerToolbar": [],
            "columns": [
                {
                    "name": "pxh",
                    "label": "序号",
                    "width": 60
                },
                {
                    "name": "ywblbz",
                    "label": "业务办理标准",
                    "width": 350
                },
                {
                    "name": "ywblbzsm",
                    "label": "业务办理标准说明",
                    "width": 300
                },
                {
                    "name": "gjsjsf",
                    "label": "关键数据算法",
                    "width": 150,
                    "type": "mapping",
                    "map": {
                        "1": "<span class='label label-info'>最大可提取额</span>",
                        "2": "<span class='label label-success'>最高可贷金额</span>",
                        "3": "<span class='label label-warning'>最高可贷年限</span>",
                        "4": "<span class='label label-danger'>借款人最大可对冲支取金额</span>"
                    }
                },
                {
                    "name": "ywnrfl",
                    "label": "业务内容分类",
                    "width": 150,
                    "type": "mapping",
                    "source": "${class_options}"
                },
                {
                    "type": "operation",
                    "label": "操作",
                    "buttons": [
                        {
                            "type": "button",
                            "label": "编辑",
                            "level": "link",
                            "actionType": "dialog",
                            "dialog": {
                                "title": "编辑业务标准模板",
                                "size": "lg",
                                "body": {
                                    "type": "form",
                                    "mode": "normal",
                                    "initApi": {
                                        "method": "post",
                                        "url": "{{ GLOBAL_API_PREFIX }}/ywbzk/get",
                                        "data": {
                                            "id": "${id}"
                                        }
                                    },
                                    "api": "post:{{ GLOBAL_API_PREFIX }}/ywbzk/save",
                                    "body": [
                                        {
                                            "type": "input-number",
                                            "name": "pxh",
                                            "label": "排序号",
                                            "value": 0
                                        },
                                        {
                                            "type": "input-text",
                                            "name": "ywblbz",
                                            "label": "业务办理标准",
                                            "required": true,
                                            "placeholder": "请输入业务办理标准"
                                        },
                                        {
                                            "type": "input-text",
                                            "name": "ywblbzsm",
                                            "label": "业务办理标准说明",
                                            "placeholder": "请输入业务办理标准说明"
                                        },
                                        {
                                            "type": "select",
                                            "name": "gjsjsf",
                                            "label": "关键数据算法",
                                            "source": "${algorithm_options}"
                                        },
                                        {
                                            "type": "select",
                                            "name": "ywnrfl",
                                            "label": "业务内容分类",
                                            "placeholder": "请选择业务内容分类",
                                            "clearable": true,
                                            "source": {
                                                "method": "post",
                                                "url": "${business_content_class_api}",
                                                "data": "${business_content_class_params}"
                                            }
                                        },
                                        {
                                            "type": "select",
                                            "name": "bzfl",
                                            "label": "标准分类",
                                            "source": "${standard_class_options}"
                                        },
                                        {
                                            "type": "select",
                                        "name": "ywbzz",
                                        "label": "业务标准值",
                                        "clearable": true,
                                        "searchable": true,
                                        "placeholder": "请选择业务标准值",
                                        "source": {
                                            "method": "post",
                                            "url": "${business_standard_value_api}",
                                            "data": {
                                                "&": "${business_standard_value_params}",
                                                "name": "${term}"
                                            }
                                        }
                                        },
                                        {
                                            "type": "textarea",
                                            "name": "ywbzjg",
                                            "label": "业务标准结果SQL",
                                            "placeholder": "请输入 SQL"
                                        },
                                        {
                                            "type": "combo",
                                            "name": "ywblbzsxz",
                                            "label": "业务办理标准属性组",
                                            "multiple": true,
                                            "multiLine": true,
                                            "addable": true,
                                            "removable": true,
                                            "items": [
                                                {
                                                    "type": "select",
                                                    "name": "ywblbzdx",
                                                    "label": "业务办理标准对象",
                                                    "required": true,
                                                    "source": {
                                                        "method": "post",
                                                        "url": "${service_objects_api}",
                                                        "data": "${service_objects_params}"
                                                    },
                                                    "autoFill": {
                                                        "fwdxbq": "${label}",
                                                        "_syObjectNumber": "${syObjectNumber}",
                                                        "_coding": "${coding}",
                                                        "_id": "${id}"
                                                    }
                                                },
                                                {
                                                    "type": "hidden",
                                                    "name": "fwdxbq"
                                                },
                                                { "type": "hidden", "name": "_syObjectNumber" },
                                                { "type": "hidden", "name": "_coding" },
                                                { "type": "hidden", "name": "_id" },
                                                {
                                                    "type": "hidden",
                                                    "name": "sxbm"
                                                },
                                                {
                                                    "type": "select",
                                                    "name": "ywblbzsx",
                                                    "autoFill": {
                                                        "sxbm": "${sxbm}"
                                                    },
                                                    "label": "业务办理标准属性",
                                                    "placeholder": "请选择属性",
                                                    "clearValueOnOptionsChange": true,
                                                    "source": {
                                                        "method": "post",
                                                        "url": "${business_standard_attribute_api}",
                                                        "data": {
                                                            "&": "${business_standard_attribute_params}",
                                                            "syObjectNumber": "${_syObjectNumber || _coding || _id}"
                                                        },
                                                        "trackExpression": "${ywblbzdx}"
                                                    }
                                                },
                                                {
                                                    "type": "radios",
                                                    "name": "sxly",
                                                    "label": "属性来源",
                                                    "inline": true,
                                                    "options": [
                                                        {
                                                            "label": "页面",
                                                            "value": "page"
                                                        },
                                                        {
                                                            "label": "SQL",
                                                            "value": "sql"
                                                        }
                                                    ],
                                                    "value": "page"
                                                },
                                                {
                                                    "type": "textarea",
                                                    "name": "ywblbzyg",
                                                    "label": "业务办理标准语句",
                                                    "visibleOn": "${sxly === 'sql'}"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "type": "button",
                            "label": "删除",
                            "level": "link",
                            "className": "text-danger",
                            "actionType": "ajax",
                            "confirmText": "确认要删除此模板吗?",
                            "api": "post:{{ GLOBAL_API_PREFIX }}/ywbzk/delete"
                        }
                    ]
                }
            ]
                }
            ]
        }
    ]
}