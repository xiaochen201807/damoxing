{
    "type": "page",
    "title": "业务办理标准库",
    "data": {
        "algorithm_options_api": "{{ GLOBAL_API_PREFIX }}/tools/business-algorithms",
        "algorithm_options": [],
        "standard_class_options": [
            { "label": "缴存人账户余额", "value": "1" },
            { "label": "冻结金额", "value": "2" },
            { "label": "账户保留金额", "value": "3" },
            { "label": "材料提取限额", "value": "4" },
            { "label": "累计提取金额", "value": "5" },
            { "label": "精度值", "value": "6" },
            { "label": "保留方式", "value": "7" },
            { "label": "在途提取金额", "value": "8" }
        ],
        "handle_class_options": [
            { "label": "标准", "value": "1" },
            { "label": "条件", "value": "2" },
            { "label": "风险", "value": "3" }
        ],
        "business_content_class_api": "{{ business_content_class_api | default(GLOBAL_API_PREFIX + '/tools/business-content-classes') }}",
        "business_content_class_params": {{ business_content_class_params | default({}) | fromjson | tojson }},
        "business_content_class_manage_list_api": "{{ GLOBAL_API_PREFIX }}/ywnrfl/list",
        "business_content_class_manage_save_api": "{{ GLOBAL_API_PREFIX }}/ywnrfl/save",
        "business_content_class_manage_delete_api": "{{ GLOBAL_API_PREFIX }}/ywnrfl/delete",
        "business_standard_value_api": "{{ business_standard_value_api | default(GLOBAL_API_PREFIX + '/tools/business-standard-values') }}",
        "business_standard_value_params": {{ business_standard_value_params | default({}) | fromjson | tojson }},
        "service_objects_api": "{{ service_objects_api | default(GLOBAL_API_PREFIX + '/tools/service-objects') }}",
        "service_objects_params": {{ service_objects_params | default({}) | fromjson | tojson }},
        "business_standard_attribute_api": "{{ business_standard_attribute_api | default(GLOBAL_API_PREFIX + '/tools/business-standard-attributes') }}",
        "business_standard_attribute_params": {{ business_standard_attribute_params | default({}) | fromjson | tojson }},
        "mutual_standard_api": "{{ GLOBAL_API_PREFIX }}/ywbzk/mutual-options",
        "standard_import_api": "{{ standard_import_api | default(GLOBAL_API_PREFIX + '/ywbzk/import') }}",
        "standard_export_api": "{{ standard_export_api | default(GLOBAL_API_PREFIX + '/ywbzk/export') }}",
        "standard_export_history_api": "{{ GLOBAL_API_PREFIX }}/ywbzk/export_history",
        "standard_export_history_download_api": "{{ GLOBAL_API_PREFIX }}/ywbzk/export_history",
        "mode_api": "{{ GLOBAL_API_PREFIX }}/ywbzk/mode",
        "business_standard_editable": false
    },
    "initApi": {
        "method": "post",
        "url": "${mode_api}"
    },
    "body": [
        {
            "type": "service",
            "api": {
                "method": "get",
                "url": "${algorithm_options_api}",
                "adaptor": "var data = payload.data || payload.options || payload; var list = []; if (Array.isArray(data)) { list = data; } else if (data && Array.isArray(data.options)) { list = data.options; } else if (data && Array.isArray(data.rows)) { list = data.rows; } return { algorithm_options: list };"
            },
            "body": [
                {
                    "type": "service",
                    "api": {
                        "method": "post",
                        "url": "${business_content_class_api}",
                        "data": "${business_content_class_params}",
                        "adaptor": "var data = payload.data || payload.options || payload; var list = []; if (Array.isArray(data)) { list = data; } else if (data && Array.isArray(data.options)) { list = data.options; } else if (data && Array.isArray(data.rows)) { list = data.rows; } return { class_options: list };"
                    },
                    "body": [
                        {
                            "type": "crud",
            "columnsTogglable": false,
            "api": "post:{{ GLOBAL_API_PREFIX }}/ywbzk/list",
            "filter": {
                "id": "business_standard_filter_form",
                "title": "",
                "submitText": "",
                "type": "form",
                "mode": "inline",
                "wrapWithPanel": false,
                "body": [
                    {
                        "type": "select",
                        "id": "main_algorithm_select",
                        "name": "gjsjsf",
                        "label": "关键数据算法",
                        "placeholder": "请选择关键数据算法",
                        "clearable": true,
                        "source": "${algorithm_options}",
                        "onEvent": {
                            "change": {
                                "actions": [
                                    {
                                        "actionType": "setValue",
                                        "componentId": "business_standard_filter_form",
                                        "args": {
                                            "value": {
                                                "ywnrfl": ""
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "select",
                        "id": "main_business_content_class_select",
                        "name": "ywnrfl",
                        "label": "业务内容分类",
                        "placeholder": "请选择业务内容分类",
                        "clearable": true,
                        "clearValueOnOptionsChange": true,
                        "source": {
                            "method": "post",
                            "url": "${business_content_class_api}",
                            "data": {
                                "&": "${business_content_class_params}",
                                "gjsjsf": "${gjsjsf}"
                            },
                            "trackExpression": "${gjsjsf}"
                        },
                        "disabledOn": "${!gjsjsf}"
                    },
                    {
                        "type": "select",
                        "name": "ywblbz",
                        "label": "业务办理标准",
                        "placeholder": "请选择业务办理标准",
                        "searchable": true,
                        "clearable": true,
                        "source": {
                            "method": "post",
                            "url": "{{ GLOBAL_API_PREFIX | default('/api') }}/ywbzk/standards"
                        }
                    },
                    {
                        "type": "submit",
                        "label": "查询",
                        "level": "primary"
                    },
                    {
                        "type": "reset",
                        "label": "重置"
                    },
                    {
                        "type": "button",
                        "label": "业务内容分类维护",
                        "visibleOn": "${business_standard_editable}",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "业务内容分类维护",
                            "size": "lg",
                            "body": {
                                "type": "crud",
                                "id": "business_content_class_crud",
                                "syncLocation": false,
                                "api": {
                                    "method": "post",
                                    "url": "${business_content_class_manage_list_api}"
                                },
                                "filter": {
                                    "title": "",
                                    "submitText": "",
                                    "type": "form",
                                    "mode": "inline",
                                    "wrapWithPanel": false,
                                    "body": [
                                        {
                                            "type": "select",
                                            "name": "gjsjsf",
                                            "label": "关键数据算法",
                                            "clearable": true,
                                            "source": "${algorithm_options}"
                                        },
                                        {
                                            "type": "input-text",
                                            "name": "flbm",
                                            "label": "分类编码",
                                            "clearable": true
                                        },
                                        {
                                            "type": "input-text",
                                            "name": "flmc",
                                            "label": "分类名称",
                                            "clearable": true
                                        },
                                        {
                                            "type": "select",
                                            "name": "sfqy",
                                            "label": "是否启用",
                                            "clearable": true,
                                            "options": [
                                                { "label": "启用", "value": 1 },
                                                { "label": "停用", "value": 0 }
                                            ]
                                        },
                                        {
                                            "type": "submit",
                                            "label": "查询",
                                            "level": "primary"
                                        },
                                        {
                                            "type": "reset",
                                            "label": "重置"
                                        },
                                        {
                                            "type": "button",
                                            "label": "新增分类",
                                            "level": "success",
                                            "actionType": "dialog",
                                            "dialog": {
                                                "title": "新增业务内容分类",
                                                "body": {
                                                    "type": "form",
                                                    "api": "post:${business_content_class_manage_save_api}",
                                                    "onEvent": {
                                                        "submitSucc": {
                                                            "actions": [
                                                                {
                                                                    "actionType": "reload",
                                                                    "componentId": "business_content_class_crud"
                                                                },
                                                                {
                                                                    "actionType": "reload",
                                                                    "componentId": "main_business_content_class_select"
                                                                }
                                                            ]
                                                        }
                                                    },
                                                    "body": [
                                                        {
                                                            "type": "select",
                                                            "name": "gjsjsf",
                                                            "label": "关键数据算法",
                                                            "required": true,
                                                            "source": "${algorithm_options}"
                                                        },
                                                        {
                                                            "type": "input-text",
                                                            "name": "flbm",
                                                            "label": "分类编码",
                                                            "required": true
                                                        },
                                                        {
                                                            "type": "input-text",
                                                            "name": "flmc",
                                                            "label": "分类名称",
                                                            "required": true
                                                        },
                                                        {
                                                            "type": "input-number",
                                                            "name": "quanzhong",
                                                            "label": "权重",
                                                            "visibleOn": "${gjsjsf === '19'}",
                                                            "requiredOn": "${gjsjsf === '19'}",
                                                            "min": 1,
                                                            "max": 100,
                                                            "placeholder": "请输入 1-100 的整数"
                                                        },
                                                        {
                                                            "type": "input-number",
                                                            "name": "pxh",
                                                            "label": "排序号",
                                                            "value": 0
                                                        },
                                                        {
                                                            "type": "select",
                                                            "name": "sfqy",
                                                            "label": "是否启用",
                                                            "value": 1,
                                                            "options": [
                                                                { "label": "启用", "value": 1 },
                                                                { "label": "停用", "value": 0 }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    ]
                                },
                                "columns": [
                                    {
                                        "name": "gjsjsf",
                                        "label": "关键数据算法",
                                        "type": "mapping",
                                        "source": "${algorithm_options}"
                                    },
                                    {
                                        "name": "flbm",
                                        "label": "分类编码"
                                    },
                                    {
                                        "name": "flmc",
                                        "label": "分类名称"
                                    },
                                    {
                                        "type": "tpl",
                                        "name": "quanzhong",
                                        "label": "权重",
                                        "tpl": "${quanzhong || '-'}"
                                    },
                                    {
                                        "name": "pxh",
                                        "label": "排序号"
                                    },
                                    {
                                        "name": "sfqy",
                                        "label": "是否启用",
                                        "type": "mapping",
                                        "map": {
                                            "1": "启用",
                                            "0": "停用",
                                            "*": "-"
                                        }
                                    },
                                    {
                                        "type": "operation",
                                        "label": "操作",
                                        "buttons": [
                                            {
                                                "type": "button",
                                                "label": "编辑",
                                                "level": "link",
                                                "actionType": "dialog",
                                                "dialog": {
                                                    "title": "编辑业务内容分类",
                                                    "body": {
                                                        "type": "form",
                                                        "api": "post:${business_content_class_manage_save_api}",
                                                        "onEvent": {
                                                            "submitSucc": {
                                                                "actions": [
                                                                    {
                                                                        "actionType": "reload",
                                                                        "componentId": "business_content_class_crud"
                                                                    },
                                                                    {
                                                                        "actionType": "reload",
                                                                        "componentId": "main_business_content_class_select"
                                                                    }
                                                                ]
                                                            }
                                                        },
                                                        "body": [
                                                            {
                                                                "type": "hidden",
                                                                "name": "id"
                                                            },
                                                            {
                                                                "type": "select",
                                                                "name": "gjsjsf",
                                                                "label": "关键数据算法",
                                                                "required": true,
                                                                "source": "${algorithm_options}"
                                                            },
                                                            {
                                                                "type": "input-text",
                                                                "name": "flbm",
                                                                "label": "分类编码",
                                                                "required": true
                                                            },
                                                            {
                                                                "type": "input-text",
                                                                "name": "flmc",
                                                                "label": "分类名称",
                                                                "required": true
                                                            },
                                                            {
                                                                "type": "input-number",
                                                                "name": "quanzhong",
                                                                "label": "权重",
                                                                "visibleOn": "${gjsjsf === '19'}",
                                                                "requiredOn": "${gjsjsf === '19'}",
                                                                "min": 1,
                                                                "max": 100,
                                                                "placeholder": "请输入 1-100 的整数"
                                                            },
                                                            {
                                                                "type": "input-number",
                                                                "name": "pxh",
                                                                "label": "排序号"
                                                            },
                                                            {
                                                                "type": "select",
                                                                "name": "sfqy",
                                                                "label": "是否启用",
                                                                "options": [
                                                                    { "label": "启用", "value": 1 },
                                                                    { "label": "停用", "value": 0 }
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                }
                                            },
                                            {
                                                "type": "button",
                                                "label": "删除",
                                                "level": "link",
                                                "className": "text-danger",
                                                "actionType": "ajax",
                                                "confirmText": "确认删除该业务内容分类？",
                                                "api": {
                                                    "method": "post",
                                                    "url": "${business_content_class_manage_delete_api}",
                                                    "data": {
                                                        "id": "${id}"
                                                    }
                                                },
                                                "onEvent": {
                                                    "click": {
                                                        "actions": [
                                                            {
                                                                "actionType": "reload",
                                                                "componentId": "business_content_class_crud"
                                                            }
                                                        ]
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "tpl",
                        "visibleOn": "${!business_standard_editable}",
                        "className": "text-warning m-l-sm",
                        "tpl": "当前机构为非模型机构，标准库仅支持查看和导出；新增、编辑、删除请在模型机构执行。"
                    },
                    {
                        "type": "button",
                        "label": "新增",
                        "visibleOn": "${business_standard_editable}",
                        "actionType": "dialog",
                        "level": "success",
                        "dialog": {
                            "title": "新增业务标准模板",
                            "size": "lg",
                            "body": {
                                "type": "form",
                                "id": "business_standard_add_form",
                                "mode": "normal",
                                "api": "post:{{ GLOBAL_API_PREFIX }}/ywbzk/save",
                                "body": [
                                    {
                                        "type": "input-number",
                                        "name": "pxh",
                                        "label": "排序号：",
                                        "value": 0
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "ywblbz",
                                        "label": "业务办理标准：",
                                        "required": true,
                                        "placeholder": "请输入业务办理标准"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "tsysxmc",
                                        "label": "提示语属性名称：",
                                        "placeholder": "请输入提示语属性名称"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "tsysxdw",
                                        "label": "提示语属性单位：",
                                        "placeholder": "请输入提示语属性单位"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "zdybm",
                                        "label": "自定义编码：",
                                        "placeholder": "请输入自定义编码"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "ywblbzsm",
                                        "label": "业务办理标准描述：",
                                        "placeholder": "请输入业务办理标准描述"
                                    },
                                    {
                                        "type": "select",
                                        "id": "business_standard_add_gjsjsf_select",
                                        "name": "gjsjsf",
                                        "label": "关键数据算法：",
                                        "source": "${algorithm_options}",
                                        "onEvent": {
                                            "change": {
                                                "actions": [
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "business_standard_add_form",
                                                        "args": {
                                                            "value": {
                                                                    "ywnrfl": "",
                                                                    "hcbzIds": []
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                    },
                                    {
                                        "type": "select",
                                        "id": "business_standard_add_ywnrfl_select",
                                        "name": "ywnrfl",
                                        "label": "业务内容分类：",
                                        "placeholder": "请选择业务内容分类",
                                        "clearable": true,
                                        "clearValueOnOptionsChange": true,
                                        "source": {
                                            "method": "post",
                                            "url": "${business_content_class_api}",
                                            "data": {
                                                "&": "${business_content_class_params}",
                                                "gjsjsf": "${gjsjsf}"
                                            },
                                            "trackExpression": "${gjsjsf}"
                                        },
                                        "disabledOn": "${!gjsjsf}",
                                        "onEvent": {
                                            "change": {
                                                "actions": [
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "business_standard_add_form",
                                                        "args": {
                                                            "value": {
                                                                "hcbzIds": []
                                                            }
                                                        }
                                                    }
                                                ]
                                            }
                                        }
                                    },
                                    {
                                        "type": "select",
                                        "name": "ywblfl",
                                        "label": "业务办理分类：",
                                        "value": "1",
                                        "source": "${handle_class_options}"
                                    },
                                    {
                                        "type": "select",
                                        "name": "bzfl",
                                        "label": "业务办理标准分类：",
                                        "source": "${standard_class_options}"
                                    },
                                    {
                                        "type": "select",
                                        "name": "ywbzz",
                                        "label": "业务标准值：",
                                        "clearable": true,
                                        "searchable": true,
                                        "placeholder": "请选择业务标准值",
                                        "visibleOn": "${ywblfl === '1'}",
                                        "source": {
                                            "method": "post",
                                            "url": "${business_standard_value_api}",
                                            "data": {
                                                "&": "${business_standard_value_params}",
                                                "name": "${term}"
                                            }
                                        }
                                    },
                                    {
                                        "type": "tpl",
                                        "tpl": "<b>业务办理标准结果执行语句：</b>",
                                        "visibleOn": "${ywblfl === '1'}",
                                        "className": "m-t-sm m-b-xs block"
                                    },
                                    {
                                        "type": "tpl",
                                        "tpl": "<b>业务条件执行语句：</b>",
                                        "visibleOn": "${ywblfl === '2'}",
                                        "className": "m-t-sm m-b-xs block"
                                    },
                                    {
                                        "type": "tpl",
                                        "tpl": "<b>业务风险执行语句：</b>",
                                        "visibleOn": "${ywblfl === '3'}",
                                        "className": "m-t-sm m-b-xs block"
                                    },
                                    {
                                        "type": "input-number",
                                        "name": "fenzhi",
                                        "label": "分值：",
                                        "visibleOn": "${ywblfl === '3'}",
                                        "requiredOn": "${ywblfl === '3'}",
                                        "min": 1,
                                        "max": 100,
                                        "placeholder": "请输入 1-100 的整数"
                                    },
                                    {
                                        "type": "tabs",
                                        "tabsMode": "simple",
                                        "tabs": [
                                            {
                                                "title": "默认数据库",
                                                "body": { "type": "editor", "name": "ywbzjg_dialects.default", "label": false, "language": "sql", "size": "md", "options": {"fontSize": 14} }
                                            },
                                            {
                                                "title": "oracle数据库",
                                                "body": { "type": "editor", "name": "ywbzjg_dialects.oracle", "label": false, "language": "sql", "size": "md", "options": {"fontSize": 14} }
                                            },
                                            {
                                                "title": "达梦数据库",
                                                "body": { "type": "editor", "name": "ywbzjg_dialects.dm", "label": false, "language": "sql", "size": "md", "options": {"fontSize": 14} }
                                            },
                                            {
                                                "title": "高斯数据库",
                                                "body": { "type": "editor", "name": "ywbzjg_dialects.gauss", "label": false, "language": "sql", "size": "md", "options": {"fontSize": 14} }
                                            },
                                            {
                                                "title": "人大金仓数据库",
                                                "body": { "type": "editor", "name": "ywbzjg_dialects.kingbase", "label": false, "language": "sql", "size": "md", "options": {"fontSize": 14} }
                                            },
                                            {
                                                "title": "postgresql数据库",
                                                "body": { "type": "editor", "name": "ywbzjg_dialects.pg", "label": false, "language": "sql", "size": "md", "options": {"fontSize": 14} }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "select",
                                        "id": "business_standard_add_hcbz_select",
                                        "name": "hcbzIds",
                                        "label": "互斥业务办理标准：",
                                        "multiple": true,
                                        "joinValues": false,
                                        "extractValue": true,
                                        "clearable": true,
                                        "clearValueOnOptionsChange": true,
                                        "searchable": true,
                                        "source": {
                                            "method": "post",
                                            "url": "${mutual_standard_api}",
                                            "data": {
                                                "gjsjsf": "${gjsjsf}",
                                                "ywnrfl": "${ywnrfl}"
                                            },
                                            "trackExpression": "${gjsjsf}-${ywnrfl}"
                                        },
                                        "disabledOn": "${!gjsjsf || !ywnrfl}"
                                    },
                                    {
                                        "type": "combo",
                                        "name": "ywblbzsxz",
                                        "label": "业务办理标准属性组：",
                                        "multiple": true,
                                        "multiLine": true,
                                        "addable": true,
                                        "removable": true,
                                        "items": [
                                            {
                                                "type": "group",
                                                "body": [
                                                    {
                                                        "type": "select",
                                                        "name": "sfdxsx",
                                                        "label": "是否对象属性：",
                                                        "value": "1",
                                                        "options": [
                                                            {
                                                                "label": "是",
                                                                "value": "1"
                                                            },
                                                            {
                                                                "label": "否",
                                                                "value": "0"
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "type": "select",
                                                        "name": "ywblbzdx",
                                                        "label": "业务办理标准属性所属对象：",
                                                        "requiredOn": "${sfdxsx !== '0'}",
                                                        "visibleOn": "${sfdxsx !== '0'}",
                                                        "source": {
                                                            "method": "post",
                                                            "url": "${service_objects_api}",
                                                            "data": "${service_objects_params}"
                                                        },
                                                        "autoFill": {
                                                            "fwdxbq": "${label}",
                                                            "_syObjectNumber": "${syObjectNumber}",
