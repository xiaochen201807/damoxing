{#
  信用评价指标管理页面
  
  ========== API 配置 ==========
  - indicators_list_api: 指标列表接口 (POST)
  - indicators_list_data: 列表接口固定参数 (JSON)
  - indicators_create_api: 新增指标接口 (POST)
  - indicators_create_data: 新增接口固定参数 (JSON)
  - indicators_update_api: 更新指标接口 (POST)
  - indicators_update_data: 更新接口固定参数 (JSON)
  - indicators_delete_api: 删除指标接口 (POST)
  - indicators_delete_data: 删除接口固定参数 (JSON)
  
  ========== 页面配置 ==========
  - title: 页面标题
#}

{# ========== 默认配置 ========== #}
{% set title = title | default('信用评价指标管理') %}

{# ========== API 配置 ========== #}
{% set indicators_list_api = indicators_list_api | default('/api/demo/credit/indicators/list') %}
{% set indicators_create_api = indicators_create_api | default('/api/demo/credit/indicators/create') %}
{% set indicators_update_api = indicators_update_api | default('/api/demo/credit/indicators/update') %}
{% set indicators_delete_api = indicators_delete_api | default('/api/demo/credit/indicators/delete') %}

{# ========== 固定参数配置 ========== #}
{% set list_data_obj = indicators_list_data | default('{}') | fromjson %}
{% set create_data_obj = indicators_create_data | default('{}') | fromjson %}
{% set update_data_obj = indicators_update_data | default('{}') | fromjson %}
{% set delete_data_obj = indicators_delete_data | default('{}') | fromjson %}

{# ========== 页面结构 ========== #}
{
  "type": "page",
  "title": "{{ title }}",
  "body": [
    {
      "type": "crud",
      "name": "indicatorsCrud",
      "api": {
        "method": "post",
        "url": "{{ indicators_list_api }}",
        "data": {
          {% if list_data_obj %}{% for key, val in list_data_obj %}"{{ key }}": {{ val | tojson }},
          {% endfor %}{% endif %}
          "subject": "${subject}",
          "status": "${status}",
          "page": "${page}",
          "perPage": "${perPage}"
        }
      },

      "syncLocation": false,
      "headerToolbar": [
        {
          "type": "button",
          "label": "新增指标",
          "actionType": "dialog",
          "level": "primary",
          "icon": "fa fa-plus",
          "dialog": {
            "title": "新增信用评价指标",
            "size": "md",
            "body": {
              "type": "form",
              "api": {
                "method": "post",
                "url": "{{ indicators_create_api }}",
                "data": {
                  {% if create_data_obj %}{% for key, val in create_data_obj %}"{{ key }}": {{ val | tojson }},
                  {% endfor %}{% endif %}
                  "&": "$$"
                }
              },
              "body": [
                {
                  "type": "select",
                  "name": "subject",
                  "label": "主体类型",
                  "required": true,
                  "options": [
                    { "label": "缴存单位", "value": "缴存单位" },
                    { "label": "缴存人", "value": "缴存人" },
                    { "label": "开发商", "value": "开发商" }
                  ]
                },
                {
                  "type": "input-text",
                  "name": "name",
                  "label": "监控指标",
                  "required": true,
                  "placeholder": "请输入监控指标名称"
                },
                {
                  "type": "textarea",
                  "name": "description",
                  "label": "指标描述",
                  "placeholder": "请输入指标的详细描述"
                },
                {
                  "type": "input-number",
                  "name": "weight",
                  "label": "权重",
                  "required": true,
                  "min": 1,
                  "max": 100,
                  "suffix": "%",
                  "placeholder": "1-100"
                },
                {
                  "type": "input-text",
                  "name": "elementName",
                  "label": "管理要素名称",
                  "required": true,
                  "placeholder": "例如：欠缴月数、减少比例"
                },
                {
                  "type": "input-text",
                  "name": "elementDesc",
                  "label": "管理要素说明",
                  "required": true,
                  "placeholder": "请输入管理要素的详细说明"
                },
                {
                  "type": "input-number",
                  "name": "elementValue",
                  "label": "管理要素阈值",
                  "required": true,
                  "placeholder": "请输入阈值数字"
                },
                {
                  "type": "switch",
                  "name": "status",
                  "label": "启用状态",
                  "onText": "开启",
                  "offText": "关闭",
                  "trueValue": "开启",
                  "falseValue": "关闭",
                  "value": "开启"
                }
              ]
            }
          }
        },
        "bulkActions"
      ],
      "filter": {
        "title": "指标配置",
        "mode": "inline",
        "body": [
          {
            "type": "select",
            "name": "subject",
            "label": "主体类型",
            "clearable": true,
            "options": [
              { "label": "全部", "value": "" },
              { "label": "缴存单位", "value": "缴存单位" },
              { "label": "缴存人", "value": "缴存人" },
              { "label": "开发商", "value": "开发商" }
            ]
          },
          {
            "type": "select",
            "name": "status",
            "label": "启用状态",
            "clearable": true,
            "options": [
              { "label": "全部", "value": "" },
              { "label": "开启", "value": "开启" },
              { "label": "关闭", "value": "关闭" }
            ]
          }
        ],
        "actions": [
          { "type": "submit", "label": "查询", "level": "primary" },
          { "type": "reset", "label": "重置" }
        ]
      },
      "columns": [
        { "name": "subject", "label": "主体类型", "width": 100 },
        { "name": "name", "label": "监控指标", "width": 300 },
        { "name": "weight", "label": "权重", "width": 80, "tpl": "${weight}%" },
        { "name": "elementName", "label": "管理要素", "width": 200, "tpl": "${elementName}: ${elementDesc | raw}${elementValue}" },
        { "name": "elementDesc", "label": "要素说明", "width": 200 },
        {
          "name": "status",
          "label": "启用状态",
          "width": 100,
          "type": "mapping",
          "map": {
            "开启": "<span class='label label-success'>开启</span>",
            "关闭": "<span class='label label-danger'>关闭</span>"
          }
        },
        {
          "type": "operation",
          "label": "操作",
          "width": 150,
          "buttons": [
            {
              "type": "button",
              "label": "编辑",
              "actionType": "dialog",
              "level": "link",
              "icon": "fa fa-edit",
              "dialog": {
                "title": "编辑信用评价指标",
                "size": "md",
                "body": {
                  "type": "form",
                  "api": {
                    "method": "post",
                    "url": "{{ indicators_update_api }}",
                    "data": {
                      {% if update_data_obj %}{% for key, val in update_data_obj %}"{{ key }}": {{ val | tojson }},
                      {% endfor %}{% endif %}
                      "&": "$$"
                    }
                  },
                  "body": [
                    { "type": "hidden", "name": "id" },
                    {
                      "type": "select",
                      "name": "subject",
                      "label": "主体类型",
                      "required": true,
                      "options": [
                        { "label": "缴存单位", "value": "缴存单位" },
                        { "label": "缴存人", "value": "缴存人" },
                        { "label": "开发商", "value": "开发商" }
                      ]
                    },
                    { "type": "input-text", "name": "name", "label": "监控指标", "required": true },
                    { "type": "textarea", "name": "description", "label": "指标描述" },
                    { "type": "input-number", "name": "weight", "label": "权重", "required": true, "min": 1, "max": 100, "suffix": "%" },
                    { "type": "input-text", "name": "elementName", "label": "管理要素名称", "required": true },
                    { "type": "input-text", "name": "elementDesc", "label": "管理要素说明", "required": true },
                    { "type": "input-number", "name": "elementValue", "label": "管理要素阈值", "required": true },
                    {
                      "type": "switch",
                      "name": "status",
                      "label": "启用状态",
                      "onText": "开启",
                      "offText": "关闭",
                      "trueValue": "开启",
                      "falseValue": "关闭"
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "删除",
              "actionType": "ajax",
              "level": "link",
              "icon": "fa fa-trash",
              "className": "text-danger",
              "confirmText": "确定要删除该指标吗？",
              "api": {
                "method": "post",
                "url": "{{ indicators_delete_api }}",
                "data": {
                  {% if delete_data_obj %}{% for key, val in delete_data_obj %}"{{ key }}": {{ val | tojson }},
                  {% endfor %}{% endif %}
                  "id": "${id}"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
