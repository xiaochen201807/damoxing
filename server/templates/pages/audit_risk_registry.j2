{#
  智能稽核 - 风险清册页面
  
  ========== API 配置 ==========
  - registry_list_api: 风险清册列表接口 (POST)
#}

{# ========== API 配置 ========== #}
{% set registry_list_api = registry_list_api | default('/api/demo/audit/risk/registry/list') %}

{# ========== 页面结构 ========== #}
{
  "type": "page",
  "title": "",
  "body": [
    {
      "type": "wrapper",
      "className": "bg-white p-md m-b-md",
      "body": {
        "type": "flex",
        "justify": "space-between",
        "alignItems": "center",
        "items": [
          {
            "type": "wrapper",
            "body": [
              { "type": "html", "html": "<h2 style='margin:0;font-size:24px;font-weight:600;color:#1d39c4'><i class='fa fa-exclamation-triangle' style='margin-right:10px;color:#faad14'></i>风险清册</h2>" },
              { "type": "html", "html": "<p style='margin:8px 0 0 0;color:#666'>被AI模型识别超过阈值的异常业务，需人工复核审查确实后驳回或放行业务办理请求</p>" }
            ]
          }
        ]
      }
    },
    {
      "type": "crud",
      "name": "riskRegistryCrud",
      "api": {
        "method": "post",
        "url": "{{ registry_list_api }}",
        "data": {
          "riskType": "${riskType}",
          "status": "${status}",
          "page": "${page}",
          "perPage": "${perPage}"
        }
      },
      "syncLocation": false,
      "headerToolbar": ["bulkActions", "pagination"],
      "footerToolbar": ["statistics", "pagination"],
      "filter": {
        "title": "",
        "mode": "inline",
        "body": [
          {
            "type": "select",
            "name": "riskType",
            "label": "AI风险类型",
            "clearable": true,
            "options": [
              { "label": "全部类型", "value": "" },
              { "label": "材料伪造", "value": "材料伪造" },
              { "label": "团伙骗提", "value": "团伙骗提" },
              { "label": "单位挂靠", "value": "单位挂靠" },
              { "label": "合同造假", "value": "合同造假" },
              { "label": "地址矛盾", "value": "地址矛盾" },
              { "label": "突击提取", "value": "突击提取" }
            ]
          },
          {
            "type": "select",
            "name": "status",
            "label": "复核状态",
            "clearable": true,
            "options": [
              { "label": "全部", "value": "" },
              { "label": "已复核", "value": "已复核" },
              { "label": "未复核", "value": "未复核" }
            ]
          }
        ],
        "actions": [
          { "type": "submit", "label": "查询", "level": "primary" },
          { "type": "reset", "label": "重置" }
        ]
      },
      "columns": [
        { "name": "id", "label": "序号", "width": 60 },
        { "name": "name", "label": "姓名", "width": 80 },
        { "name": "idCard", "label": "身份证号", "width": 180 },
        { "name": "type", "label": "业务类型", "width": 100 },
        { "name": "amountFormatted", "label": "金额", "width": 120 },
        { "name": "date", "label": "申请时间", "width": 120 },
        {
          "name": "riskType",
          "label": "AI风险类型",
          "width": 100,
          "type": "mapping",
          "map": {
            "材料伪造": "<span class='label' style='background:#e63946;color:#fff'>材料伪造</span>",
            "团伙骗提": "<span class='label' style='background:#d63384;color:#fff'>团伙骗提</span>",
            "单位挂靠": "<span class='label' style='background:#6f42c1;color:#fff'>单位挂靠</span>",
            "合同造假": "<span class='label' style='background:#fd7e14;color:#fff'>合同造假</span>",
            "地址矛盾": "<span class='label' style='background:#20c997;color:#fff'>地址矛盾</span>",
            "突击提取": "<span class='label' style='background:#0dcaf0;color:#fff'>突击提取</span>"
          }
        },
        {
          "name": "confidenceFormatted",
          "label": "置信度",
          "width": 80,
          "type": "tpl",
          "tpl": "<span style='color:#e63946;font-weight:600'>${confidenceFormatted}</span>"
        },
        {
          "name": "status",
          "label": "状态",
          "width": 80,
          "type": "mapping",
          "map": {
            "已复核": "<span class='label label-success'>已复核</span>",
            "未复核": "<span class='label label-warning'>未复核</span>"
          }
        },
        {
          "type": "operation",
          "label": "操作",
          "width": 80,
          "buttons": [
            {
              "type": "button",
              "label": "查看",
              "level": "link",
              "actionType": "dialog",
              "dialog": {
                "title": "AI稽核详情",
                "size": "md",
                "body": [
                  { "type": "html", "html": "<h4><i class='fa fa-sticky-note'></i> 业务摘要</h4>" },
                  { "type": "tpl", "tpl": "<p style='background:#f5f5f5;padding:15px;border-radius:8px'>${name}于${date}通过线上服务渠道提交${type}申请，金额为${amountFormatted}。</p>" },
                  {
                    "type": "alert",
                    "level": "warning",
                    "body": "<strong>注意：</strong>该业务已被AI模型标记为高风险（${riskType}，置信度${confidenceFormatted}），请确认是否驳回。"
                  }
                ],
                "actions": [
                  { "type": "button", "label": "关闭", "actionType": "close" },
                  { "type": "button", "label": "驳回并冻结", "level": "danger" },
                  { "type": "button", "label": "放行业务办理", "level": "primary" }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
