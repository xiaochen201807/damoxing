{#
  任务项运行配置工具 React 页面入口

  @param title 页面标题
  @param task_config_summary_api 页面汇总接口
  @param task_config_rows_api 清单接口
  @param task_config_business_options_api 应用业务选项接口
  @param task_config_group_options_api 节点要素选项接口
  @param task_config_save_api 配置保存接口
#}
{
    "type": "page",
    "title": "{{ title | default('任务项运行配置工具') }}",
    "xRenderer": "task-config-upgrade",
    "data": {
        "task_config_summary_api": "{{ task_config_summary_api | default(GLOBAL_API_PREFIX + '/task_configmock/summary') }}",
        "task_config_rows_api": "{{ task_config_rows_api | default(GLOBAL_API_PREFIX + '/task_configmock/rows') }}",
        "task_config_business_options_api": "{{ task_config_business_options_api | default(GLOBAL_API_PREFIX + '/task_configmock/business-options') }}",
        "task_config_group_options_api": "{{ task_config_group_options_api | default(GLOBAL_API_PREFIX + '/task_configmock/group-options') }}",
        "task_config_save_api": "{{ task_config_save_api | default(GLOBAL_API_PREFIX + '/task_configmock/save-business-config') }}",
        "default_task": "{{ default_task | default('tq') }}",
        "default_related_party": "{{ default_related_party | default('person') }}"
    },
    "body": [
        {
            "type": "tpl",
            "tpl": "任务项运行配置工具使用前端 React 渲染器展示。"
        }
    ]
}
