{# Policy Analysis Page - 政策分析页面模板 #}
{# 基于 fx_demo.j2 的结构，增加了数据卡片和政策参数表单功能 #}
{% import 'base/colors.j2' as theme %}
{
    "type": "page",
    
    {# ⭐ 核心 1：定义唯一 ID，供子组件寻找 ⭐ #}
    "id": "global_page_root",     
    "className": "p-none",
    
    {# ⭐ 核心 2：定义全局状态，作为唯一的真理来源 ⭐ #}
    "data": {
        "show_analysis_result": false,  {# 控制结果区域是否显示 #}
        "ai_loading": false,            {# 控制全屏 Loading 遮罩是否显示 #}
        "show_prediction": false        {# 控制预测数据区域是否显示 #}
    },

    "body": [
        {# 1. 顶部 Header #}
        {% include 'components/header.j2' %},

        {# 2. 顶部 Alert 提示 #}
        {% include 'components/alert.j2' %},

        {# 3. 当前政策数据卡片区（复用 stats_cards）#}
        {
            "type": "container",
            "className": "m-t-md",
            "style": {
                "backgroundColor": "#fff",
                "borderRadius": "10px",
                "boxShadow": "0 4px 8px rgba(0, 0, 0, 0.05)",
                "padding": "25px",
                "marginBottom": "20px"
            },
            "body": [
                {# 当前数据区 #}
                {% set title = "<div style='font-weight: 600; color: #1a3c6e; font-size: 16px; display: flex; align-items: center; gap: 8px;'><i style='font-size: 18px;'>📊</i> " + (current_data_title | default('当前政策数据')) + " <span style='font-size: 12px; color: #999; margin-left: auto;'>" + (current_data_quarter | default('2025Q4')) + "</span></div>" %}
                {% set items = items | fromjson | default(current_data_items | fromjson) %}
                {% set columns = columns | default(4) %}
                {% set height = card_height | default('auto') %}
                {% include 'components/stats_cards.j2' %}
                
                {# 预测数据区（可选显示）#}
                {% if enable_prediction | default(true) %},
                {
                    "type": "container",
                    "visibleOn": "${show_prediction}",
                    "className": "m-t-lg",
                    "body": [
                        {
                            "type": "tpl",
                            "tpl": "<div style='height: 1px; background: linear-gradient(to right, transparent, #e8e8e8, transparent); margin: 25px 0;'></div>"
                        },
                        {% set title = "<div style='font-weight: 600; color: #1a3c6e; font-size: 16px; display: flex; align-items: center; gap: 8px;'><i style='font-size: 18px;'>🔮</i> " + (prediction_data_title | default('政策预测数据')) + "</div>" %}
                        {% set items = prediction_data_items | fromjson %}
                        {% set columns = prediction_columns | default(columns) | default(4) %}
                        {% set height = card_height | default('auto') %}
                        {% include 'components/stats_cards.j2' %}
                    ]
                }
                {% endif %}
            ]
        },

        {# 4. 统一政策分析组件（整合表单与 AI）#}
        {% set groups = (policy_groups | fromjson) if policy_groups else [
                {
                    "title": "参数提取配置",
                    "columns": 3,
                    "fields": [
                        { "name": "rent_limit", "label": "月租金上限", "type": "input-number", "value": 2500 },
                        { "name": "deposit_months", "label": "缴存月数", "type": "input-number", "value": 6 },
                        { "name": "region_code", "label": "适用区域", "type": "select", "options": [{"label":"全省","value":"all"}] }
                    ]
                }
            ] %}
        {% set actions = (policy_actions | fromjson) if policy_actions else [
                {
                    "label": "📊 智能分析 (Dify)",
                    "actionType": "ai_analysis",
                    "level": "danger"
                }
            ] %}
        {% include 'components/unified_policy_component.j2' %},

        {# 6. 底部 Footer #}
        {
            "type": "tpl",
            "tpl": "<div style='text-align: center; color: #999; font-size: 12px; padding: 20px 0;'>{{ footer_text | default('住房公积金管理中心 © 2025') }}</div>"
        }
    ]
}
