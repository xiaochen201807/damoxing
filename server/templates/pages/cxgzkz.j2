{
    "type": "page",
    "title": "{{ title }}",
    "css": {
        ".premium-card": {
            "boxShadow": "0 4px 20px rgba(0,0,0,0.08)",
            "borderRadius": "12px",
            "overflow": "hidden"
        },
        "#main_crud .cxd-CRUD-header": {
            "padding": "8px 0 12px"
        },
        "#main_crud .cxd-CRUD-header .cxd-CRUD-toolbar": {
            "display": "flex",
            "alignItems": "center",
            "gap": "10px",
            "flexWrap": "wrap"
        },
        "#main_crud .cxd-CRUD-header .cxgzkz-toolbar-btn": {
            "marginRight": "0"
        },
        ".page-header-gradient": {
            "background": "linear-gradient(90deg, #1890ff 0%, #096dd9 100%)",
            "padding": "16px 24px",
            "color": "#fff",
            "marginBottom": "0px",
            "borderRadius": "12px 12px 0 0"
        }
    },
    "data": {
        "rule_list_api": "{{ GLOBAL_API_PREFIX }}/cxgzkz/list",
        "rule_save_api": "{{ GLOBAL_API_PREFIX }}/cxgzkz/save",
        "rule_delete_api": "{{ GLOBAL_API_PREFIX }}/cxgzkz/delete",
        "matter_subject_api": "{{ GLOBAL_API_PREFIX }}/cxgzkz/matter-subject-info",
        "rule_import_api": "{{ GLOBAL_API_PREFIX }}/cxgzkz/import",
        "rule_export_api": "{{ GLOBAL_API_PREFIX }}/cxgzkz/export",
        "mode_api": "{{ GLOBAL_API_PREFIX }}/cxgzkz/mode",
        "env_mode": "prod"
    },
    "initApi": {
        "method": "post",
        "url": "${mode_api}"
    },
    "body": [
        {
            "id": "main_crud",
            "type": "crud",
            "columnsTogglable": false,
            "selectable": true,
            "multiple": true,
            "keepItemSelectionOnPageChange": true,
            "primaryField": "id",
            "api": "post:${rule_list_api}",
            "className": "premium-card",
            "filter": {
                "id": "main_filter_form",
                "title": "",
                "submitText": "",
                "type": "form",
                "mode": "inline",
                "wrapWithPanel": false,
                "className": "p-4",
                "body": [
                    {
                        "type": "input-text",
                        "name": "gzmc",
                        "label": "程序控制规则名称",
                        "placeholder": "请输入规则名称",
                        "clearable": true
                    },
                    {
                        "type": "input-text",
                        "name": "gztsy",
                        "label": "程序控制规则提示语",
                        "placeholder": "请输入提示语",
                        "clearable": true
                    },
                    {
                        "type": "select",
                        "name": "sxbh",
                        "label": "事项名称",
                        "placeholder": "请输入事项名称关键字联想查询",
                        "clearable": true,
                        "searchable": true,
                        "source": {
                            "method": "post",
                            "url": "${matter_subject_api}",
                            "data": {
                                "matterSubjectName": ""
                            }
                        },
                        "autoComplete": {
                            "method": "post",
                            "url": "${matter_subject_api}",
                            "data": {
                                "matterSubjectName": "${term}"
                            }
                        },
                        "labelField": "label",
                        "valueField": "value"
                    },
                    {
                        "type": "select",
                        "name": "sfqy",
                        "label": "是否启用",
                        "clearable": true,
                        "options": [
                            {"label": "是", "value": "y"},
                            {"label": "否", "value": "n"}
                        ]
                    },
                    {
                        "type": "select",
                        "name": "sfyxtqy",
                        "label": "是否允许停启用",
                        "clearable": true,
                        "options": [
                            {"label": "是", "value": "y"},
                            {"label": "否", "value": "n"}
                        ]
                    },
                    {
                        "type": "select",
                        "name": "sfyxtztsy",
                        "label": "是否允许调整提示语",
                        "clearable": true,
                        "options": [
                            {"label": "是", "value": "y"},
                            {"label": "否", "value": "n"}
                        ]
                    },
                    {
                        "type": "submit",
                        "label": "查询",
                        "level": "primary",
                        "icon": "fa fa-search"
                    }
                ]
            },
            "headerToolbar": [
                {
                    "type": "button",
                    "label": "新增",
                    "icon": "fa fa-plus",
                    "className": "cxgzkz-toolbar-btn",
                    "level": "primary",
                    "actionType": "dialog",
                    "dialog": {
                        "title": "新增程序控制规则",
                        "size": "md",
                        "body": {
                            "type": "form",
                            "api": "post:${rule_save_api}",
                            "body": [
                                {
                                    "type": "select",
                                    "name": "sxbh",
                                    "label": "事项名称",
                                    "required": true,
                                    "placeholder": "请输入事项名称关键字联想查询",
                                    "searchable": true,
                                    "source": {
                                        "method": "post",
                                        "url": "${matter_subject_api}",
                                        "data": {
                                            "matterSubjectName": ""
                                        }
                                    },
                                    "autoComplete": {
                                        "method": "post",
                                        "url": "${matter_subject_api}",
                                        "data": {
                                            "matterSubjectName": "${term}"
                                        }
                                    },
                                    "labelField": "label",
                                    "valueField": "value"
                                },
                                {
                                    "type": "input-text",
                                    "name": "gzmc",
                                    "label": "程序控制规则名称",
                                    "required": true,
                                    "placeholder": "请输入规则名称"
                                },
                                {
                                    "type": "textarea",
                                    "name": "gztsy",
                                    "label": "程序控制规则提示语",
                                    "placeholder": "请输入提示语内容",
                                    "minRows": 3,
                                    "disabledOn": "${env_mode !== 'rd' && sfyxtztsy === 'n'}"
                                },
                                {
                                    "type": "select",
                                    "name": "sfqy",
                                    "label": "是否启用",
                                    "value": "y",
                                    "disabledOn": "${env_mode !== 'rd' && sfyxtqy === 'n'}",
                                    "options": [
                                        {"label": "是", "value": "y"},
                                        {"label": "否", "value": "n"}
                                    ]
                                },
                                {
                                    "type": "select",
                                    "name": "sfyxtqy",
                                    "label": "是否允许停启用",
                                    "value": "y",
                                    "visibleOn": "${env_mode === 'rd'}",
                                    "options": [
                                        {"label": "是", "value": "y"},
                                        {"label": "否", "value": "n"}
                                    ]
                                },
                                {
                                    "type": "select",
                                    "name": "sfyxtztsy",
                                    "label": "是否允许调整提示语",
                                    "value": "y",
                                    "visibleOn": "${env_mode === 'rd'}",
                                    "options": [
                                        {"label": "是", "value": "y"},
                                        {"label": "否", "value": "n"}
                                    ]
                                }
                            ]
                        }
                    }
                },
                {
                    "type": "button",
                    "label": "导入",
                    "className": "cxgzkz-toolbar-btn",
                    "level": "primary",
                    "actionType": "dialog",
                    "dialog": {
                        "title": "导入程序控制规则",
                        "body": {
                            "type": "form",
                            "api": {
                                "method": "post",
                                "url": "${rule_import_api}",
                                "dataType": "form-data"
                            },
                            "onEvent": {
                                "submitSucc": {
                                    "actions": [
                                        {
                                            "actionType": "reload",
                                            "componentId": "main_crud"
                                        }
                                    ]
                                }
                            },
                            "body": [
                                {
                                    "type": "input-file",
                                    "name": "file",
                                    "label": "选择CSV文件",
                                    "accept": ".csv",
                                    "asBlob": true,
                                    "required": true
                                }
                            ]
                        }
                    }
                },
                {
                    "type": "button",
                    "label": "导出",
                    "className": "cxgzkz-toolbar-btn",
                    "level": "default",
                    "actionType": "download",
                    "reload": "none",
                    "api": {
                        "method": "post",
                        "url": "${rule_export_api}",
                        "data": {
                            "ids": "${_selectedIds}"
                        },
                        "responseType": "blob"
                    },
                    "tooltip": "已勾选则导出勾选项，未勾选则导出全部"
                },
                "bulkActions"
            ],
            "onEvent": {
                "selectedChange": {
                    "actions": [
                        {
                            "actionType": "setValue",
                            "componentId": "main_filter_form",
                            "args": {
                                "value": {
                                    "_selectedIds": "${event.data.selectedItems|pick:id|join}"
                                }
                            }
                        }
                    ]
                }
            },
            "footerToolbar": ["switch-per-page", "pagination", "statistics"],
            "columns": [
                {
                    "name": "sxbh",
                    "label": "事项名称",
                    "type": "tpl",
                    "tpl": "${sxmc || sxbh}"
                },
                {
                    "name": "gzmc",
                    "label": "程序控制规则名称"
                },
                {
                    "name": "gztsy",
                    "label": "程序控制规则提示语"
                },
                {
                    "name": "sfqy",
                    "label": "是否启用",
                    "type": "mapping",
                    "map": {
                        "y": "<span class='label label-success'>是</span>",
                        "n": "<span class='label label-danger'>否</span>",
                        "*": "${sfqy}"
                    }
                },
                {
                    "name": "sfyxtqy",
                    "label": "是否允许停启用",
                    "type": "mapping",
                    "map": {
                        "y": "<span class='label label-success'>是</span>",
                        "n": "<span class='label label-danger'>否</span>",
                        "*": "${sfyxtqy}"
                    }
                },
                {
                    "name": "sfyxtztsy",
                    "label": "是否允许调整提示语",
                    "type": "mapping",
                    "map": {
                        "y": "<span class='label label-success'>是</span>",
                        "n": "<span class='label label-danger'>否</span>",
                        "*": "${sfyxtztsy}"
                    }
                },
                {
                    "type": "operation",
                    "label": "操作",
                    "buttons": [
                        {
                            "type": "button",
                            "label": "调整",
                            "icon": "fa fa-edit",
                            "level": "link",
                            "actionType": "dialog",
                            "dialog": {
                                "title": "调整程序控制规则",
                                "size": "md",
                                "body": {
                                    "type": "form",
                                    "api": "post:${rule_save_api}",
                                    "initApi": "post:{{ GLOBAL_API_PREFIX }}/cxgzkz/get?id=${id}",
                                    "body": [
                                        {
                                            "type": "hidden",
                                            "name": "id"
                                        },
                                        {
                                            "type": "select",
                                            "name": "sxbh",
                                            "label": "事项名称",
                                            "required": true,
                                            "placeholder": "请输入事项名称关键字联想查询",
                                            "searchable": true,
                                            "source": {
                                                "method": "post",
                                                "url": "${matter_subject_api}",
                                                "data": {
                                                    "matterSubjectName": ""
                                                }
                                            },
                                            "autoComplete": {
                                                "method": "post",
                                                "url": "${matter_subject_api}",
                                                "data": {
                                                    "matterSubjectName": "${term}"
                                                }
                                            },
                                            "labelField": "label",
                                            "valueField": "value"
                                        },
                                        {
                                            "type": "static",
                                            "name": "gzmc",
                                            "label": "程序控制规则名称"
                                        },
                                        {
                                            "type": "textarea",
                                            "name": "gztsy",
                                            "label": "程序控制规则提示语",
                                            "placeholder": "请输入提示语内容",
                                            "minRows": 3,
                                            "disabledOn": "${env_mode !== 'rd' && sfyxtztsy === 'n'}"
                                        },
                                        {
                                            "type": "select",
                                            "name": "sfqy",
                                            "label": "是否启用",
                                            "options": [
                                                {"label": "是", "value": "y"},
                                                {"label": "否", "value": "n"}
                                            ],
                                            "disabledOn": "${env_mode !== 'rd' && sfyxtqy === 'n'}"
                                        },
                                        {
                                            "type": "select",
                                            "name": "sfyxtqy",
                                            "label": "是否允许停启用",
                                            "visibleOn": "${env_mode === 'rd'}",
                                            "options": [
                                                {"label": "是", "value": "y"},
                                                {"label": "否", "value": "n"}
                                            ]
                                        },
                                        {
                                            "type": "select",
                                            "name": "sfyxtztsy",
                                            "label": "是否允许调整提示语",
                                            "visibleOn": "${env_mode === 'rd'}",
                                            "options": [
                                                {"label": "是", "value": "y"},
                                                {"label": "否", "value": "n"}
                                            ]
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "type": "button",
                            "label": "删除",
                            "icon": "fa fa-trash",
                            "actionType": "ajax",
                            "api": "post:${rule_delete_api}?id=${id}",
                            "confirmText": "确定要删除这条规则吗？",
                            "level": "link",
                            "className": "text-danger"
                        }
                    ]
                }
            ]
        }
    ]
}
