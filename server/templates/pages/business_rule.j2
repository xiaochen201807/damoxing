                                                        "actions": [
                                                            {
                                                                "actionType": "ajax",
                                                                "api": {
                                                                    "method": "post",
                                                                    "url": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_case/get",
                                                                    "data": {
                                                                        "id": "${selectedCaseId}"
                                                                    },
                                                                    "adaptor": "return payload.data || payload || {};"
                                                                },
                                                                "outputVar": "debugCaseRes"
                                                            },
                                                            {
                                                                "actionType": "setValue",
                                                                "componentId": "debug_form_component",
