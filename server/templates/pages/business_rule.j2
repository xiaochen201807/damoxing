                                                            "method": "post",
                                                            "url": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_log",
                                                                "data": {
                                                                    "pcid": "${pcid}",
                                                                    "ywsf": "${ywsf}"
                                                                }
                                                            },
