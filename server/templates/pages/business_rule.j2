                                        "clearable": true,
                                        "searchable": true,
                                        "source": {
                                            "method": "post",
                                            "url": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_case/list",
                                            "data": {
                                                "ywsf": "${ywsf}",
                                                "ywnrfl": "${ywnrfl}"
                                            }
                                        },
                                        "description": "案例会按当前算法和业务内容分类过滤。"
                                    },
                                    {
                                        "type": "group",
                                        "body": [
                                            {
                                                "type": "button",
                                                "label": "自动生成入参",
                                                "level": "default",
                                                "onEvent": {
                                                    "click": {
                                                        "actions": [
                                                            {
                                                                "actionType": "ajax",
                                                                "api": {
                                                                    "method": "post",
                                                                    "url": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_template",
                                                                    "data": {
                                                                        "ywsf": "${ywsf}",
                                                                        "ywnrfl": "${ywnrfl}"
                                                                    },
                                                                    "adaptor": "var data = payload.data || payload || {}; var template = data.template || {}; return Object.assign({}, template, data);"
                                                                },
                                                                "outputVar": "debugTemplateRes"
                                                            },
                                                            {
                                                                "actionType": "setValue",
                                                                "componentId": "debug_form_component",
                                                                "args": {
                                                                    "value": {
                                                                        "debugInput": "${debugTemplateRes.debugInput}",
                                                                        "debugTemplateTip": "${debugTemplateRes.debugTemplateTip || debugTemplateRes.tip}",
                                                                        "debugDispatchTip": "${debugTemplateRes.debugDispatchTip}",
                                                                        "debugOutput": "",
                                                                        "pcid": "",
                                                                        "selectedCaseId": ""
                                                                    }
                                                                }
                                                            }
                                                        ]
                                                    }
                                                }
                                            },
                                            {
                                                "type": "button",
