{
    "type": "page",
    "title": "关键数据计算模型",
    "css": {
        ".premium-card": {
            "boxShadow": "0 4px 20px rgba(0,0,0,0.08)",
            "borderRadius": "12px",
            "overflow": "hidden"
        },
        ".page-header-gradient": {
            "background": "linear-gradient(90deg, #1890ff 0%, #096dd9 100%)",
            "padding": "16px 24px",
            "color": "#fff",
            "marginBottom": "0px",
            "borderRadius": "12px 12px 0 0"
        },
        ".wider-select .cxd-Select": {
            "minWidth": "350px"
        }
    },
    "data": {
        "rule_list_api": "{{ GLOBAL_API_PREFIX }}/ywbz/list",
        "rule_save_api": "{{ GLOBAL_API_PREFIX }}/ywbz/save",
        "rule_delete_api": "{{ GLOBAL_API_PREFIX }}/ywbz/delete",
        "rule_batch_api": "{{ GLOBAL_API_PREFIX }}/ywbz/batch",
        "ywbzk_list_api": "{{ GLOBAL_API_PREFIX }}/ywbzk/list",
        "rule_import_api": "{{ rule_import_api | default(GLOBAL_API_PREFIX + '/ywbz/import') }}",
        "rule_export_api": "{{ rule_export_api | default(GLOBAL_API_PREFIX + '/ywbz/export') }}",
        "rule_partial_export_api": "{{ GLOBAL_API_PREFIX }}/ywbz/partial_export",
        "rule_partial_import_api": "{{ GLOBAL_API_PREFIX }}/ywbz/partial_import",
        "rule_debug_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug",
        "rule_debug_template_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_template",
        "rule_debug_log_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_log",
        "rule_debug_case_list_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_case/list",
        "rule_debug_case_get_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_case/get",
        "rule_debug_case_save_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_case/save",
        "algorithm_options_api": "{{ GLOBAL_API_PREFIX }}/tools/business-algorithms",
        "algorithm_options": [],
        "standard_class_options": [
            { "label": "缴存人账户余额", "value": "1" },
            { "label": "冻结金额", "value": "2" },
            { "label": "账户保留金额", "value": "3" },
            { "label": "材料提取限额", "value": "4" },
            { "label": "累计提取金额", "value": "5" },
            { "label": "精度值", "value": "6" },
            { "label": "保留方式", "value": "7" },
            { "label": "在途提取金额", "value": "8" }
        ],
        "handle_class_options": [
            { "label": "标准", "value": "1" },
            { "label": "条件", "value": "2" }
        ],
        "business_content_class_api": "{{ business_content_class_api | default(GLOBAL_API_PREFIX + '/tools/business-content-classes') }}",
        "business_content_class_params": {{ business_content_class_params | default({}) | fromjson | tojson }},
        "business_standard_value_api": "{{ business_standard_value_api | default(GLOBAL_API_PREFIX + '/tools/business-standard-values') }}",
        "business_standard_value_params": {{ business_standard_value_params | default({}) | fromjson | tojson }},
        "service_objects_api": "{{ service_objects_api | default(GLOBAL_API_PREFIX + '/tools/service-objects') }}",
        "service_objects_params": {{ service_objects_params | default({}) | fromjson | tojson }},
        "business_standard_attribute_api": "{{ business_standard_attribute_api | default(GLOBAL_API_PREFIX + '/tools/business-standard-attributes') }}",
        "business_standard_attribute_params": {{ business_standard_attribute_params | default({}) | fromjson | tojson }},
        "selection_policy_ai_enabled": {{ selection_policy_ai_enabled | default(true) | tojson }},
        "selection_policy_ai_api": "{{ selection_policy_ai_api | default(GLOBAL_API_PREFIX + '/ywbz/selection_ai_apply') }}",
        "selection_policy_ai_workflow_type": "{{ selection_policy_ai_workflow_type | default('ai_analysis') }}",
        "selection_policy_ai_button_text": "{{ selection_policy_ai_button_text | default('AI政策分析') }}",
        "selection_policy_ai_prompt": {{ selection_policy_ai_prompt | default('请结合政策文本、当前算法、业务内容分类、候选业务办理标准列表与已选规则，筛选最匹配的业务办理标准。仅返回最终应勾选的标准 ID 列表，并尽量附带简短说明。') | tojson }}
    },
    "body": [
        {
            "type": "service",
            "api": {
                "method": "get",
                "url": "${algorithm_options_api}",
                "adaptor": "var data = payload.data || payload.options || payload; var list = []; if (Array.isArray(data)) { list = data; } else if (data && Array.isArray(data.options)) { list = data.options; } else if (data && Array.isArray(data.rows)) { list = data.rows; } return { algorithm_options: list };"
            },
            "body": [
                {
                    "type": "service",
                    "api": {
                        "method": "post",
                        "url": "${business_content_class_api}",
                        "data": "${business_content_class_params}",
                        "adaptor": "var data = payload.data || payload.options || payload; var list = []; if (Array.isArray(data)) { list = data; } else if (data && Array.isArray(data.options)) { list = data.options; } else if (data && Array.isArray(data.rows)) { list = data.rows; } return { class_options: list };"
                    },
                    "body": [
                        {
                            "id": "main_crud",
            "type": "crud",
            "columnsTogglable": false,
            "selectable": true,
            "multiple": true,
            "keepItemSelectionOnPageChange": true,
            "primaryField": "id",
            "api": "post:${rule_list_api}",
            "className": "premium-card",
            "filter": {
                "id": "main_filter_form",
                "title": "",
                "submitText": "",
                "type": "form",
                "mode": "inline",
                "wrapWithPanel": false,
                "className": "p-4",
                "body": [
                    {
                        "type": "select",
                        "id": "main_rule_algorithm_select",
                        "name": "ywsf",
                        "label": "关键数据算法",
                        "placeholder": "请选择",
                        "source": "${algorithm_options}",
                        "clearable": true,
                        "onEvent": {
                            "change": {
                                "actions": [
                                    {
                                        "actionType": "setValue",
                                        "componentId": "main_filter_form",
                                        "args": {
                                            "value": {
                                                "ywnrfl": ""
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "select",
                        "id": "main_rule_business_content_class_select",
                        "name": "ywnrfl",
                        "label": "业务内容分类",
                        "placeholder": "请选择",
                        "className": "wider-select",
                        "clearValueOnOptionsChange": true,
                        "source": {
                            "method": "post",
                            "url": "${business_content_class_api}",
                            "data": {
                                "&": "${business_content_class_params}",
                                "gjsjsf": "${ywsf}"
                            },
                            "trackExpression": "${ywsf}"
                        },
                        "clearable": true,
                        "disabledOn": "${!ywsf}"
                    },
                    {
                        "type": "button",
                        "icon": "fa fa-check",
                        "level": "link",
                        "className": "p-2 mr-4",
                        "disabledOn": "${!ywsf || (ywsf == '1' && !ywnrfl)}",
                        "tooltip": "请先选择关键数据算法（最大可提取额还需选择业务内容分类）",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "清册选择",
                            "size": "lg",
                            "data": {
                                "syncIds": "",
                                "ywsf": "${ywsf}",
                                "ywnrfl": "${ywnrfl}",
                                "selection_policy_ai_button_text": "${selection_policy_ai_button_text}",
                                "selection_policy_ai_enabled": "${selection_policy_ai_enabled}"
                            },
                            "body": {
                                "id": "selection_form",
                                "type": "form",
                                "api": {
                                    "method": "post",
                                    "url": "{{ GLOBAL_API_PREFIX }}/ywbz/batch",
                                    "data": {
                                        "ids": "${syncIds}",
                                         "ywsf": "${ywsf}",
                                         "ywnrfl": "${ywnrfl}"
                                    }
                                },
                                "onEvent": {
                                    "submitSucc": {
                                        "actions": [
                                            {
                                                "actionType": "reload",
                                                "componentId": "main_crud"
                                            }
                                        ]
                                    }
                                },
                                "body": [
                                    {
                                        "type": "alert",
                                        "level": "info",
                                        "showIcon": true,
                                        "className": "mb-3",
                                        "visibleOn": "${ywsf == '1'}",
                                        "body": [
                                            {
                                                "type": "tpl",
                        "tpl": "<b>最大可提取额算法说明</b><br/><span style='font-size:12px;color:#666;'>最大可提取额数据算法是一套结合提取内容、账户余额、冻结金额、账户保留金额、材料提取限额、累计提取金额、在途提取金额、计算精度等业务标准分类的动态标准计算模型，核心逻辑为：先根据提取内容（如购房、租房、还贷、离退休等）匹配对应的政策约束的材料提取限额（如购房不超过房款总额、租房不超过当地月度限额或实际租金、还贷不超过当期还款本息、离退休可全额提取），再与个人公积金账户当前可用余额（账户余额-冻结金额-账户保留金额）取最小值，最终得出的金额按计算精度计算后即为当前场景下可提取的最高额度。</span><br/><span style='font-size:12px;color:#999;'>执行路径说明：统一入口过程当前按 <code>ywsf=1</code> 进入对应算法分支；后续拆分建议子过程命名为 <code>p_gjj_get_mxywsfz_ywsf_1</code>。</span>"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "alert",
                                        "level": "info",
                                        "showIcon": true,
                                        "className": "mb-3",
                                        "visibleOn": "${ywsf == '2'}",
                                        "body": [
                                            {
                                                "type": "tpl",
                        "tpl": "<b>最高可贷金额算法说明</b><br/><span style='font-size:12px;color:#666;'>最高可贷金额数据算法是一套多维度取低的综合计算模型，核心逻辑为：分别通过&ldquo;账户余额×缴存倍数（通常15-25倍）、家庭月收入×还贷能力系数（多为40%-60%）测算的年还贷能力×贷款年限、房屋总价扣除首付后的剩余金额、当地单/双缴存人家庭贷款最高限额；同时可根据缴存时间、公积金流动性等动态系数调整，叠加人才、多子女家庭等上浮规则&rdquo;等组合维度算出基础额度，最终取所有限制条件下的最小值作为可贷上限，最终得出的金额按计算精度计算后即为当前场景下可贷款的最高额度。</span><br/><span style='font-size:12px;color:#999;'>执行路径说明：统一入口过程当前按 <code>ywsf=2</code> 进入对应算法分支；后续拆分建议子过程命名为 <code>p_gjj_get_mxywsfz_ywsf_2</code>。</span>"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "alert",
                                        "level": "info",
                                        "showIcon": true,
                                        "className": "mb-3",
                                        "visibleOn": "${ywsf == '3'}",
                                        "body": [
                                            {
                                                "type": "tpl",
                        "tpl": "<b>最高可贷年限算法说明</b><br/><span style='font-size:12px;color:#666;'>最高可贷年限数据算法是一套多维度取低的综合计算模型，核心逻辑为：分别通过【按借款人年龄算出&ldquo;法定退休年龄+贷款年限延长至退休年龄后X年-申请年龄&rdquo;的年限上限，二手房需额外计算&ldquo;当地规定的房龄+贷款年限总和上限（多为40-50年）-现有房龄&rdquo;的房龄限制年限，再与房屋类型对应的最高年限（新房最长30年、二手房部分城市最长20年）】计算后取最小值，夫妻共同贷款通常按年龄较长一方核算，最终结果向下取整为整年。</span><br/><span style='font-size:12px;color:#999;'>执行路径说明：统一入口过程当前按 <code>ywsf=3</code> 进入对应算法分支；后续拆分建议子过程命名为 <code>p_gjj_get_mxywsfz_ywsf_3</code>。</span>"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "alert",
                                        "level": "info",
                                        "showIcon": true,
                                        "className": "mb-3",
                                        "visibleOn": "${ywsf == '4'}",
                                        "body": [
                                            {
                                                "type": "tpl",
                        "tpl": "<b>借款人最大可对冲支取金额算法说明</b><br/><span style='font-size:12px;color:#666;'>借款人最大可对冲支取金额数据算法采用&ldquo;多限制取低+累计扣减&rdquo;规则计算，核心逻辑为：先按对冲类型匹配上限（按月对冲不超过当月应还贷款本息额、按年对冲不超过当年/12个月应还本息总额、一次性冲本不超过剩余贷款本金），再减去历史累计已对冲支取金额，同时不超过借款人及共同对冲人公积金账户可用余额（账户余额-冻结金额-账户保留金额），三者取最小值即为本次可对冲支取的最高额度，部分城市支持叠加配偶、直系亲属的账户余额合并计算。</span><br/><span style='font-size:12px;color:#999;'>执行路径说明：统一入口过程当前按 <code>ywsf=4</code> 进入对应算法分支；后续拆分建议子过程命名为 <code>p_gjj_get_mxywsfz_ywsf_4</code>。</span>"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "crud",
                                        "api": {
                                            "method": "post",
                                            "url": "{{ GLOBAL_API_PREFIX }}/ywbz/selection_list",
                                            "data": {
                                                "gjsjsf": "${ywsf}",
                                                "ywnrfl": "${ywnrfl}",
                                                "ywblbz": "${ywblbz}",
                                                "ywblbzsm": "${ywblbzsm}"
                                            }
                                        },
                                        "syncLocation": false,
                                        "id": "crud_selection_dialog",
                                        "mode": "table",
                                        "primaryField": "id",
                                        "selectable": true,
                                        "itemCheckableOn": "(typeof selectedItems !== 'undefined' ? selectedItems : []).some(function(item) { return item && typeof id !== 'undefined' && item.id == id; }) || !(typeof mutualIds !== 'undefined' ? mutualIds : []).some(function(mutualId) { return (typeof selectedItems !== 'undefined' ? selectedItems : []).some(function(item) { return item && item.id == mutualId; }); })",
                                        "multiple": true,
                                        "loadDataOnce": true,
                                        "filter": {
                                            "title": "",
                                            "submitText": "搜索",
                                            "type": "form",
                                            "mode": "inline",
                                            "wrapWithPanel": false,
                                            "className": "mb-3",
                                            "body": [
                                                {
                                                    "type": "input-text",
                                                    "name": "ywblbz",
                                                    "label": "业务办理标准",
                                                    "placeholder": "输入关键字搜索",
                                                    "clearable": true,
                                                    "size": "md"
                                                },
                                                {
                                                    "type": "input-text",
                                                    "name": "ywblbzsm",
                                                    "label": "业务办理标准描述",
                                                    "placeholder": "输入关键字搜索",
                                                    "clearable": true,
                                                    "size": "md"
                                                },
                                                {
                                                    "type": "submit",
                                                    "label": "搜索",
                                                    "level": "primary",
                                                    "icon": "fa fa-search"
                                                },
                                                {
                                                    "type": "reset",
                                                    "label": "重置"
                                                },
                                                {
                                                    "type": "button",
                                                    "label": "${selection_policy_ai_button_text}",
                                                    "level": "danger",
                                                    "visibleOn": "${selection_policy_ai_enabled !== false}",
                                                    "actionType": "dialog",
                                                    "dialog": {
                                                        "title": "AI政策分析",
                                                        "size": "md",
                                                        "body": {
                                                            "type": "form",
                                                            "id": "selection_ai_policy_form",
                                                            "api": {
                                                                "method": "post",
                                                                "url": "{{ selection_policy_ai_api | default(GLOBAL_API_PREFIX + '/ywbz/selection_ai_apply') }}",
                                                                "data": {
                                                                    "pageId": "{{ page_key | default('business_rule') }}",
                                                                    "page_key": "{{ page_key | default('business_rule') }}",
                                                                    "workflow_type": "{{ selection_policy_ai_workflow_type | default('ai_analysis') }}",
                                                                    "analysis_prompt": {{ selection_policy_ai_prompt | default('请结合政策文本、当前算法、业务内容分类、候选业务办理标准列表与已选规则，筛选最匹配的业务办理标准。仅返回最终应勾选的标准 ID 列表，并尽量附带简短说明。') | tojson }},
                                                                    "policy_text": "${policy_text}",
                                                                    "ywsf": "${ywsf}",
                                                                    "ywnrfl": "${ywnrfl}",
                                                                    "ywblbz": "${ywblbz}",
                                                                    "ywblbzsm": "${ywblbzsm}"
                                                                }
                                                            },
                                                            "onEvent": {
                                                                "submitSucc": {
                                                                    "actions": [
                                                                        {
                                                                            "actionType": "custom",
                                                                            "script": "const scope = event.data || {}; const payload = scope.responseData || scope.responseResult || scope.result || scope; const selectedIds = payload.selectedIds || (payload.data && payload.data.selectedIds) || scope.selectedIds || []; const ids = Array.isArray(selectedIds) ? selectedIds : []; console.log('🚀🚀🚀 [Amis AI Selection] TRIGGERED 🚀🚀🚀'); console.log('📦 Payload:', payload); console.log('🎯 Computed IDs:', ids); event.setData(Object.assign({}, scope, { mappedItems: ids.map(id => ({id: Number(id)})), exportSyncIds: ids.join(','), exportSelectedIds: ids }));"
                                                                        },
                                                                        {
                                                                            "actionType": "setValue",
                                                                            "componentId": "selection_form",
                                                                            "args": {
                                                                                "value": {
                                                                                    "syncIds": "${exportSyncIds}",
                                                                                    "selectedIds": "${exportSelectedIds}"
                                                                                }
                                                                            }
                                                                        },
                                                                        {
                                                                            "actionType": "clear",
                                                                            "componentId": "crud_selection_dialog"
                                                                        },
                                                                        {
                                                                            "actionType": "setValue",
                                                                            "componentId": "crud_selection_dialog",
                                                                            "args": {
                                                                                "value": {
                                                                                    "selectedItems": "${mappedItems}"
                                                                                }
                                                                            }
                                                                        },
                                                                        {
                                                                            "actionType": "select",
                                                                            "componentId": "crud_selection_dialog",
                                                                            "delay": 100,
                                                                            "args": {
                                                                                "condition": "${ARRAYINCLUDES(selectedIds, id) || ARRAYINCLUDES(selectedIds, id * 1) || ARRAYINCLUDES(selectedIds, id + '')}"
                                                                            }
                                                                        }
                                                                    ]
                                                                }
                                                            },
                                                            "body": [
                                                                {
                                                                    "type": "alert",
                                                                    "level": "info",
                                                                    "showIcon": true,
                                                                    "body": "输入政策文本后，系统会结合当前算法、业务内容分类、候选业务办理标准和已选结果发起 AI 分析，并自动同步勾选结果。"
                                                                },
                                                                {
                                                                    "type": "textarea",
                                                                    "name": "policy_text",
                                                                    "label": "政策文本",
                                                                    "placeholder": "请输入需要分析的政策内容",
                                                                    "minRows": 8,
                                                                    "maxRows": 16,
                                                                    "required": true,
                                                                    "clearable": true
                                                                }
                                                            ]
                                                        },
                                                        "actions": [
                                                            {
                                                                "type": "button",
                                                                "label": "取消",
                                                                "actionType": "close"
                                                            },
                                                            {
                                                                "type": "button",
                                                                "label": "开始分析",
                                                                "level": "primary",
                                                                "actionType": "submit"
                                                            }
                                                        ]
                                                    }
                                                }
                                            ]
                                        },
                                        "onEvent": {
                                            "fetchInited": {
                                                "actions": [
                                                    {
                                                        "actionType": "custom",
                                                        "expression": "!this.initedSelection",
                                                        "script": "const scope = event.data || {}; const payload = scope.responseData || scope.responseResult || scope.result || scope; const selectedIds = payload.selectedIds || (payload.data && payload.data.selectedIds) || scope.selectedIds || []; const ids = Array.isArray(selectedIds) ? selectedIds : []; console.log('🚀🚀🚀 [Amis Inited Selection] TRIGGERED 🚀🚀🚀'); console.log('📦 Payload:', payload); console.log('🎯 Computed IDs:', ids); event.setData(Object.assign({}, scope, { mappedItems: ids.map(id => ({id: Number(id)})), exportSyncIds: ids.join(','), exportSelectedIds: ids }));"
                                                    },
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "selection_form",
                                                        "expression": "!this.initedSelection",
                                                        "args": {
                                                            "value": {
                                                                "initedSelection": true,
                                                                "syncIds": "${exportSyncIds}",
                                                                "selectedIds": "${exportSelectedIds}"
                                                            }
                                                        }
                                                    },
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "crud_selection_dialog",
                                                        "expression": "!this.initedSelection && mappedItems",
                                                        "args": {
                                                            "value": {
                                                                "selectedItems": "${mappedItems}"
                                                            }
                                                        }
                                                    },
                                                    {
                                                        "actionType": "select",
                                                        "componentId": "crud_selection_dialog",
                                                        "expression": "!this.initedSelection",
                                                        "delay": 100,
                                                        "args": {
                                                            "condition": "${ARRAYINCLUDES(selectedIds, id) || ARRAYINCLUDES(selectedIds, id * 1) || ARRAYINCLUDES(selectedIds, id + '')}"
                                                        }
                                                    }
                                                ]
                                            },
                                            "selectedChange": {
                                                "actions": [
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "selection_form",
                                                        "args": {
                                                            "value": {
                                                                "syncIds": "${event.data.selectedItems | pick:id | join}"
                                                            }
                                                        }
                                                    }
                                                ]
                                            }
                                        },
                                        "keepItemSelectionOnPageChange": true,
