                            "body": {
                                "type": "form",
                                "id": "debug_form_component",
                                "title": "",
                                "mode": "normal",
                                "initApi": {
                                    "method": "post",
                                    "url": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_template",
                                    "data": {
                                        "ywsf": "${ywsf}",
                                        "ywnrfl": "${ywnrfl}"
                                    },
                                    "adaptor": "var data = payload.data || payload || {}; var template = data.template || {}; return Object.assign({}, template, data);"
                                },
                                "body": [
                                    {
                                        "type": "hidden",
                                        "name": "ywsf"
                                    },
                                    {
                                        "type": "hidden",
                                        "name": "ywnrfl"
                                    },
                                    {
                                        "type": "hidden",
                                        "name": "pcid"
                                    },
                                    {
                                        "type": "alert",
                                        "level": "info",
                                        "showIcon": true,
                                        "body": "当前调试条件：关键数据算法=${ywsf || '-'}，业务内容分类=${ywnrfl || '-'}。打开弹窗时会自动生成基础调试模板，也可手工修改后再调试。"
                                    },
                                    {
                                        "type": "alert",
                                        "level": "warning",
                                        "showIcon": true,
                                        "body": "${debugDispatchTip || '当前仍通过统一入口执行，未选择关键数据算法时不会进入具体算法分支。'}"
                                    },
                                    {
                                        "type": "select",
                                        "id": "debug_case_select",
                                        "name": "selectedCaseId",
