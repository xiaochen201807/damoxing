{
    "type": "page",
    "title": "关键数据计算模型",
    "css": {
        ".premium-card": {
            "boxShadow": "0 4px 20px rgba(0,0,0,0.08)",
            "borderRadius": "12px",
            "overflow": "hidden"
        },
        ".page-header-gradient": {
            "background": "linear-gradient(90deg, #1890ff 0%, #096dd9 100%)",
            "padding": "16px 24px",
            "color": "#fff",
            "marginBottom": "0px",
            "borderRadius": "12px 12px 0 0"
        }
    },
    "data": {
        "rule_list_api": "{{ GLOBAL_API_PREFIX }}/ywbz/list",
        "rule_save_api": "{{ GLOBAL_API_PREFIX }}/ywbz/save",
        "rule_delete_api": "{{ GLOBAL_API_PREFIX }}/ywbz/delete",
        "rule_batch_api": "{{ GLOBAL_API_PREFIX }}/ywbz/batch",
        "ywbzk_list_api": "{{ GLOBAL_API_PREFIX }}/ywbzk/list",
        "rule_import_api": "{{ GLOBAL_API_PREFIX }}/ywbz/import",
        "rule_export_api": "{{ GLOBAL_API_PREFIX }}/ywbz/export",
        "algorithm_options": [
            { "label": "可提取金额", "value": "ktqje" },
            { "label": "可贷款金额", "value": "kdkje" },
            { "label": "可贷款年限", "value": "kdknx" },
            { "label": "贷款还款时可对冲金额", "value": "dkhkskdcje" }
        ],
        "business_content_class_api": "{{ GLOBAL_API_PREFIX | default('/api') }}/tools/business-content-classes",
        "business_content_class_params": {}
    },
    "body": [
        {
            "id": "main_crud",
            "type": "crud",
            "api": "post:${rule_list_api}",
            "className": "premium-card",
            "filter": {
                "title": "",
                "submitText": "",
                "type": "form",
                "mode": "inline",
                "wrapWithPanel": false,
                "className": "p-4",
                "body": [
                    {
                        "type": "select",
                        "name": "ywsf",
                        "label": "关键数据算法",
                        "placeholder": "请选择",
                        "source": "${algorithm_options}",
                        "clearable": true
                    },
                    {
                        "type": "select",
                        "name": "ywnrfl",
                        "label": "业务内容分类",
                        "placeholder": "请选择",
                        "source": {
                            "method": "post",
                            "url": "${business_content_class_api}",
                            "data": "${business_content_class_params}"
                        },
                        "clearable": true
                    },
                    {
                        "type": "button",
                        "icon": "fa fa-check",
                        "level": "link",
                        "className": "p-2 mr-4",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "清册选择",
                            "size": "lg",
                            "data": {
                                "jgbh": "${jgbh}",
                                "zjgbh": "${zjgbh}",
                                "syncIds": ""
                            },
                            "body": {
                                "id": "selection_form",
                                "type": "form",
                                "api": {
                                    "method": "post",
                                    "url": "{{ GLOBAL_API_PREFIX }}/ywbz/batch",
                                    "data": {
                                        "ids": "${syncIds}",
                                        "jgbh": "${jgbh}",
                                        "zjgbh": "${zjgbh}"
                                    }
                                },
                                "onEvent": {
                                    "submitSucc": {
                                        "actions": [
                                            {
                                                "actionType": "reload",
                                                "componentId": "main_crud"
                                            }
                                        ]
                                    }
                                },
                                "body": [
                                    { "type": "hidden", "name": "jgbh" },
                                    { "type": "hidden", "name": "zjgbh" },
                                    {
                                        "type": "crud",
                                        "api": {
                                            "method": "post",
                                            "url": "{{ GLOBAL_API_PREFIX }}/ywbz/selection_list",
                                            "data": {
                                                "gjsjsf": "${ywsf}",
                                                "ywnrfl": "${ywnrfl}",
                                                "jgbh": "${jgbh}",
                                                "zjgbh": "${zjgbh}"
                                            }
                                        },
                                        "syncLocation": false,
                                        "id": "crud_selection_dialog",
                                        "mode": "table",
                                        "primaryField": "id",
                                        "selectable": true,
                                        "multiple": true,
                                        "onEvent": {
                                            "fetchInited": {
                                                "actions": [
                                                    {
                                                        "actionType": "select",
                                                        "componentId": "crud_selection_dialog",
                                                        "args": {
                                                            "condition": "${checked === true}"
                                                        }
                                                    },
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "selection_form",
                                                        "args": {
                                                            "value": {
                                                                "syncIds": "${event.data.responseData.items | filter:checked:true | pick:id | join}"
                                                            }
                                                        }
                                                    }
                                                ]
                                            },
                                            "selectedChange": {
                                                "actions": [
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "selection_form",
                                                        "args": {
                                                            "value": {
                                                                "syncIds": "${event.data.selectedItems | pick:id | join}"
                                                            }
                                                        }
                                                    }
                                                ]
                                            }
                                        },
                                        "keepItemSelectionOnPageChange": true,
                                        "headerToolbar": [
                                            "statistics"
                                        ],
                                        "footerToolbar": [
                                            "switch-per-page", 
                                            "pagination",
                                            "statistics"
                                        ],
                                        "columns": [
                                            {
                                                "name": "ywblbz",
                                                "label": "业务办理标准"
                                            }
                                        ]
                                    }
                                ]
                            },
                            "actions": [
                                {
                                    "type": "button",
                                    "label": "关闭",
                                    "actionType": "close"
                                },
                                {
                                    "type": "button",
                                    "label": "保存",
                                    "level": "primary",
                                    "actionType": "submit"
                                }
                            ]
                        }
                    },
                    {
                        "type": "submit",
                        "label": "查询",
                        "level": "primary"
                    },
                    {
                        "type": "button",
                        "label": "全量导入",
                        "level": "primary",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "全量导入业务规则",
                            "body": {
                                "type": "form",
                                "api": {
                                    "method": "post",
                                    "url": "${rule_import_api}",
                                    "dataType": "form-data"
                                },
                                "body": [
                                    {
                                        "type": "input-file",
                                        "name": "file",
                                        "label": "选择CSV或SQL文件",
                                        "accept": ".csv,.sql",
                                        "asBlob": true,
                                        "required": true
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "button",
                        "label": "全量导出",
                        "level": "default",
                        "actionType": "download",
                        "api": {
                            "method": "post",
                            "url": "${rule_export_api}",
                            "responseType": "blob"
                        }
                    }
                ]
            },
            "headerToolbar": [
                "bulkActions"
            ],
            "footerToolbar": ["statistics", "pagination"],
            "columns": [
                {
                    "name": "ywsf",
                    "label": "关键数据算法",
                    "type": "mapping",
                    "map": {
                        "ktqje": "可提取金额",
                        "kdkje": "可贷款金额",
                        "kdknx": "可贷款年限",
                        "dkhkskdcje": "贷款还款时可对冲金额",
                        "*": "${ywsf}"
                    }
                },
                {
                    "name": "template_name",
                    "label": "业务办理标准"
                },
                {
                    "name": "ywbz",
                    "label": "业务标准描述说明"
                },
                {
                    "type": "operation",
                    "label": "操作",
                    "buttons": [
                        {
                            "type": "button",
                            "label": "规则参数配置",
                            "actionType": "drawer",
                            "level": "link",
                            "drawer": {
                                "title": "节点详细参数设置",
                                "size": "md",
                                "body": {
                                    "type": "service",
                                    "schemaApi": {
                                        "method": "post",
                                        "url": "{{ GLOBAL_API_PREFIX }}/ywbz/config_form",
                                        "dataType": "json",
                                        "data": {
                                            "id": "${id}",
                                            "mbid": "${mbid}"
                                        }
                                    }
                                }
                            }
                        },

                        {
                            "type": "button",
                            "label": "删除",
                            "actionType": "ajax",
                            "api": "post:${rule_delete_api}?id=${id}",
                            "confirmText": "确定要删除这条规则吗？",
                            "level": "danger"
                        }
                    ]
                }
            ]
        }
    ]
}
