                                                                    "value": {
                                                                        "debugInput": "${debugCaseRes.debugInput}",
                                                                        "debugTemplateTip": "已反显成功案例，可直接调试或按需调整参数。",
                                                                        "debugOutput": "",
                                                                        "pcid": ""
                                                                    }
                                                                }
                                                            }
                                                        ]
                                                    }
                                                }
                                            },
                                            {
                                                "type": "button",
