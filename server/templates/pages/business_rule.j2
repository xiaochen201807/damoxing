                        }
                    },
                    {
                        "type": "button",
                        "label": "部分导入",
                        "level": "default",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "部分导入业务规则（增量）",
                            "body": {
                                "type": "form",
                                "api": {
                                    "method": "post",
                                    "url": "${rule_partial_import_api}",
                                    "dataType": "form-data"
                                },
                                "onEvent": {
                                    "submitSucc": {
                                        "actions": [
                                            {
                                                "actionType": "reload",
                                                "componentId": "main_crud"
                                            }
                                        ]
                                    }
                                },
                                "body": [
                                    {
                                        "type": "alert",
                                        "level": "warning",
                                        "showIcon": true,
                                        "className": "mb-3",
                                        "body": "部分导入为增量模式，不会清空现有数据，仅执行文件中的 INSERT 语句。"
                                    },
                                    {
                                        "type": "input-file",
                                        "name": "file",
                                        "label": "选择CSV或SQL文件",
                                        "accept": ".csv,.sql",
