{
    "type": "page",
    "title": "关键数据计算模型",
    "css": {
        ".premium-card": {
            "boxShadow": "0 4px 20px rgba(0,0,0,0.08)",
            "borderRadius": "12px",
            "overflow": "hidden"
        },
        ".page-header-gradient": {
            "background": "linear-gradient(90deg, #1890ff 0%, #096dd9 100%)",
            "padding": "16px 24px",
            "color": "#fff",
            "marginBottom": "0px",
            "borderRadius": "12px 12px 0 0"
        },
        ".wider-select .cxd-Select": {
            "minWidth": "350px"
        }
    },
    "data": {
        "rule_list_api": "{{ GLOBAL_API_PREFIX }}/ywbz/list",
        "rule_save_api": "{{ GLOBAL_API_PREFIX }}/ywbz/save",
        "rule_delete_api": "{{ GLOBAL_API_PREFIX }}/ywbz/delete",
        "rule_batch_api": "{{ GLOBAL_API_PREFIX }}/ywbz/batch",
        "ywbzk_list_api": "{{ GLOBAL_API_PREFIX }}/ywbzk/list",
        "rule_import_api": "{{ rule_import_api | default(GLOBAL_API_PREFIX + '/ywbz/import') }}",
        "rule_export_api": "{{ rule_export_api | default(GLOBAL_API_PREFIX + '/ywbz/export') }}",
        "rule_debug_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug",
        "rule_debug_log_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_log",
        "algorithm_options": {{ algorithm_options | default([{"label":"最大可提取额","value":"1"},{"label":"最高可贷金额","value":"2"},{"label":"最高可贷年限","value":"3"},{"label":"借款人最大可对冲支取金额","value":"4"}]) | fromjson | tojson }},
        "business_content_class_api": "{{ business_content_class_api | default(GLOBAL_API_PREFIX + '/tools/business-content-classes') }}",
        "business_content_class_params": {{ business_content_class_params | default({}) | fromjson | tojson }}
    },
    "body": [
        {
            "type": "service",
            "api": {
                "method": "post",
                "url": "${business_content_class_api}",
                "data": "${business_content_class_params}",
                "adaptor": "var data = payload.data || payload.options || payload; var list = []; if (Array.isArray(data)) { list = data; } else if (data && Array.isArray(data.options)) { list = data.options; } else if (data && Array.isArray(data.rows)) { list = data.rows; } return { class_options: list };"
            },
            "body": [
        {
            "id": "main_crud",
            "type": "crud",
            "columnsTogglable": false,
            "api": "post:${rule_list_api}",
            "className": "premium-card",
            "filter": {
                "title": "",
                "submitText": "",
                "type": "form",
                "mode": "inline",
                "wrapWithPanel": false,
                "className": "p-4",
                "body": [
                    {
                        "type": "select",
                        "name": "ywsf",
                        "label": "关键数据算法",
                        "placeholder": "请选择",
                        "source": "${algorithm_options}",
                        "clearable": true
                    },
                    {
                        "type": "select",
                        "name": "ywnrfl",
                        "label": "业务内容分类",
                        "placeholder": "请选择",
                        "className": "wider-select",
                        "source": {
                            "method": "post",
                            "url": "${business_content_class_api}",
                            "data": "${business_content_class_params}"
                        },
                        "clearable": true
                    },
                    {
                        "type": "button",
                        "icon": "fa fa-check",
                        "level": "link",
                        "className": "p-2 mr-4",
                        "disabledOn": "${!ywsf || (ywsf == '1' && !ywnrfl)}",
                        "tooltip": "请先选择关键数据算法（最大可提取额还需选择业务内容分类）",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "清册选择",
                            "size": "lg",
                            "data": {
                                "syncIds": "",
                                "ywsf": "${ywsf}",
                                "ywnrfl": "${ywnrfl}"
                            },
                            "body": {
                                "id": "selection_form",
                                "type": "form",
                                "api": {
                                    "method": "post",
                                    "url": "{{ GLOBAL_API_PREFIX }}/ywbz/batch",
                                    "data": {
                                        "ids": "${syncIds}",
                                         "ywsf": "${ywsf}",
                                         "ywnrfl": "${ywnrfl}"
                                    }
                                },
                                "onEvent": {
                                    "submitSucc": {
                                        "actions": [
                                            {
                                                "actionType": "reload",
                                                "componentId": "main_crud"
                                            }
                                        ]
                                    }
                                },
                                "body": [
                                    {
                                        "type": "alert",
                                        "level": "info",
                                        "showIcon": true,
                                        "className": "mb-3",
                                        "visibleOn": "${ywsf == '1'}",
                                        "body": [
                                            {
                                                "type": "tpl",
                                                "tpl": "<b>最大可提取额算法说明</b><br/><span style='font-size:12px;color:#666;'>最大可提取额数据算法是一套结合提取内容、账户余额、冻结金额、账户保留金额、材料提取限额、累计提取金额、在途提取金额、计算精度等业务标准分类的动态标准计算模型，核心逻辑为：先根据提取内容（如购房、租房、还贷、离退休等）匹配对应的政策约束的材料提取限额（如购房不超过房款总额、租房不超过当地月度限额或实际租金、还贷不超过当期还款本息、离退休可全额提取），再与个人公积金账户当前可用余额（账户余额-冻结金额-账户保留金额）取最小值，最终得出的金额按计算精度计算后即为当前场景下可提取的最高额度。</span>"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "alert",
                                        "level": "info",
                                        "showIcon": true,
                                        "className": "mb-3",
                                        "visibleOn": "${ywsf == '2'}",
                                        "body": [
                                            {
                                                "type": "tpl",
                                                "tpl": "<b>最高可贷金额算法说明</b><br/><span style='font-size:12px;color:#666;'>最高可贷金额数据算法是一套多维度取低的综合计算模型，核心逻辑为：分别通过&ldquo;账户余额×缴存倍数（通常15-25倍）、家庭月收入×还贷能力系数（多为40%-60%）测算的年还贷能力×贷款年限、房屋总价扣除首付后的剩余金额、当地单/双缴存人家庭贷款最高限额；同时可根据缴存时间、公积金流动性等动态系数调整，叠加人才、多子女家庭等上浮规则&rdquo;等组合维度算出基础额度，最终取所有限制条件下的最小值作为可贷上限，最终得出的金额按计算精度计算后即为当前场景下可贷款的最高额度。</span>"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "alert",
                                        "level": "info",
                                        "showIcon": true,
                                        "className": "mb-3",
                                        "visibleOn": "${ywsf == '3'}",
                                        "body": [
                                            {
                                                "type": "tpl",
                                                "tpl": "<b>最高可贷年限算法说明</b><br/><span style='font-size:12px;color:#666;'>最高可贷年限数据算法是一套多维度取低的综合计算模型，核心逻辑为：分别通过【按借款人年龄算出&ldquo;法定退休年龄+贷款年限延长至退休年龄后X年-申请年龄&rdquo;的年限上限，二手房需额外计算&ldquo;当地规定的房龄+贷款年限总和上限（多为40-50年）-现有房龄&rdquo;的房龄限制年限，再与房屋类型对应的最高年限（新房最长30年、二手房部分城市最长20年）】计算后取最小值，夫妻共同贷款通常按年龄较长一方核算，最终结果向下取整为整年。</span>"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "alert",
                                        "level": "info",
                                        "showIcon": true,
                                        "className": "mb-3",
                                        "visibleOn": "${ywsf == '4'}",
                                        "body": [
                                            {
                                                "type": "tpl",
                                                "tpl": "<b>借款人最大可对冲支取金额算法说明</b><br/><span style='font-size:12px;color:#666;'>借款人最大可对冲支取金额数据算法采用&ldquo;多限制取低+累计扣减&rdquo;规则计算，核心逻辑为：先按对冲类型匹配上限（按月对冲不超过当月应还贷款本息额、按年对冲不超过当年/12个月应还本息总额、一次性冲本不超过剩余贷款本金），再减去历史累计已对冲支取金额，同时不超过借款人及共同对冲人公积金账户可用余额（账户余额-冻结金额-账户保留金额），三者取最小值即为本次可对冲支取的最高额度，部分城市支持叠加配偶、直系亲属的账户余额合并计算。</span>"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "crud",
                                        "api": {
                                            "method": "post",
                                            "url": "{{ GLOBAL_API_PREFIX }}/ywbz/selection_list",
                                            "data": {
                                                "gjsjsf": "${ywsf}",
                                                "ywnrfl": "${ywnrfl}"
                                            }
                                        },
                                        "syncLocation": false,
                                        "id": "crud_selection_dialog",
                                        "mode": "table",
                                        "primaryField": "id",
                                        "selectable": true,
                                        "multiple": true,
                                        "loadDataOnce": true,
                                        "onEvent": {
                                            "fetchInited": {
                                                "actions": [
                                                    {
                                                        "actionType": "setEventData",
                                                        "args": {
                                                            "key": "selectedIds",
                                                            "value": "${event.data.responseData.selectedIds}"
                                                        }
                                                    },
                                                    {
                                                        "actionType": "select",
                                                        "componentId": "crud_selection_dialog",
                                                        "args": {
                                                            "condition": "${ARRAYINCLUDES(selectedIds, id)}"
                                                        }
                                                    },
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "selection_form",
                                                        "args": {
                                                            "value": {
                                                                "syncIds": "${event.data.responseData.selectedIds | join}"
                                                            }
                                                        }
                                                    }
                                                ]
                                            },
                                            "selectedChange": {
                                                "actions": [
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "selection_form",
                                                        "args": {
                                                            "value": {
                                                                "syncIds": "${event.data.selectedItems | pick:id | join}"
                                                            }
                                                        }
                                                    }
                                                ]
                                            }
                                        },
                                        "keepItemSelectionOnPageChange": true,
                                        "headerToolbar": [
                                            "statistics"
                                        ],
                                        "footerToolbar": [
                                            "switch-per-page", 
                                            "pagination",
                                            "statistics"
                                        ],
                                        "columns": [
                                            {
                                                "name": "ywblbz",
                                                "label": "业务办理标准"
                                            },
                                            {
                                                "name": "ywblbzsm",
                                                "label": "业务办理标准描述"
                                            }
                                        ]
                                    }
                                ]
                            },
                            "actions": [
                                {
                                    "type": "button",
                                    "label": "关闭",
                                    "actionType": "close"
                                },
                                {
                                    "type": "button",
                                    "label": "保存",
                                    "level": "primary",
                                    "actionType": "submit"
                                }
                            ]
                        }
                    },
                    {
                        "type": "submit",
                        "label": "查询",
                        "level": "primary"
                    },
                    {
                        "type": "button",
                        "label": "全量导入",
                        "level": "primary",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "全量导入业务规则",
                            "body": {
                                "type": "form",
                                "api": {
                                    "method": "post",
                                    "url": "${rule_import_api}",
                                    "dataType": "form-data"
                                },
                                "body": [
                                    {
                                        "type": "input-file",
                                        "name": "file",
                                        "label": "选择CSV或SQL文件",
                                        "accept": ".csv,.sql",
                                        "asBlob": true,
                                        "required": true
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "button",
                        "label": "全量导出",
                        "level": "default",
                        "actionType": "download",
                        "api": {
                            "method": "post",
                            "url": "${rule_export_api}",
                            "responseType": "blob"
                        }
                    },
                    {
                        "type": "button",
                        "label": "调试",
                        "icon": "fa fa-bug",
                        "level": "primary",
                        "className": "ml-2",
                        "actionType": "dialog",
                        "dialog": {
                            "title": {
                                "type": "wrapper",
                                "body": [
                                    {
                                        "type": "tpl",
                                        "tpl": "业务规则调试"
                                    },
                                    {
                                        "type": "button",
                                        "icon": "fa fa-question-circle",
                                        "level": "link",
                                        "className": "ml-1",
                                        "tooltip": "点击查看使用说明",
                                        "actionType": "dialog",
                                        "dialog": {
                                            "title": "调试使用说明",
                                            "size": "md",
                                            "actions": [{"type": "button", "label": "知道了", "actionType": "close", "level": "primary"}],
                                            "body": {
                                                "type": "tpl",
                                                "tpl": "<div style='line-height:2;font-size:14px;'><p>（1）业务运行配置工具中通过调用场景<br/><code>HFB/business/ywbz/zhixing$m=execute.service</code><br/>方法计算算法结果。</p><p>（2）可通过公积金业务后台找到对应的api，复制入参。</p><p>（3）调试完成后，可点击查看明细，查看算法计算过程中每一条业务办理标准执行的结果。</p><p>（4）也可直接查看算法计算过程中应用的sql及结果：<br/><code>select * from gjj_ywblbz_log order by cjsj;</code></p></div>"
                                            }
                                        }
                                    }
                                ],
                                "className": "d-flex align-items-center",
                                "style": {
                                    "display": "flex",
                                    "alignItems": "center",
                                    "gap": "4px"
                                }
                            },
                            "size": "xl",
                            "body": {
                                "type": "form",
                                "id": "debug_form_component",
                                "title": "",
                                "mode": "normal",
                                "body": [
                                    {
                                        "type": "editor",
                                        "language": "json",
                                        "name": "debugInput",
                                        "label": "入参 (JSON)",
                                        "value": "{\n  \"ywsf\": \"1\",\n  \"ywnrfl\": \"1\",\n  \"jgbh\": \"\",\n  \"zjgbh\": \"\"\n}",
                                        "minRows": 15
                                    },
                                    {
                                        "type": "group",
                                        "body": [
                                            {
                                                "type": "button",
                                                "label": "调试",
                                                "level": "primary",
                                                "onEvent": {
                                                    "click": {
                                                        "actions": [
                                                            {
                                                                "actionType": "ajax",
                                                                "api": {
                                                                    "method": "post",
                                                                    "url": "${rule_debug_api}",
                                                                    "data": {
                                                                        "&": "${debugInput | fromjson}"
                                                                    }
                                                                },
                                                                "outputVar": "debugRes"
                                                            },
                                                            {
                                                                "actionType": "custom",
                                                                "script": "console.log('debugRes:', event.data.debugRes); console.log('responseResult:', event.data.responseResult); console.log('Full event:', event);",
                                                                "description": "Log debug response"
                                                            },
                                                            {
                                                                "actionType": "setValue",
                                                                "componentId": "debug_form_component",
                                                                "args": {
                                                                    "value": {
                                                                        "debugOutput": "${debugRes.items[0].result}",
                                                                        "pcid": "${debugRes.items[0].pcid}"
                                                                    }
                                                                }
                                                            }
                                                        ]
                                                    }
                                                }
                                            },
                                            {
                                                "type": "button",
                                                "label": "查看明细",
                                                "level": "info",
                                                "disabledOn": "!data.pcid",
                                                "actionType": "dialog",
                                                "dialog": {
                                                    "title": "调试日志明细",
                                                    "size": "xl",
                                                    "body": {
                                                        "type": "crud",
                                                        "api": {
                                                            "method": "post",
                                                            "url": "${rule_debug_log_api}",
                                                            "data": {
                                                                "pcid": "${pcid}"
                                                            }
                                                        },
                                                        "syncLocation": false,
                                                        "columns": [
                                                            {
                                                                "name": "step",
                                                                "label": "环节",
                                                                "width": 80
                                                            },
                                                            {
                                                                "name": "type",
                                                                "label": "类型",
                                                                "width": 80
                                                            },
                                                            {
                                                                "name": "content",
                                                                "label": "处理内容",
                                                                "type": "tpl",
                                                                "tpl": "<div style='word-break: break-all; white-space: pre-wrap;'>${content}</div>"
                                                            },
                                                            {
                                                                "name": "result",
                                                                "label": "结果",
                                                                "type": "tpl",
                                                                "tpl": "<div style='word-break: break-all; white-space: pre-wrap;'>${result}</div>"
                                                            },
                                                            {
                                                                "name": "time",
                                                                "label": "时间",
                                                                "width": 150
                                                            }
                                                        ]
                                                    },
                                                    "actions": [
                                                        {
                                                            "type": "button",
                                                            "label": "关闭",
                                                            "actionType": "close"
                                                        }
                                                    ]
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "static",
                                        "name": "debugOutput",
                                        "label": "结果"
                                    }
                                ]
                            },
                            "actions": [
                                {
                                    "type": "button",
                                    "label": "关闭",
                                    "actionType": "close"
                                }
                            ]
                        }
                    }
                ]
            },
            "headerToolbar": [
                "bulkActions"
            ],
            "footerToolbar": ["statistics", "pagination"],
            "columns": [
                {
                    "name": "ywsf",
                    "label": "关键数据算法",
                    "type": "mapping",
                    "map": {
                        "1": "最大可提取额",
                        "2": "最高可贷金额",
                        "3": "最高可贷年限",
                        "4": "借款人最大可对冲支取金额",
                        "*": "${ywsf}"
                    }
                },
                {
                    "name": "ywnrfl_label",
                    "label": "业务内容分类",
                    "type": "mapping",
                    "source": "${class_options}"
                },
                {
                    "name": "bzfl_label",
                    "label": "业务办理标准分类",
                    "type": "mapping",
                    "map": {
                        "1": "缴存人账户余额",
                        "2": "冻结金额",
                        "3": "账户保留金额",
                        "4": "材料提取限额",
                        "5": "累计提取金额",
                        "6": "精度值",
                        "7": "保留方式",
                        "8": "在途提取金额",
                        "*": "${bzfl}"
                    }
                },
                {
                    "name": "template_name",
                    "label": "业务办理标准"
                },
                {
                    "name": "template_desc",
                    "label": "业务办理标准描述"
                },

                {
                    "type": "operation",
                    "label": "操作",
                    "buttons": [
                        {
                            "type": "button",
                            "label": "规则参数配置",
                            "actionType": "drawer",
                            "level": "link",
                            "drawer": {
                                "title": "节点详细参数设置",
                                "size": "md",
                                "body": {
                                    "type": "service",
                                    "schemaApi": {
                                        "method": "post",
                                        "url": "{{ GLOBAL_API_PREFIX }}/ywbz/config_form",
                                        "dataType": "json",
                                        "data": {
                                            "id": "${id}",
                                            "mbid": "${mbid}"
                                        }
                                    }
                                }
                            }
                        },

                        {
                            "type": "button",
                            "label": "删除",
                            "actionType": "ajax",
                            "api": "post:${rule_delete_api}?id=${id}",
                            "confirmText": "确定要删除这条规则吗？",
                            "level": "danger"
                        }
                    ]
                }
            ]
        }
            ]
        }
    ]
}
