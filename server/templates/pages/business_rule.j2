{
    "type": "page",
    "title": "关键数据计算模型",
    "css": {
        ".premium-card": {
            "boxShadow": "0 4px 20px rgba(0,0,0,0.08)",
            "borderRadius": "12px",
            "overflow": "hidden"
        },
        ".page-header-gradient": {
            "background": "linear-gradient(90deg, #1890ff 0%, #096dd9 100%)",
            "padding": "16px 24px",
            "color": "#fff",
            "marginBottom": "0px",
            "borderRadius": "12px 12px 0 0"
        }
    },
    "data": {
        "rule_list_api": "{{ GLOBAL_API_PREFIX }}/ywbz/list",
        "rule_save_api": "{{ GLOBAL_API_PREFIX }}/ywbz/save",
        "rule_delete_api": "{{ GLOBAL_API_PREFIX }}/ywbz/delete",
        "rule_batch_api": "{{ GLOBAL_API_PREFIX }}/ywbz/batch",
        "ywbzk_list_api": "{{ GLOBAL_API_PREFIX }}/ywbzk/list",
        "rule_import_api": "{{ rule_import_api | default(GLOBAL_API_PREFIX + '/ywbz/import') }}",
        "rule_export_api": "{{ rule_export_api | default(GLOBAL_API_PREFIX + '/ywbz/export') }}",
        "rule_debug_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug",
        "rule_debug_log_api": "{{ GLOBAL_API_PREFIX }}/ywbz/debug_log",
        "algorithm_options": {{ algorithm_options | default([{"label":"最大可提取额","value":"1"},{"label":"最高可贷金额","value":"2"},{"label":"最高可贷年限","value":"3"},{"label":"借款人最大可对冲支取金额","value":"4"}]) | fromjson | tojson }},
        "business_content_class_api": "{{ business_content_class_api | default(GLOBAL_API_PREFIX + '/tools/business-content-classes') }}",
        "business_content_class_params": {{ business_content_class_params | default({}) | fromjson | tojson }}
    },
    "body": [
        {
            "id": "main_crud",
            "type": "crud",
            "api": "post:${rule_list_api}",
            "className": "premium-card",
            "filter": {
                "title": "",
                "submitText": "",
                "type": "form",
                "mode": "inline",
                "wrapWithPanel": false,
                "className": "p-4",
                "body": [
                    {
                        "type": "select",
                        "name": "ywsf",
                        "label": "关键数据算法",
                        "placeholder": "请选择",
                        "source": "${algorithm_options}",
                        "clearable": true
                    },
                    {
                        "type": "select",
                        "name": "ywnrfl",
                        "label": "业务内容分类",
                        "placeholder": "请选择",
                        "source": {
                            "method": "post",
                            "url": "${business_content_class_api}",
                            "data": "${business_content_class_params}"
                        },
                        "clearable": true
                    },
                    {
                        "type": "button",
                        "icon": "fa fa-check",
                        "level": "link",
                        "className": "p-2 mr-4",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "清册选择",
                            "size": "lg",
                            "data": {
                                "syncIds": "",
                                "ywsf": "${ywsf}",
                                "ywnrfl": "${ywnrfl}"
                            },
                            "body": {
                                "id": "selection_form",
                                "type": "form",
                                "api": {
                                    "method": "post",
                                    "url": "{{ GLOBAL_API_PREFIX }}/ywbz/batch",
                                    "data": {
                                        "ids": "${syncIds}",
                                         "ywsf": "${ywsf}",
                                         "ywnrfl": "${ywnrfl}"
                                    }
                                },
                                "onEvent": {
                                    "submitSucc": {
                                        "actions": [
                                            {
                                                "actionType": "reload",
                                                "componentId": "main_crud"
                                            }
                                        ]
                                    }
                                },
                                "body": [

                                    {
                                        "type": "crud",
                                        "api": {
                                            "method": "post",
                                            "url": "{{ GLOBAL_API_PREFIX }}/ywbz/selection_list",
                                            "data": {
                                                "gjsjsf": "${ywsf}",
                                                "ywnrfl": "${ywnrfl}"
                                            }
                                        },
                                        "syncLocation": false,
                                        "id": "crud_selection_dialog",
                                        "mode": "table",
                                        "primaryField": "id",
                                        "selectable": true,
                                        "multiple": true,
                                        "loadDataOnce": true,
                                        "onEvent": {
                                            "fetchInited": {
                                                "actions": [
                                                    {
                                                        "actionType": "setEventData",
                                                        "args": {
                                                            "key": "selectedIds",
                                                            "value": "${event.data.responseData.selectedIds}"
                                                        }
                                                    },
                                                    {
                                                        "actionType": "select",
                                                        "componentId": "crud_selection_dialog",
                                                        "args": {
                                                            "condition": "${ARRAYINCLUDES(selectedIds, id)}"
                                                        }
                                                    },
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "selection_form",
                                                        "args": {
                                                            "value": {
                                                                "syncIds": "${event.data.responseData.selectedIds | join}"
                                                            }
                                                        }
                                                    }
                                                ]
                                            },
                                            "selectedChange": {
                                                "actions": [
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "selection_form",
                                                        "args": {
                                                            "value": {
                                                                "syncIds": "${event.data.selectedItems | pick:id | join}"
                                                            }
                                                        }
                                                    }
                                                ]
                                            }
                                        },
                                        "keepItemSelectionOnPageChange": true,
                                        "headerToolbar": [
                                            "statistics"
                                        ],
                                        "footerToolbar": [
                                            "switch-per-page", 
                                            "pagination",
                                            "statistics"
                                        ],
                                        "columns": [
                                            {
                                                "name": "ywblbz",
                                                "label": "业务办理标准"
                                            }
                                        ]
                                    }
                                ]
                            },
                            "actions": [
                                {
                                    "type": "button",
                                    "label": "关闭",
                                    "actionType": "close"
                                },
                                {
                                    "type": "button",
                                    "label": "保存",
                                    "level": "primary",
                                    "actionType": "submit"
                                }
                            ]
                        }
                    },
                    {
                        "type": "submit",
                        "label": "查询",
                        "level": "primary"
                    },
                    {
                        "type": "button",
                        "label": "全量导入",
                        "level": "primary",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "全量导入业务规则",
                            "body": {
                                "type": "form",
                                "api": {
                                    "method": "post",
                                    "url": "${rule_import_api}",
                                    "dataType": "form-data"
                                },
                                "body": [
                                    {
                                        "type": "input-file",
                                        "name": "file",
                                        "label": "选择CSV或SQL文件",
                                        "accept": ".csv,.sql",
                                        "asBlob": true,
                                        "required": true
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "button",
                        "label": "全量导出",
                        "level": "default",
                        "actionType": "download",
                        "api": {
                            "method": "post",
                            "url": "${rule_export_api}",
                            "responseType": "blob"
                        }
                    },
                    {
                        "type": "button",
                        "label": "调试",
                        "icon": "fa fa-bug",
                        "level": "primary",
                        "className": "ml-2",
                        "actionType": "dialog",
                        "dialog": {
                            "title": "业务规则调试",
                            "size": "lg",
                            "body": {
                                "type": "form",
                                "id": "debug_form_component",
                                "title": "",
                                "mode": "normal",
                                "body": [
                                    {
                                        "type": "editor",
                                        "language": "json",
                                        "name": "debugInput",
                                        "label": "入参 (JSON)",
                                        "value": "{\n  \"ywsf\": \"1\",\n  \"ywnrfl\": \"1\",\n  \"jgbh\": \"\",\n  \"zjgbh\": \"\"\n}",
                                        "minRows": 10
                                    },
                                    {
                                        "type": "group",
                                        "body": [
                                            {
                                                "type": "button",
                                                "label": "调试",
                                                "level": "primary",
                                                "onEvent": {
                                                    "click": {
                                                        "actions": [
                                                            {
                                                                "actionType": "ajax",
                                                                "api": {
                                                                    "method": "post",
                                                                    "url": "${rule_debug_api}",
                                                                    "data": "${debugInput | fromjson}"
                                                                },
                                                                "outputVar": "debugRes"
                                                            },
                                                            {
                                                                "actionType": "custom",
                                                                "script": "console.log('debugRes:', event.data.debugRes); console.log('responseResult:', event.data.responseResult); console.log('Full event:', event);",
                                                                "description": "Log debug response"
                                                            },
                                                            {
                                                                "actionType": "setValue",
                                                                "componentId": "debug_form_component",
                                                                "args": {
                                                                    "value": {
                                                                        "debugOutput": "${debugRes.items[0].result}",
                                                                        "pcid": "${debugRes.items[0].pcid}"
                                                                    }
                                                                }
                                                            }
                                                        ]
                                                    }
                                                }
                                            },
                                            {
                                                "type": "button",
                                                "label": "查看明细",
                                                "level": "info",
                                                "disabledOn": "!data.pcid",
                                                "actionType": "dialog",
                                                "dialog": {
                                                    "title": "调试日志明细",
                                                    "size": "xl",
                                                    "body": {
                                                        "type": "crud",
                                                        "api": {
                                                            "method": "post",
                                                            "url": "${rule_debug_log_api}",
                                                            "data": {
                                                                "pcid": "${pcid}"
                                                            }
                                                        },
                                                        "syncLocation": false,
                                                        "columns": [
                                                            {
                                                                "name": "step",
                                                                "label": "环节",
                                                                "width": 80
                                                            },
                                                            {
                                                                "name": "type",
                                                                "label": "类型",
                                                                "width": 80
                                                            },
                                                            {
                                                                "name": "content",
                                                                "label": "处理内容",
                                                                "type": "tpl",
                                                                "tpl": "<div style='word-break: break-all; white-space: pre-wrap;'>${content}</div>"
                                                            },
                                                            {
                                                                "name": "result",
                                                                "label": "结果",
                                                                "type": "tpl",
                                                                "tpl": "<div style='word-break: break-all; white-space: pre-wrap;'>${result}</div>"
                                                            },
                                                            {
                                                                "name": "time",
                                                                "label": "时间",
                                                                "width": 150
                                                            }
                                                        ]
                                                    },
                                                    "actions": [
                                                        {
                                                            "type": "button",
                                                            "label": "关闭",
                                                            "actionType": "close"
                                                        }
                                                    ]
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "static",
                                        "name": "debugOutput",
                                        "label": "结果"
                                    }
                                ]
                            },
                            "actions": [
                                {
                                    "type": "button",
                                    "label": "关闭",
                                    "actionType": "close"
                                }
                            ]
                        }
                    }
                ]
            },
            "headerToolbar": [
                "bulkActions"
            ],
            "footerToolbar": ["statistics", "pagination"],
            "columns": [
                {
                    "name": "ywsf",
                    "label": "关键数据算法",
                    "type": "mapping",
                    "map": {
                        "1": "最大可提取额",
                        "2": "最高可贷金额",
                        "3": "最高可贷年限",
                        "4": "借款人最大可对冲支取金额",
                        "*": "${ywsf}"
                    }
                },
                {
                    "name": "template_name",
                    "label": "业务办理标准"
                },

                {
                    "type": "operation",
                    "label": "操作",
                    "buttons": [
                        {
                            "type": "button",
                            "label": "规则参数配置",
                            "actionType": "drawer",
                            "level": "link",
                            "drawer": {
                                "title": "节点详细参数设置",
                                "size": "md",
                                "body": {
                                    "type": "service",
                                    "schemaApi": {
                                        "method": "post",
                                        "url": "{{ GLOBAL_API_PREFIX }}/ywbz/config_form",
                                        "dataType": "json",
                                        "data": {
                                            "id": "${id}",
                                            "mbid": "${mbid}"
                                        }
                                    }
                                }
                            }
                        },

                        {
                            "type": "button",
                            "label": "删除",
                            "actionType": "ajax",
                            "api": "post:${rule_delete_api}?id=${id}",
                            "confirmText": "确定要删除这条规则吗？",
                            "level": "danger"
                        }
                    ]
                }
            ]
        }
    ]
}
