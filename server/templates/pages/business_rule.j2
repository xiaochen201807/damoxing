                        "*": "${bzfl}"
                    }
                },
                {
                    "name": "display_ywblbz",
                    "label": "业务办理标准"
                },
                {
                    "name": "template_desc",
                    "label": "业务办理标准描述"
                },

                {
                    "type": "operation",
                    "label": "操作",
                    "buttons": [
                        {
                            "type": "button",
