                                                        "columns": [
                                                            {
                                                                "name": "step",
                                                                "label": "环节",
                                                                "width": 80
                                                            },
                                                            {
                                                                "name": "type",
                                                                "label": "类型",
                                                                "width": 80
                                                            },
                                                            {
                                                                "name": "content",
                                                                "label": "处理内容",
                                                                "type": "tpl",
                                                                "tpl": "<div style='word-break: break-all; white-space: pre-wrap;'>${content}</div>"
                                                            },
                                                            {
                                                                "name": "result",
                                                                "label": "结果",
                                                                "type": "tpl",
                                                                "tpl": "<div style='word-break: break-all; white-space: pre-wrap;'>${result}</div>"
                                                            },
                                                            {
                                                                "name": "time",
                                                                "label": "时间",
                                                                "width": 150
                                                            }
                                                        ]
                                                    },
                                                    "actions": [
                                                        {
                                                            "type": "button",
                                                            "label": "关闭",
                                                            "actionType": "close"
                                                        }
                                                    ]
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "static",
                                        "name": "debugOutput",
                                        "label": "结果"
                                    }
                                ]
                            },
                            "actions": [
                                {
                                    "type": "button",
                                    "label": "关闭",
                                    "actionType": "close"
                                }
                            ]
                        }
                    }
                ]
            },
            "onEvent": {
                "selectedChange": {
                    "actions": [
                        {
                            "actionType": "setValue",
