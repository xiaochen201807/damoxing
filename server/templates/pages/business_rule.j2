                                        "required": true
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "button",
                        "label": "调试",
                        "icon": "fa fa-bug",
                        "level": "primary",
                        "className": "ml-2",
                        "actionType": "dialog",
                        "dialog": {
                            "title": {
                                "type": "wrapper",
                                "body": [
                                    {
                                        "type": "tpl",
                                        "tpl": "业务规则调试"
                                    },
                                    {
                                        "type": "button",
                                        "icon": "fa fa-question-circle",
                                        "level": "link",
                                        "className": "ml-1",
                                        "tooltip": "点击查看使用说明",
                                        "actionType": "dialog",
                                        "dialog": {
                                            "title": "调试使用说明",
                                            "size": "md",
                                            "actions": [{"type": "button", "label": "知道了", "actionType": "close", "level": "primary"}],
                                             "body": {
                                                 "type": "tpl",
                                                 "tpl": "<div style='line-height:2;font-size:14px;'><p>（1）业务运行配置工具中通过调用场景<br/><code>HFB/business/ywbz/zhixing$m=execute.service</code><br/>方法计算算法结果。</p><p>（2）统一入口收到请求后，会按关键数据算法进入对应算法分支；调试日志首行会补充分发说明，便于核对当前算法执行路径。</p><p>（3）可通过公积金业务后台找到对应的api，复制入参。</p><p>（4）调试完成后，可点击查看明细，查看算法计算过程中每一条业务办理标准执行的结果。</p><p>（5）也可直接查看算法计算过程中应用的sql及结果：<br/><code>select * from gjj_ywblbz_log order by cjsj;</code></p></div>"
                                             }
                                         }
                                     }
                                 ],
                                "className": "d-flex align-items-center",
                                "style": {
                                    "display": "flex",
                                    "alignItems": "center",
                                    "gap": "4px"
                                }
                            },
                            "size": "xl",
