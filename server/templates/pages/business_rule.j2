                                                        ]
                                                    }
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "static",
                                        "name": "debugTemplateTip",
                                        "label": "模板说明"
                                    },
                                    {
                                        "type": "editor",
                                        "language": "json",
                                        "name": "debugInput",
                                        "label": "入参 (JSON)",
                                        "minRows": 15,
                                        "onEvent": {
                                            "change": {
                                                "actions": [
                                                    {
                                                        "actionType": "setValue",
                                                        "componentId": "debug_form_component",
                                                        "args": {
                                                            "value": {
                                                                "debugOutput": "",
                                                                "pcid": ""
                                                            }
                                                        }
                                                    }
                                                ]
                                            }
                                        }
                                    },
                                    {
                                        "type": "group",
                                        "body": [
                                            {
                                                "type": "button",
                                                "label": "调试",
                                                "level": "primary",
                                                "onEvent": {
                                                    "click": {
                                                        "actions": [
                                                            {
                                                                "actionType": "ajax",
                                                                "api": {
                                                                    "method": "post",
                                                                    "url": "{{ GLOBAL_API_PREFIX }}/ywbz/debug",
                                                                    "data": {
                                                                        "debugInput": "${debugInput}"
                                                                    },
                                                                    "requestAdaptor": "try { api.data = JSON.parse(api.data.debugInput); } catch(e) { console.error('JSON parse error:', e); } return api;",
                                                                    "adaptor": "return payload.data || payload || {};"
                                                                },
                                                                "outputVar": "debugRes"
                                                            },
                                                            {
                                                                "actionType": "setValue",
                                                                "componentId": "debug_form_component",
                                                                "args": {
                                                                    "value": {
                                                                        "debugOutput": "${debugRes.items[0].result}",
                                                                        "pcid": "${debugRes.items[0].pcid}"
                                                                    }
                                                                }
                                                            }
                                                        ]
                                                    }
                                                }
                                            },
                                            {
                                                "type": "button",
                                                "label": "查看明细",
                                                "level": "info",
                                                "disabledOn": "!data.pcid",
