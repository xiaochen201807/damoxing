                                "value": {
                                    "_selectedIds": "${event.data.selectedItems|pick:id|join}"
                                }
                            }
                        }
                    ]
                }
            },
            "headerToolbar": [],
            "footerToolbar": ["statistics", "pagination"],
            "columns": [
                {
                    "name": "ywsf",
                    "label": "关键数据算法",
