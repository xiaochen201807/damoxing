{#
  主动服务演示页面
  
  ========== 页面头部配置 ==========
  - title: 页面标题
  - show_refresh_button: 是否显示刷新按钮 (true/false)
  - refresh_button_text: 刷新按钮文本
  - reload_target: 刷新目标组件名称
  
  ========== 卡片配置 ==========
  - cards: 卡片配置数组 (JSON)，每个卡片包含：
    - title: 卡片标题
    - icon: 图标类名
    - desc: 描述文字
    - api: 目标群体数据接口 (POST请求)
    - api_data: API 固定请求参数 (JSON对象)
    - target_label: 目标群体标签
    - target_value: 静态目标群体值 (如果不用 api)
    - button_label: 按钮文字
    - crud_api: CRUD 列表数据接口 (POST请求)
    - crud_api_data: CRUD API 固定请求参数 (JSON对象)
    - crud_columns: CRUD 列配置 (JSON数组)
    - dialog_title: 弹窗标题
  - columns: 每行显示的列数
  - service_name: 组件名称
  
  ========== 页面底部配置 ==========
  - footer_text: 底部版权文字
#}

{# ========== 页面头部配置 ========== #}
{% set title = title | default('主动服务') %}
{% set show_refresh_button = show_refresh_button | default(true) %}
{% set refresh_button_text = refresh_button_text | default('刷新数据') %}
{% set reload_target = reload_target | default('service_cards_grid') %}

