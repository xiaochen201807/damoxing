{# 双图表仪表盘模板 #}
{
    "type": "page",
    "title": "{{ title }}",
    "subTitle": "{{ subtitle | default('双图表数据分析') }}",
    "body": [
        {
            "type": "grid",
            "columns": [
                {
                    "md": 6,
                    "body": [
                        {% set bar_api_url = bar_api_url %}
                        {% set bar_height = bar_height | default(350) %}
                        {% include 'components/bar_chart_panel.j2' %}
                    ]
                },
                {
                    "md": 6,
                    "body": [
                        {% set line_api_url = line_api_url %}
                        {% set line_height = line_height | default(350) %}
                        {% include 'components/line_chart_panel.j2' %}
                    ]
                }
            ]
        }
    ]
}
