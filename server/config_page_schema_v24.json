                                                                            "required": true
                                                                        },
                                                                        {
                                                                            "type": "textarea",
                                                                            "name": "description",
                                                                            "label": "\u63cf\u8ff0",
                                                                            "maxRows": 3
                                                                        }
                                                                    ]
                                                                }
                                                            }
                                                        }
                                                    ],
                                                    "columns": [
                                                        {
                                                            "name": "workflow_name",
                                                            "label": "\u5de5\u4f5c\u6d41\u540d\u79f0",
                                                            "width": 150
                                                        },
                                                        {
                                                            "name": "workflow_type",
                                                            "label": "\u7c7b\u578b",
                                                            "width": 120,
