                                            "label": "AI\u5de5\u4f5c\u6d41",
                                            "icon": "fa fa-magic",
                                            "level": "link",
                                            "actionType": "dialog",
                                            "dialog": {
                                                "title": "\ud83e\udd16 ${title} - AI \u5de5\u4f5c\u6d41\u914d\u7f6e",
                                                "size": "lg",
                                                "actions": [
                                                    {
                                                        "type": "button",
                                                        "label": "\u5173\u95ed",
