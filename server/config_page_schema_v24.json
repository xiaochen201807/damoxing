                                            "label": "\u5220\u9664",
                                            "icon": "fa fa-trash",
                                            "level": "link",
                                            "className": "text-danger",
                                            "actionType": "ajax",
                                            "confirmText": "\u786e\u8ba4\u5220\u9664\u9875\u9762\u3010${title}\u3011\uff1f\u6b64\u64cd\u4f5c\u4e0d\u53ef\u6062\u590d\u3002",
