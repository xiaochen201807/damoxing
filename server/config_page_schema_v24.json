                                                                            "placeholder": "\u5982: \u8d37\u6b3e\u98ce\u9669\u5206\u6790"
                                                                        },
                                                                        {
                                                                            "type": "select",
                                                                            "name": "workflow_type",
                                                                            "label": "\u5de5\u4f5c\u6d41\u7c7b\u578b",
                                                                            "required": true,
                                                                            "value": "ai_analysis",
                                                                            "options": [
                                                                                {
                                                                                    "label": "\ud83e\udd16 AI \u5206\u6790",
                                                                                    "value": "ai_analysis"
                                                                                },
                                                                                {
                                                                                    "label": "\ud83d\udcdd \u62a5\u544a\u751f\u6210",
                                                                                    "value": "report_generation"
                                                                                },
                                                                                {
                                                                                    "label": "\u2601\ufe0f \u6570\u636e\u5bfc\u5165",
                                                                                    "value": "data_import"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "type": "input-text",
                                                                            "name": "api_url",
                                                                            "label": "API \u5730\u5740",
