                                {
                                    "type": "operation",
                                    "label": "\u64cd\u4f5c",
                                    "width": 280,
                                    "buttons": [
                                        {
                                            "label": "\u7f16\u8f91\u914d\u7f6e",
                                            "icon": "fa fa-edit",
                                            "level": "link",
                                            "actionType": "drawer",
                                            "drawer": {
                                                "title": "\u270f\ufe0f \u7f16\u8f91\u914d\u7f6e - ${title}",
                                                "size": "lg",
                                                "resizable": true,
                                                "body": {
                                                    "type": "service",
                                                    "schemaApi": "/api/schema/wizard?mode=edit&page_key=${page_key}"
