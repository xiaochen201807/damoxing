# ============================================
# 服务器配置
# ============================================
PORT=3001
NODE_ENV=development

# API 路由前缀（用于多项目兼容部署）
# 默认: /api
# 示例: /damoxing/api
API_ROUTE_PREFIX=/gjjrgzn/api

# CORS 允许的源（多个用逗号分隔）
# 开发环境: http://localhost:3000,http://127.0.0.1:3000
# 生产环境: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# 标准库 SQL 应用层加密
# ============================================
# GitHub Actions 发布的正式镜像已内置同一把 RSA 私钥，并设置固定路径。
# 非正式镜像或裸机生产部署仍必须配置私钥，缺失时服务会拒绝启动：
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out standard-sql-private.pem
STANDARD_SQL_PRIVATE_KEY_FILE=
# 可选：密钥轮换标识；留空时根据公钥自动生成
STANDARD_SQL_KEY_ID=
# 加密信封有效期、信封总大小、单条 SQL 大小
STANDARD_SQL_ENVELOPE_MAX_AGE_MS=300000
STANDARD_SQL_ENVELOPE_MAX_BYTES=524288
STANDARD_SQL_MAX_BYTES=65536
# Base64 密文会膨胀，JSON 请求上限应大于信封上限
JSON_BODY_LIMIT=1mb

# ============================================
# 数据库配置
# ============================================
DB_PATH=./database.sqlite

# 多数据源配置 (Oracle / 达梦)
# --------------------------------------------
# 此项目现已支持多租户基于 JGBH 的多数据源动态路由，
# 请通过修改 server/config/datasources.json 来配置具体的连接池和数据库类型。
# (旧的 ORACLE_ 系列独立环境变量已被废弃，请统一使用配置件)

# ============================================
# Dify API 默认配置（兜底配置）
# ============================================
# 注意：推荐使用数据库配置每个页面的工作流
# 这里的配置仅作为兜底使用，当数据库中没有配置时才会使用

# Dify API 地址
# 私有部署: http://your-domain/v1
DIFY_API_URL=

# Dify 应用的 API Key (类型为: App Secret Key)
# 留空则启用后端 Mock 模式
DIFY_API_KEY=

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# 第三方网关配置
# ============================================
# 网关验证接口地址
GATEWAY_VALIDATE_URL=
# 网关 ticket 参数
GATEWAY_TICKET=your-ticket-here
# 网关 loginToken 参数
GATEWAY_LOGIN_TOKEN=your-login-token-here
# 是否启用网关集成
GATEWAY_ENABLED=true
# 是否跳过本地用户验证（true=仅网关认证，false=双重验证）
SKIP_LOCAL_AUTH=false
