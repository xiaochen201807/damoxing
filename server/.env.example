# ============================================
# 服务器配置
# ============================================
PORT=3001
NODE_ENV=development

# API 路由前缀（用于多项目兼容部署）
# 默认: /api
# 示例: /damoxing/api
API_ROUTE_PREFIX=/gjjrgzn/api

# CORS 允许的源（多个用逗号分隔）
# 开发环境: http://localhost:3000,http://127.0.0.1:3000
# 生产环境: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# 数据库配置
# ============================================
DB_PATH=./database.sqlite

# ============================================
# Dify API 默认配置（兜底配置）
# ============================================
# 注意：推荐使用数据库配置每个页面的工作流
# 这里的配置仅作为兜底使用，当数据库中没有配置时才会使用

# Dify API 地址（请配置为公司内网或私有部署地址）
# 示例: http://your-internal-dify/v1
DIFY_API_URL=

# Dify 应用的 API Key (类型为: App Secret Key)
# 留空则启用后端 Mock 模式
DIFY_API_KEY=

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# 第三方网关配置
# ============================================
# 网关验证接口地址（请配置为公司内网网关地址）
GATEWAY_VALIDATE_URL=
# 网关 ticket 参数
GATEWAY_TICKET=your-ticket-here
# 网关 loginToken 参数
GATEWAY_LOGIN_TOKEN=your-login-token-here
# 是否启用网关集成
GATEWAY_ENABLED=true
# 是否跳过本地用户验证（true=仅网关认证，false=双重验证）
SKIP_LOCAL_AUTH=false
