# ============================================
# 服务器配置
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# 数据库配置
# ============================================
DB_PATH=./database.sqlite

# ============================================
# Dify API 默认配置（兜底配置）
# ============================================
# 注意：推荐使用数据库配置每个页面的工作流
# 这里的配置仅作为兜底使用，当数据库中没有配置时才会使用

# Dify API 地址
# 云端版: https://api.dify.ai/v1
# 私有部署: http://your-domain/v1
DIFY_API_URL=https://api.dify.ai/v1

# Dify 应用的 API Key (类型为: App Secret Key)
# 留空则启用后端 Mock 模式
DIFY_API_KEY=

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs