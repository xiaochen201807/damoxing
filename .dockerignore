# Node modules (必须排除,避免架构不匹配)
node_modules/
**/node_modules/

# Git 和 CI/CD
.git
.gitignore
.github
.gitlab-ci.yml
.travis.yml

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Environment files
.env
.env.development
.env.local
.env.*.local

# 前端
client/node_modules/
client/dist/
client/.vite/
client/.cache/

# 后端
server/node_modules/
server/logs/
server/backups/
# server/database.sqlite  # 注释掉，需要作为模板复制到镜像
server/damoxing.db
server/data.db
# 排除其他 sqlite 文件，但保留 database.sqlite
server/*.sqlite
!server/database.sqlite

# 文档和配置
docs/
.venv/
schema-builder/
nginx/
README.md
DEPLOYMENT.md
DEPLOYMENT_MULTI_REPLICA.md
DEPLOYMENT_SIMPLE.md

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# 测试和覆盖率
test/
tests/
__tests__/
coverage/
.nyc_output/

# Docker 相关（不需要在镜像中）
docker-compose.yml
docker-compose.*.yml
.dockerignore

# 临时和缓存文件
*.tmp
*.cache
.cache/
tmp/
temp/
*.bak
*.backup

# 其他 Markdown 文件
*.md
!package*.json

# 重要：允许必需的 shell 脚本和配置
!docker-entrypoint.sh
!backup-db.sh
!nginx-single.conf
!supervisord.conf
!crontab
