server {
    listen 80;
    server_name localhost;

    # 日志
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/x-javascript
        application/json
        application/xml
        image/svg+xml;

    # 安全头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Docker 内部 DNS，配合变量 proxy_pass 避免启动时强依赖血缘服务已解析
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $lineage_upstream "${LINEAGE_UPSTREAM}";

    # ============================================
    # SQL 血缘分析服务反向代理
    # 默认外部路径：
    # - APP_BASE_PATH=/ 时为 /lineage/
    # - APP_BASE_PATH=/gjj_gjsjjsmx/ 时为 /gjj_gjsjjsmx/lineage/
    # ============================================
    location = ${LINEAGE_ROUTE_PREFIX} {
        return 301 ${LINEAGE_ROUTE_PREFIX}/;
    }

    location ${LINEAGE_ROUTE_PREFIX}/ {
        rewrite ^${LINEAGE_ROUTE_PREFIX}/(.*)$ /$1 break;

        proxy_pass $lineage_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    # ============================================
    # MCP SSE 端点 (需要在通用 API 前缀前面)
    # 注意：路径包含应用基础路径 ${APP_BASE_PATH}
    # ============================================
    location ${API_ROUTE_PREFIX}/mcp/sse {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        
        # SSE 关键配置：Connection 设为空字符串
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 禁用所有缓冲和缓存
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header X-Accel-Buffering 'no';
        
        # 长超时设置
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
    
    location ${API_ROUTE_PREFIX}/mcp/messages {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 标准超时
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # ============================================
    # API 反向代理到本地 Node.js (通用)
    # 注意：路径需与后端 API_ROUTE_PREFIX 环境变量保持一致
    # ============================================
    location ${API_ROUTE_PREFIX} {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 增加超时时间以支持长 AI 请求 (5分钟)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_cache_bypass $http_upgrade;
        
        # 禁用缓冲以支持 SSE (Server-Sent Events) 流式输出
        proxy_buffering off;
    }

    # 健康检查（保持在根路径）
    location /health {
        proxy_pass http://127.0.0.1:3001;
        access_log off;
    }

    # ============================================
    # 前端静态文件（部署在 ${APP_BASE_PATH} 子路径）
    # ============================================
    location ${APP_BASE_PATH} {
        alias /usr/share/nginx/html/;
        index index.html;
        try_files $uri $uri/ ${APP_BASE_PATH}index.html;

        # HTML 不缓存
        location ~* \.html$ {
            expires -1;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }

        # JS/CSS 长期缓存
        location ~* \.(js|css)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # 字体文件
        location ~* \.(woff|woff2|ttf|eot|otf)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # 图片文件
        location ~* \.(jpg|jpeg|png|gif|ico|svg|webp)$ {
            expires 6M;
            add_header Cache-Control "public, immutable";
        }
    }

    # 根路径重定向到应用路径
    location = / {
        return 301 ${APP_BASE_PATH};
    }
}
