# ============================================
# 生产环境配置 (Docker)
# ============================================

# 服务器配置
NODE_ENV=production
PORT=3001

# API 路由前缀（需与 Nginx 和前端配置保持一致）
API_ROUTE_PREFIX=/gjjrgzn/api

# 数据库路径 (Docker 容器内路径)
DB_PATH=/app/data/database.sqlite

# CORS 配置（允许所有 jbysoft.com 子域名）
CORS_ORIGIN=https://appcs.jbysoft.com,https://appsy.jbysoft.com,https://app.jbysoft.com

# 第三方网关配置
GATEWAY_VALIDATE_URL=https://appsy.jbysoft.com/tyrz/cheque/validate.service
GATEWAY_ENABLED=true

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=4671d0ca-6bc0-41e2-95f0-ade07b6eef0c
JWT_EXPIRES_IN=24h

# Dify API 配置 (可选)
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=

# 日志配置
LOG_LEVEL=info
LOG_DIR=/app/logs
