# ============================================
# 生产环境配置 (Docker)
# ============================================

# 服务器配置
NODE_ENV=production
PORT=3001

# 数据库路径 (Docker 容器内路径)
DB_PATH=/app/data/database.sqlite

# CORS 配置 (根据实际域名修改)
# 多个域名用逗号分隔
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Dify API 配置 (可选)
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=

# 日志配置
LOG_LEVEL=info
LOG_DIR=/app/logs
