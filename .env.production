# ============================================
# 生产环境配置 (Docker)
# ============================================

# 服务器配置
NODE_ENV=production
PORT=3001

# API 路由前缀（需与 Nginx 和前端配置保持一致）
API_ROUTE_PREFIX=/gjjrgzn/api

# 数据库路径 (Docker 容器内路径)
DB_PATH=/app/data/database.sqlite

# CORS 配置 (根据实际域名修改)
# 多个域名用逗号分隔
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=gjjrgzn-production-secret-key-change-this
JWT_EXPIRES_IN=24h

# Dify API 配置 (可选)
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=

# 日志配置
LOG_LEVEL=info
LOG_DIR=/app/logs
