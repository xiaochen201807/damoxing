# ============================================
# 生产环境配置 (Docker)
# ============================================

# 服务器配置
NODE_ENV=production
PORT=3001

# API 路由前缀（需与 Nginx 和前端配置保持一致）
API_ROUTE_PREFIX=/gjjrgzn/api

# 数据库路径 (Docker 容器内路径)
DB_PATH=/app/data/database.sqlite

# CORS 配置（请配置为公司内网访问域名，多个用逗号分隔）
CORS_ORIGIN=

# 第三方网关配置（请配置为公司内网网关地址）
GATEWAY_VALIDATE_URL=
GATEWAY_ENABLED=false
# 是否跳过本地用户验证（true=仅网关认证，false=双重验证）
SKIP_LOCAL_AUTH=false

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=4671d0ca-6bc0-41e2-95f0-ade07b6eef0c
JWT_EXPIRES_IN=24h

# Dify API 配置 (可选，请配置为公司内网或私有部署地址)
DIFY_API_URL=
DIFY_API_KEY=

# 日志配置
LOG_LEVEL=info
LOG_DIR=/app/logs
