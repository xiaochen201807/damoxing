{# Chart Demonstration Page with Dynamic Header #}
{% import 'base/colors.j2' as theme %}
{
    "type": "page",
    
    {# ⭐ 核心 1：定义唯一 ID，供子组件寻找 ⭐ #}
    "id": "global_page_root", 
    
    "className": "p-none",
    
    {# ⭐ 核心 2：定义全局状态，作为唯一的真理来源 ⭐ #}
    "data": {
        "show_analysis_result": false,  {# 控制结果区域是否显示 #}
        "ai_loading": false             {# 控制全屏 Loading 遮罩是否显示 #}
    },

    "body": [
        {# 1. 顶部 Header #}
        {% include 'components/header.j2' %},

        {# 2. 顶部 Alert 提示 #}
        {% include 'components/alert.j2' %},

        {# 3. 核心功能区 (导入按钮 + AI 分析按钮 + Loading 遮罩 + Service 结果区) #}
        {# 刚才修改的那个大文件就是这里引用的 #}
        {% include 'components/import_Ai.j2' %},

        {# 4. 底部 Footer #}
        {
            "type": "tpl",
            "tpl": "<div style='text-align: center; color: #999; font-size: 12px; padding: 20px 0;'>{{ footer_text | default('住房公积金管理中心 © 2025') }}</div>"
        }
    ]
}