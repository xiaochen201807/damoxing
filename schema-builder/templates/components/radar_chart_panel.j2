{# Radar Chart Panel Component - Multi-Dimensional Analysis #}
{
    "type": "chart",
    "api": {
        "url": "{{ radar_api_url }}",
        "method": "{{ radar_method | default('get') }}",
        "adaptor": "const option = payload.data || {}; if (option.series && option.series[0]) { option.series[0].type = 'radar'; option.series[0].areaStyle = { opacity: {{ radar_opacity | default(0.3) }} }; option.series[0].emphasis = { lineStyle: { width: 4 }, areaStyle: { opacity: 0.5 } }; } if (option.radar) { option.radar.splitNumber = {{ radar_split_number | default(5) }}; option.radar.shape = '{{ radar_shape | default('polygon') }}'; option.radar.splitArea = { areaStyle: { color: ['rgba(25, 183, 207, 0.05)', 'rgba(25, 183, 207, 0.1)'] } }; option.radar.axisLine = { lineStyle: { color: 'rgba(25, 183, 207, 0.2)' } }; option.radar.splitLine = { lineStyle: { color: 'rgba(25, 183, 207, 0.2)' } }; } option.legend = { bottom: '0', left: 'center' }; return { ...payload, data: option };"
    },
    "height": {{ radar_height | default(400) }},
    {% if radar_clickable | default(true) %}
    "clickAction": {
        "actionType": "dialog",
        "dialog": {
            "title": "${event.seriesName} - 详细分析",
            "size": "lg",
            "actions": [
                {
                    "type": "button",
                    "label": "关闭",
                    "actionType": "close"
                }
            ],
            "body": {
                "type": "service",
                "api": {
                    "method": "get",
                    "url": "{{ radar_detail_api | default('/api/demo/radar-detail') }}",
                    "requestAdaptor": "const seriesName = api.data?.seriesName || ''; return { ...api, url: api.url + '?name=' + encodeURIComponent(seriesName) };"
                },
                "dataMapping": {
                    "seriesName": "${event.seriesName}"
                },
                "body": [
                    {
                        "type": "tpl",
                        "tpl": "<div style='background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 8px; margin-bottom: 20px;'><h3 style='margin: 0 0 10px 0;'>${seriesName}</h3><p style='margin: 0; opacity: 0.9;'>综合评分: ${overall_score} / 100</p></div>"
                    },
                    {
                        "type": "grid",
                        "columns": [
                            {
                                "md": 6,
                                "body": [
                                    {
                                        "type": "property",
                                        "title": "各维度得分",
                                        "column": 1,
                                        "items": [
                                            {
                                                "label": "维度1",
                                                "content": "${dimension1} 分"
                                            },
                                            {
                                                "label": "维度2",
                                                "content": "${dimension2} 分"
                                            },
                                            {
                                                "label": "维度3",
                                                "content": "${dimension3} 分"
                                            },
                                            {
                                                "label": "维度4",
                                                "content": "${dimension4} 分"
                                            },
                                            {
                                                "label": "维度5",
                                                "content": "${dimension5} 分"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "md": 6,
                                "body": [
                                    {
                                        "type": "tpl",
                                        "tpl": "<div style='background: #f7f8fa; padding: 15px; border-radius: 8px;'><h4 style='margin-top: 0; color: #1890ff;'>分析建议</h4><p style='line-height: 1.8; color: #666;'>${analysis_text}</p></div>"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    }
    {% endif %}
}
