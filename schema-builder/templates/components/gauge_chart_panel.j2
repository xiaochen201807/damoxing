{# Gauge Chart Panel Component - KPI Monitoring #}
{
    "type": "chart",
    "api": {
        "url": "{{ gauge_api_url }}",
        "method": "{{ gauge_method | default('get') }}",
        "adaptor": "const option = payload.data || {}; if (option.series && option.series[0]) { option.series[0].type = 'gauge'; option.series[0].radius = '{{ gauge_radius | default('75%') }}'; option.series[0].startAngle = {{ gauge_start_angle | default(220) }}; option.series[0].endAngle = {{ gauge_end_angle | default(-40) }}; option.series[0].min = {{ gauge_min | default(0) }}; option.series[0].max = {{ gauge_max | default(100) }}; option.series[0].splitNumber = {{ gauge_split_number | default(10) }}; option.series[0].progress = { show: true, width: {{ gauge_progress_width | default(18) }} }; option.series[0].axisLine = { lineStyle: { width: {{ gauge_axis_width | default(18) }} } }; option.series[0].axisTick = { distance: -{{ gauge_axis_width | default(18) + 7 }}, splitNumber: 5, lineStyle: { width: 2, color: '#999' } }; option.series[0].splitLine = { distance: -{{ gauge_axis_width | default(18) + 12 }}, length: 14, lineStyle: { width: 3, color: '#999' } }; option.series[0].axisLabel = { distance: -{{ gauge_axis_width | default(18) + 25 }}, color: '#999', fontSize: 12 }; option.series[0].anchor = { show: true, showAbove: true, size: 20, itemStyle: { borderWidth: 8 } }; option.series[0].title = { show: true, offsetCenter: [0, '70%'], fontSize: 14, color: '#999' }; option.series[0].detail = { valueAnimation: true, fontSize: 40, offsetCenter: [0, '0%'], formatter: '{{ gauge_unit_prefix | default('') }}{value}{{ gauge_unit_suffix | default('%') }}', color: 'auto' }; if (!option.series[0].data || option.series[0].data.length === 0) { option.series[0].data = [{ value: 0, name: '加载中...' }]; } } return { ...payload, data: option };"
    },
    "height": {{ gauge_height | default(300) }},
    {% if gauge_clickable | default(false) %}
    "clickAction": {
        "actionType": "dialog",
        "dialog": {
            "title": "指标详情",
            "size": "lg",
            "body": {
                "type": "service",
                "api": "{{ gauge_detail_api | default('/api/demo/gauge-detail') }}",
                "body": [
                    {
                        "type": "tpl",
                        "tpl": "<div style='padding: 20px;'><h3>${indicator_name}</h3><p>当前值: <strong style='font-size: 24px; color: #1890ff;'>${current_value}</strong></p><p>目标值: ${target_value}</p><p>达成率: <span class='label label-${completion_rate >= 100 ? 'success' : completion_rate >= 80 ? 'warning' : 'danger'}'>${completion_rate}%</span></p></div>"
                    }
                ]
            }
        }
    }
    {% endif %}
}
