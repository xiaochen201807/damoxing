{# Page Header Component - Title and Dynamic Subtitle #}
{% import 'base/colors.j2' as theme %}

{# 🔴 修复：改为 container 类型，使其成为可复用组件 #}
{
    "type": "container",
    "className": "page-header-component",
    "style": {
        "backgroundColor": "{{ theme.colors.background }}",
        "padding": "20px 0",
        "marginBottom": "20px"
    },
    
    {# --- 动态/静态副标题逻辑 --- #}
    {% if subtitle_api %}
    "body": [
        {
            "type": "service",
            "api": {
                "method": "{{ subtitle_api_method | default('get') }}",
                "url": "{{ subtitle_api }}"
                {% if subtitle_api_adaptor %},
                "adaptor": "{{ subtitle_api_adaptor }}"
                {% endif %}
            },
            "body": [
                {
                    "type": "container",
                    "className": "text-center",
                    "body": [
                        {
                            "type": "tpl",
                            "tpl": "<h2 style='font-size: {{ title_font_size | default('22px') }}; font-weight: 600; color: {{ theme.colors.title }}; margin: 10px 0 5px 0;'>{{ title }}</h2>"
                        },
                        {
                            "type": "tpl",
                            "tpl": "<div style='color: {{ subtitle_color | default(theme.colors.subtitle) }}; font-size: {{ subtitle_font_size | default('13px') }}; margin-bottom: {{ subtitle_margin_bottom_stats | default('15px') }};'>{{ subtitle_tpl | default('${displayText}') }}</div>"
                        }
                        {% if enable_report_button %},
                        {
                            "type": "button",
                            "label": "{{ report_button_label | default('生成风险分析报告') }}",
                            "level": "danger",
                            "className": "m-t-sm",
                            "actionType": "dialog",
                            "dialog": {
                                "title": "{{ report_button_label | default('生成风险分析报告') }}",
                                "size": "lg",
                                "body": {
                                    "type": "form",
                                    "api": "{{ report_api | default('post:/api/report/generate') }}",
                                    "body": [
                                        {
                                            "type": "select",
                                            "name": "report_type",
                                            "label": "报告类型",
                                            "options": [
                                                { "label": "月度分析报告", "value": "month" },
                                                { "label": "季度分析报告", "value": "quarter" }
                                            ],
                                            "required": true
                                        },
                                        {
                                            "type": "input-date-range",
                                            "name": "date_range",
                                            "label": "时间范围",
                                            "required": true
                                        },
                                        {
                                            "type": "textarea",
                                            "name": "remark",
                                            "label": "备注说明"
                                        }
                                    ]
                                }
                            }
                        }
                        {% endif %}
                    ]
                }
            ]
        }
    ]
    {% else %}
    "body": [
        {
            "type": "container",
            "className": "text-center",
            "body": [
                {
                    "type": "tpl",
                    "tpl": "<h2 style='font-size: {{ title_font_size | default('22px') }}; font-weight: 600; color: {{ theme.colors.title }}; margin: 10px 0 5px 0;'>{{ title }}</h2>"
                },
                {
                    "type": "tpl",
                    "tpl": "<div style='color: {{ subtitle_color | default(theme.colors.subtitle) }}; font-size: {{ subtitle_font_size | default('13px') }}; margin-bottom: {{ subtitle_margin_bottom_stats | default('15px') }};'>{{ subtitle | default('') }}</div>"
                }
                {% if enable_report_button %},
                {
                    "type": "button",
                    "label": "{{ report_button_label | default('生成风险分析报告') }}",
                    "level": "danger",
                    "className": "m-t-sm",
                    "actionType": "dialog",
                    "dialog": {
                        "title": "{{ report_button_label | default('生成风险分析报告') }}",
                        "size": "lg",
                        "body": {
                            "type": "form",
                            "api": "{{ report_api | default('post:/api/report/generate') }}",
                            "body": [
                                {
                                    "type": "select",
                                    "name": "report_type",
                                    "label": "报告类型",
                                    "options": [
                                        { "label": "月度分析报告", "value": "month" },
                                        { "label": "季度分析报告", "value": "quarter" }
                                    ],
                                    "required": true
                                },
                                {
                                    "type": "input-date-range",
                                    "name": "date_range",
                                    "label": "时间范围",
                                    "required": true
                                },
                                {
                                    "type": "textarea",
                                    "name": "remark",
                                    "label": "备注说明"
                                }
                            ]
                        }
                    }
                }
                {% endif %}
            ]
        }
    ]
    {% endif %}
}