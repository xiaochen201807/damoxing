{# Page Header Component - Title and Dynamic Subtitle #}
{% import 'base/colors.j2' as theme %}

{
    "type": "container",
    "className": "page-header-component",
    "style": {
        "backgroundColor": "{{ theme.colors.background }}",
        "padding": "20px 20px", {# 增加左右内边距，防止文字太长贴边 #}
        "marginBottom": "20px",
        "position": "relative"  {# 关键点 1：父容器设置为相对定位，作为锚点 #}
    },
    
    {# --- 定义按钮组件 JSON 片段 (避免重复写两遍) --- #}
    {% set report_button_json %}
    {
        "type": "button",
        "label": "{{ report_button_label | default('生成风险分析报告') }}",
        "level": "danger",
        "style": {
            "position": "absolute",        {# 关键点 2：绝对定位 #}
            "right": "20px",               {# 靠右 20px #}
            "top": "50%",                  {# 垂直居中 #}
            "transform": "translateY(-50%)", {# 修正垂直居中偏移 #}
            "zIndex": "10"
        },
        "actionType": "dialog",
        "dialog": {
            "title": "{{ report_button_label | default('生成风险分析报告') }}",
            "size": "lg",
            "body": {
                "type": "form",
                "api": "{{ report_api | default('post:/api/report/generate') }}",
                "body": [
                    {
                        "type": "select",
                        "name": "report_type",
                        "label": "报告类型",
                        "options": [
                            { "label": "月度分析报告", "value": "month" },
                            { "label": "季度分析报告", "value": "quarter" }
                        ],
                        "required": true
                    },
                    {
                        "type": "input-date-range",
                        "name": "date_range",
                        "label": "时间范围",
                        "required": true
                    },
                    {
                        "type": "textarea",
                        "name": "remark",
                        "label": "备注说明"
                    }
                ]
            }
        }
    }
    {% endset %}

    "body": [
        {# --- 场景 A：动态副标题 (需要 Service) --- #}
        {% if subtitle_api %}
        {
            "type": "service",
            "style": {
                "width": "100%" {# 确保 Service 占满宽度 #}
            },
            "api": {
                "method": "{{ subtitle_api_method | default('get') }}",
                "url": "{{ subtitle_api }}"
                {% if subtitle_api_adaptor %},
                "adaptor": "{{ subtitle_api_adaptor }}"
                {% endif %}
            },
            "body": [
                {
                    "type": "container",
                    "className": "text-center",
                    "style": {
                        "position": "static" {# 防止内部容器干扰定位上下文 #}
                    },
                    "body": [
                        {
                            "type": "tpl",
                            "tpl": "<h2 style='font-size: {{ title_font_size | default('22px') }}; font-weight: 600; color: {{ theme.colors.title }}; margin: 5px 0;'>{{ title }}</h2>"
                        },
                        {
                            "type": "tpl",
                            "tpl": "<div style='color: {{ subtitle_color | default(theme.colors.subtitle) }}; font-size: {{ subtitle_font_size | default('13px') }};'>{{ subtitle_tpl | default('${displayText}') }}</div>"
                        }
                    ]
                }
                {% if enable_report_button %}
                ,{{ report_button_json }}
                {% endif %}
            ]
        }
        
        {# --- 场景 B：静态副标题 (直接渲染) --- #}
        {% else %}
        {
            "type": "container",
            "className": "text-center",
            "style": {
                "width": "100%"
            },
            "body": [
                {
                    "type": "tpl",
                    "tpl": "<h2 style='font-size: {{ title_font_size | default('22px') }}; font-weight: 600; color: {{ theme.colors.title }}; margin: 5px 0;'>{{ title }}</h2>"
                },
                {
                    "type": "tpl",
                    "tpl": "<div style='color: {{ subtitle_color | default(theme.colors.subtitle) }}; font-size: {{ subtitle_font_size | default('13px') }};'>{{ subtitle | default('') }}</div>"
                }
            ]
        }
        {% if enable_report_button %}
        ,{{ report_button_json }}
        {% endif %}
        
        {% endif %}
    ]
}