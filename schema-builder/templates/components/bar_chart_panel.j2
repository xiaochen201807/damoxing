{# Bar Chart Panel Component - Simple 2D Data Chart (Month vs Count) #}
{
    "type": "chart",
    "api": {
        "url": "{{ bar_api_url }}",
        "method": "{{ bar_method | default('get') }}",
        "adaptor": "const option = payload.data || {}; if (option.series && option.series[0]) { option.series[0].type = 'bar'; option.series[0].itemStyle = { borderRadius: [{{ bar_border_radius | default(4) }}, {{ bar_border_radius | default(4) }}, 0, 0], color: '{{ bar_color | default('#5470c6') }}' }; option.series[0].emphasis = { itemStyle: { color: '{{ bar_emphasis_color | default('#3aa1ff') }}' } }; option.series[0].label = { show: {{ bar_show_label | default('false') }}, position: 'top', formatter: '{c}' }; } option.grid = { left: '3%', right: '4%', bottom: '10%', top: '10%', containLabel: true }; option.tooltip = { trigger: 'axis', axisPointer: { type: 'shadow' }, formatter: '{b}: {c}' }; if (option.xAxis) { option.xAxis.axisLabel = { rotate: {{ bar_x_rotate | default(0) }}, interval: 0 }; } if (option.yAxis) { option.yAxis.name = '{{ bar_y_axis_name | default('数量') }}'; option.yAxis.nameTextStyle = { padding: [0, 0, 0, 10] }; } return { ...payload, data: option };"
    },
    "height": {{ bar_height | default(350) }},
    {% if bar_clickable | default(true) %}
    "clickAction": {
        "actionType": "dialog",
        "dialog": {
            "title": "${event.name} - 详细数据 (共${event.value}条)",
            "size": "xl",
            "actions": [
                {
                    "type": "button",
                    "label": "导出数据",
                    "level": "primary",
                    "actionType": "download",
                    "api": {
                        "method": "get",
                        "url": "/api/export/bar-data?category=${event.name}"
                    }
                },
                {
                    "type": "button",
                    "label": "关闭",
                    "actionType": "close"
                }
            ],
            "data": {
                "selectedCategory": "${event.name}",
                "selectedValue": "${event.value}"
            },
            "body": {
                "type": "service",
                "api": {
                    "method": "get",
                    "url": "{{ bar_detail_api | default('/api/demo/bar-detail') }}",
                    "requestAdaptor": "const category = api.data?.selectedCategory || ''; return { ...api, url: api.url + '?category=' + encodeURIComponent(category) };"
                },
                "body": {
                    "type": "crud",
                    "syncLocation": false,
                    "api": "${api}",
                    "columns": [
                        {
                            "name": "id",
                            "label": "ID",
                            "width": 60
                        },
                        {
                            "name": "name",
                            "label": "名称"
                        },
                        {
                            "name": "category",
                            "label": "类别"
                        },
                        {
                            "name": "value",
                            "label": "数值",
                            "type": "number"
                        },
                        {
                            "name": "date",
                            "label": "日期",
                            "type": "date",
                            "format": "YYYY-MM-DD"
                        },
                        {
                            "name": "status",
                            "label": "状态",
                            "type": "mapping",
                            "map": {
                                "active": "<span class='label label-success'>正常</span>",
                                "pending": "<span class='label label-warning'>待处理</span>",
                                "inactive": "<span class='label label-default'>已关闭</span>"
                            }
                        },
                        {
                            "type": "operation",
                            "label": "操作",
                            "width": 120,
                            "buttons": [
                                {
                                    "type": "button",
                                    "label": "详情",
                                    "level": "link",
                                    "icon": "fa fa-eye",
                                    "actionType": "dialog",
                                    "dialog": {
                                        "title": "详细信息 - ${name}",
                                        "size": "lg",
                                        "body": {
                                            "type": "form",
                                            "mode": "horizontal",
                                            "wrapWithPanel": false,
                                            "initApi": {
                                                "method": "get",
                                                "url": "/api/demo/item/${id}"
                                            },
                                            "body": [
                                                {
                                                    "type": "static",
                                                    "name": "id",
                                                    "label": "ID"
                                                },
                                                {
                                                    "type": "static",
                                                    "name": "name",
                                                    "label": "名称"
                                                },
                                                {
                                                    "type": "static",
                                                    "name": "category",
                                                    "label": "类别"
                                                },
                                                {
                                                    "type": "static",
                                                    "name": "value",
                                                    "label": "数值"
                                                },
                                                {
                                                    "type": "static",
                                                    "name": "date",
                                                    "label": "日期"
                                                }
                                            ]
                                        }
                                    }
                                }
                            ]
                        }
                    ],
                    "perPageAvailable": [10, 20, 50],
                    "perPage": 10
                }
            }
        }
    }
    {% endif %}
}
