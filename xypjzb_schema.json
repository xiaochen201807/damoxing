

















{
  "type": "page",
  "title": "信用评价指标",
  "body": [
    {
      "type": "crud",
      "name": "indicatorsCrud",
      "api": {
        "method": "post",
        "url": "/HFB/aiyc/ywcj/xypjzbglcx",
        "data": {
          "jgbh": "1305282025",
          
          "subject": "${subject}",
          "status": "${status}",
          "page": "${page}",
          "perPage": "${perPage}"
        }
      },

      "syncLocation": false,
      "headerToolbar": [
        {
          "type": "button",
          "label": "新增指标",
          "actionType": "dialog",
          "level": "primary",
          "icon": "fa fa-plus",
          "dialog": {
            "title": "新增信用评价指标",
            "size": "md",
            "body": {
              "type": "form",
              "api": {
                "method": "post",
                "url": "/HFB/aiyc/ywcj/xypjzbglupdate",
                "data": {
                  "jgbh": "1305282025",
                  "bm": "0",
                  
                  "&": "$$"
                }
              },
              "body": [
                {
                  "type": "select",
                  "name": "subject",
                  "label": "主体类型",
                  "required": true,
                  "options": [
                    { "label": "缴存单位", "value": "缴存单位" },
                    { "label": "缴存人", "value": "缴存人" },
                    { "label": "开发商", "value": "开发商" }
                  ]
                },
                {
                  "type": "input-text",
                  "name": "name",
                  "label": "监控指标",
                  "required": true,
                  "placeholder": "请输入监控指标名称"
                },
                {
                  "type": "textarea",
                  "name": "description",
                  "label": "指标描述",
                  "placeholder": "请输入指标的详细描述"
                },
                {
                  "type": "input-number",
                  "name": "weight",
                  "label": "权重",
                  "required": true,
                  "min": 1,
                  "max": 100,
                  "suffix": "%",
                  "placeholder": "1-100"
                },
                {
                  "type": "input-text",
                  "name": "elementName",
                  "label": "管理要素名称",
                  "required": true,
                  "placeholder": "例如：欠缴月数、减少比例"
                },
                {
                  "type": "input-text",
                  "name": "elementDesc",
                  "label": "管理要素说明",
                  "required": true,
                  "placeholder": "请输入管理要素的详细说明"
                },
                {
                  "type": "input-number",
                  "name": "elementValue",
                  "label": "管理要素阈值",
                  "required": true,
                  "placeholder": "请输入阈值数字"
                },
                {
                  "type": "switch",
                  "name": "status",
                  "label": "启用状态",
                  "onText": "开启",
                  "offText": "关闭",
                  "trueValue": "开启",
                  "falseValue": "关闭",
                  "value": "开启"
                }
              ]
            }
          }
        },
        "bulkActions"
      ],
      "filter": {
        "title": "指标配置",
        "mode": "inline",
        "body": [
          {
            "type": "select",
            "name": "subject",
            "label": "主体类型",
            "clearable": true,
            "options": [
              { "label": "全部", "value": "" },
              { "label": "缴存单位", "value": "缴存单位" },
              { "label": "缴存人", "value": "缴存人" },
              { "label": "开发商", "value": "开发商" }
            ]
          },
          {
            "type": "select",
            "name": "status",
            "label": "启用状态",
            "clearable": true,
            "options": [
              { "label": "全部", "value": "" },
              { "label": "开启", "value": "开启" },
              { "label": "关闭", "value": "关闭" }
            ]
          }
        ],
        "actions": [
          { "type": "submit", "label": "查询", "level": "primary" },
          { "type": "reset", "label": "重置" }
        ]
      },
      "columns": [
        { "name": "subject", "label": "主体类型", "width": 100 },
        { "name": "name", "label": "监控指标", "width": 300 },
        { "name": "weight", "label": "权重", "width": 80, "tpl": "${weight}%" },
        { "name": "elementName", "label": "管理要素", "width": 200, "tpl": "${elementName}: ≥${elementValue}" },
        { "name": "elementDesc", "label": "要素说明", "width": 200 },
        {
          "name": "status",
          "label": "启用状态",
          "width": 100,
          "type": "mapping",
          "map": {
            "开启": "<span class='label label-success'>开启</span>",
            "关闭": "<span class='label label-danger'>关闭</span>"
          }
        },
        {
          "type": "operation",
          "label": "操作",
          "width": 150,
          "buttons": [
            {
              "type": "button",
              "label": "编辑",
              "actionType": "dialog",
              "level": "link",
              "icon": "fa fa-edit",
              "dialog": {
                "title": "编辑信用评价指标",
                "size": "md",
                "body": {
                  "type": "form",
                  "api": {
                    "method": "post",
                    "url": "/HFB/aiyc/ywcj/xypjzbglupdate",
                    "data": {
                      "jgbh": "1305282025",
                      "bm": "1",
                      
                      "&": "$$"
                    }
                  },
                  "body": [
                    { "type": "hidden", "name": "id" },
                    {
                      "type": "select",
                      "name": "subject",
                      "label": "主体类型",
                      "required": true,
                      "options": [
                        { "label": "缴存单位", "value": "缴存单位" },
                        { "label": "缴存人", "value": "缴存人" },
                        { "label": "开发商", "value": "开发商" }
                      ]
                    },
                    { "type": "input-text", "name": "name", "label": "监控指标", "required": true },
                    { "type": "textarea", "name": "description", "label": "指标描述" },
                    { "type": "input-number", "name": "weight", "label": "权重", "required": true, "min": 1, "max": 100, "suffix": "%" },
                    { "type": "input-text", "name": "elementName", "label": "管理要素名称", "required": true },
                    { "type": "input-text", "name": "elementDesc", "label": "管理要素说明", "required": true },
                    { "type": "input-number", "name": "elementValue", "label": "管理要素阈值", "required": true },
                    {
                      "type": "switch",
                      "name": "status",
                      "label": "启用状态",
                      "onText": "开启",
                      "offText": "关闭",
                      "trueValue": "开启",
                      "falseValue": "关闭"
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "删除",
              "actionType": "ajax",
              "level": "link",
              "icon": "fa fa-trash",
              "className": "text-danger",
              "confirmText": "确定要删除该指标吗？",
              "api": {
                "method": "post",
                "url": "/HFB/aiyc/ywcj/xypjzbglupdate",
                "data": {
                  "jgbh": "1305282025",
                  "bm": "2",
                  
                  "id": "${id}"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}

